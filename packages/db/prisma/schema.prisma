model HrChatHistory {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  counterpartyId String   @map("counterparty_id") @db.Uuid
  messages       Json     @default("[]")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation("HrChatHistoryCp", fields: [counterpartyId], references: [id])

  @@unique([accountId, counterpartyId])
  @@map("hr_chat_history")
}

model HrTelegramOutbox {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  counterpartyId    String?   @map("counterparty_id") @db.Uuid
  employeeId        String?   @map("employee_id") @db.Uuid
  // toPhone is nullable: a self-send (toSelf=true → 'me'/Saqlangan xabarlar)
  // has no recipient phone; the mtproto adapter uses viaSlot instead.
  toPhone           String?   @map("to_phone") @db.VarChar(20)
  toSelf            Boolean   @default(false) @map("to_self")
  viaSlot           Int?      @map("via_slot")
  messageText       String    @map("message_text")
  // Optional file to send as a Telegram document (акт-сверка .xlsx). When set,
  // the mtproto worker uses sendFile(caption=messageText) instead of a text send.
  attachmentPath    String?   @map("attachment_path")
  /// 'pending' | 'sending' | 'retry' | 'sent' | 'failed'.
  /// 'sending' = exclusive worker claim, MTProto send in flight; `next_retry_at`
  /// is the claim lease (Faza 28, api `shared/outbox-claim.ts`). Before that
  /// fix the "atomic guard" wrote pending→pending and locked nothing (HR-4).
  status            String    @default("pending") @db.VarChar(20)
  retryCount        Int       @default(0) @map("retry_count")
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz()
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  failReason        String?   @map("fail_reason")
  sourceEventType   String?   @map("source_event_type") @db.VarChar(50)
  sourceDocId       String?   @map("source_doc_id") @db.Uuid
  telegramMessageId String?   @map("telegram_message_id") @db.VarChar(50)
  sentBySlot        Int?      @map("sent_by_slot")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation("HrOutboxCp", fields: [counterpartyId], references: [id])
  employee     Employee?     @relation("HrOutboxEmployee", fields: [employeeId], references: [id])

  @@index([accountId, status, nextRetryAt])
  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("hr_telegram_outbox")
}

/// Kontragent akt-sverka (reconciliation statement) — a generated .xlsx snapshot
/// of a counterparty's full transaction history + final balance. Stored on disk
/// (filePath) and served via an unguessable capability token (fileToken). Scalar
/// FKs only (no relation navigation) to keep the Counterparty/Account models untouched.
model CounterpartyStatement {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  // Nullable: a product-scoped report (buyum→kontragentlar) has no single agent.
  counterpartyId    String?   @map("counterparty_id") @db.Uuid
  // Set for product reports (Report B) and product-filtered agent akts (Report A).
  productId         String?   @map("product_id") @db.Uuid
  periodFrom        DateTime? @map("period_from") @db.Timestamptz()
  periodTo          DateTime? @map("period_to") @db.Timestamptz()
  fileToken         String    @unique @map("file_token") @db.VarChar(64)
  filePath          String    @map("file_path")
  fileName          String    @map("file_name") @db.VarChar(255)
  finalBalanceMinor BigInt    @default(0) @map("final_balance_minor")
  currency          String    @default("UZS") @db.VarChar(3)
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("counterparty_statement")
}

model HrBonusFineLog {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  kind         String   @db.VarChar(10)
  source       String   @db.VarChar(30)
  amountMinor  BigInt   @map("amount_minor")
  reason       String?
  /// Employee name snapshotted at creation (spec §13.17) — survives renames.
  employeeName String?  @map("employee_name") @db.VarChar(255)
  taskLogId    String?  @map("task_log_id") @db.Uuid
  /// Davomat qatoriga bog'lash (auto_late jarima) — bitta check-in'ga ko'pi
  /// bilan bitta avto-jarima (idempotent, `@@unique([attendanceId, source])`).
  attendanceId String?  @map("attendance_id") @db.Uuid
  ruleId       String?  @map("rule_id") @db.Uuid
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Kunlik KPI qabulidan chiqqan yozuv qaysi KUNGA tegishli (MK01, QAROR-B1).
  ///
  /// Bekor qilishda ZERO-SUM qatori shu ustun bo'yicha topiladi: kunning sof
  /// qoldig'i olinadi va nolga keltiriladi. `attendanceId` bu ish uchun
  /// yaramaydi — u davomat qatoriga bog'langan avto-jarima kanali.
  /// `SetNull`: kun qatori o'chsa ham PUL YOZUVI qoladi (audit izi), aks holda
  /// to'langan bonus jimgina yo'qolardi.
  dailyKpiId String? @map("daily_kpi_id") @db.Uuid

  /// Yozuvni keltirib chiqargan FSM hodisasi (`EmployeeDailyKpiEvent`).
  ///
  /// TABIIY KALIT: bir o'tish = ko'pi bilan bitta yozuv (har `kind` uchun).
  /// Qabul → bekor → qayta qabul siklида har o'tish O'Z hodisasiga ega,
  /// shuning uchun kalit sikllarni bloklamaydi, lekin bitta o'tishning
  /// takror yozuvini DB darajasida imkonsiz qiladi.
  kpiEventId String? @map("kpi_event_id") @db.Uuid

  account   Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee  Employee               @relation("HrBonusEmployee", fields: [employeeId], references: [id])
  taskLog   HrTaskLog?             @relation(fields: [taskLogId], references: [id])
  rule      HrBonusFineRule?       @relation(fields: [ruleId], references: [id])
  createdBy Employee?              @relation("HrBonusCreator", fields: [createdById], references: [id])
  dailyKpi  EmployeeDailyKpi?      @relation(fields: [dailyKpiId], references: [id], onDelete: SetNull)
  kpiEvent  EmployeeDailyKpiEvent? @relation(fields: [kpiEventId], references: [id], onDelete: SetNull)

  @@unique([attendanceId, source], name: "uq_bonusfine_attendance_source")
  /// Bir FSM o'tishi → har turdan ko'pi bilan bitta yozuv (idempotentlik).
  /// `kind` kalitda: bekor qilish bitta o'tishda ham bonusni, ham jarimani
  /// nolga keltirishi mumkin (ikki qator, bitta hodisa).
  @@unique([kpiEventId, kind], name: "uq_bonusfine_kpi_event_kind")
  @@index([accountId, employeeId, createdAt(sort: Desc)])
  @@index([accountId, source, createdAt(sort: Desc)])
  /// Kunning sof qoldig'i (zero-sum bekor qilish) shu indeksdan o'qiladi.
  @@index([accountId, dailyKpiId])
  @@map("hr_bonus_fine_log")
}

model HrBonusFineRule {
