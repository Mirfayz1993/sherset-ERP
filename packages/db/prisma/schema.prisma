  organization        Organization         @relation("PrepayReturnOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("PrepayReturnOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  prepayment          Prepayment           @relation("PrepaymentReturnSource", fields: [prepaymentId], references: [id], onDelete: Restrict)
  contract            Contract?            @relation("PrepaymentReturnContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?             @relation("PrepaymentReturnProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@index([accountId, prepaymentId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("prepayment_returns")
}

/// Internal order (Внутренний заказ) — request from one warehouse/dept to
/// another for stock to be delivered. Becomes a Move when fulfilled.
model InternalOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  // moysklad parity — Проект (internal stock doc: no counterparty → no Договор).
  projectId      String? @map("project_id") @db.Uuid

  moment                DateTime  @default(now()) @db.Timestamptz()
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()
  applicable            Boolean   @default(false)
  state                 String    @default("draft") @db.VarChar(30)
  postedAt              DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor      BigInt @default(0) @map("sum_minor")
  vatSumMinor   BigInt @default(0) @map("vat_sum_minor")
  movedSumMinor BigInt @default(0) @map("moved_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?               @relation("InternalOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?                  @relation("InternalOrderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization Organization            @relation("InternalOrderOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store                   @relation("InternalOrderStore", fields: [storeId], references: [id], onDelete: Restrict)
  project      Project?                @relation("InternalOrderProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions    InternalOrderPosition[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, projectId])
  @@map("internal_orders")
}

/// Line item for InternalOrder — what stock is being requested and how
/// much. No price: internal transfers move at cost basis preserved by the
/// downstream Move document, not at a quoted price.
model InternalOrderPosition {
  id              String @id @default(uuid()) @db.Uuid
  internalOrderId String @map("internal_order_id") @db.Uuid
  accountId       String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  quantity      Decimal @db.Decimal(20, 6)
  /// Amount already moved into the destination store via Move docs.
  movedQuantity Decimal @default(0) @map("moved_quantity") @db.Decimal(20, 6)

  /// Indicative price for reporting / planning — not used in money
  /// posting (Move uses the cost basis at transfer time instead).
  priceMinor BigInt? @map("price_minor")
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  internalOrder InternalOrder @relation(fields: [internalOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation("ProductInternalOrderPositions", fields: [productId], references: [id], onDelete: Restrict)

  @@index([internalOrderId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@map("internal_order_positions")
}

/// Counterparty adjustment — manual debt correction (e.g. write-off of
/// uncollectable debt). Increases or decreases what the counterparty owes
/// without an underlying invoice/payment.
model CounterpartyAdjustment {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId        String  @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  // moysklad parity — Договор / Проект (settlement adjustment has counterparty).
  contractId     String? @map("contract_id") @db.Uuid
  projectId      String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  /// Direction: 'INCREASE' = counterparty owes us more (we billed extra),
  ///            'DECREASE' = we owe them more / write off.
  direction String @default("INCREASE") @db.VarChar(10)
  sumMinor  BigInt @default(0) @map("sum_minor")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?    @relation("CpAdjustmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?       @relation("CpAdjustmentGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty @relation("CpAdjustmentAgent", fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization @relation("CpAdjustmentOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  contract     Contract?    @relation("CpAdjustmentContract", fields: [contractId], references: [id], onDelete: SetNull)
  project      Project?     @relation("CpAdjustmentProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@index([accountId, agentId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("counterparty_adjustments")
}

/// Price list document — captures a snapshot of prices per product for
