// Moysklad Clone — Prisma schema
//
// Design: multi-tenant via Bridge model (ADR-0003).
//   - Every tenant-scoped table has `account_id` (uuid) + RLS policies.
//   - Money fields stored as BigInt (minor units, tiyin) — ADR-0004.
//   - Hybrid audit: reference data uses audit_log; stock/money use
//     append-only ledger — ADR-0005.
//
// Sprint 1 scope: Account, Employee, Organization, Store, ProductFolder,
//   Product, Counterparty, AuditLog. Just enough to ship the Product
//   vertical slice with permissions + audit + money.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

