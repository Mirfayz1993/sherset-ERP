/// Retail point-of-sale terminal configuration. Distinct from CashDesk
/// (cash register hardware) and Store (warehouse) — RetailStore is the
/// POS install at a physical location with its bank acquiring contract,
/// fiscal printer mapping, and customer-input requirements.
///
/// moysklad's RetailStore has ~70 fields driving every aspect of the
/// cashier UX. We model the full set so trial-account configuration
/// imports round-trip without lossy mapping.
model RetailStore {
  id             String  @id @default(uuid()) @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  ownerId        String? @map("owner_id") @db.Uuid
  groupId        String? @map("group_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid

  name         String  @db.VarChar(255)
  description  String?
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // Address
  address     String?
  addressFull Json?   @map("address_full")

  // Lifecycle
  active            Boolean @default(true)
  archived          Boolean @default(false)
  authTokenAttached Boolean @default(false) @map("auth_token_attached")

  // Cashier configuration
  controlCashierChoice        Boolean @default(false) @map("control_cashier_choice")
  controlShippingStock        Boolean @default(true) @map("control_shipping_stock")
  allowCreateProducts         Boolean @default(false) @map("allow_create_products")
  allowCustomPrice            Boolean @default(false) @map("allow_custom_price")
  allowDeleteReceiptPositions Boolean @default(true) @map("allow_delete_receipt_positions")
  allowSellTobaccoWithoutMRC  Boolean @default(false) @map("allow_sell_tobacco_without_mrc")

  // Discount + retail policy
  discountEnable                      Boolean @default(true) @map("discount_enable")
  discountMaxPercent                  Int?    @map("discount_max_percent")
  enableReturnsWithNoReason           Boolean @default(true) @map("enable_returns_with_no_reason")
  returnFromClosedShiftEnabled        Boolean @default(false) @map("return_from_closed_shift_enabled")
  sellReserves                        Boolean @default(false) @map("sell_reserves")
  reservePrepaidGoods                 Boolean @default(true) @map("reserve_prepaid_goods")
  onlyInStock                         Boolean @default(false) @map("only_in_stock")
  printAlways                         Boolean @default(true) @map("print_always")
  showBeerOnTap                       Boolean @default(false) @map("show_beer_on_tap")
  /// At shift close, automatically generate a CashIn covering the
  /// shift's cash proceeds (deposit-to-bank workflow).
  createCashInOnRetailShiftClosing    Boolean @default(true) @map("create_cash_in_on_retail_shift_closing")
  /// Same idea for non-cash settlement → PaymentIn document.
  createPaymentInOnRetailShiftClosing Boolean @default(true) @map("create_payment_in_on_retail_shift_closing")
  syncAgents                          Boolean @default(true) @map("sync_agents")
  issueOrders                         Boolean @default(true) @map("issue_orders")

  // Document numbering
  demandPrefix String? @map("demand_prefix") @db.VarChar(20)

  // Required customer fields at checkout
  requiredFio                Boolean @default(false) @map("required_fio")
  requiredPhone              Boolean @default(false) @map("required_phone")
  requiredEmail              Boolean @default(false) @map("required_email")
  requiredBirthdate          Boolean @default(false) @map("required_birthdate")
  requiredSex                Boolean @default(false) @map("required_sex")
  requiredDiscountCardNumber Boolean @default(false) @map("required_discount_card_number")

  // Tax + fiscal
  defaultTaxSystem              String? @map("default_tax_system") @db.VarChar(30)
  orderTaxSystem                String? @map("order_tax_system") @db.VarChar(30)
  fiscalType                    String? @map("fiscal_type") @db.VarChar(30)
  ofdEnabled                    Boolean @default(false) @map("ofd_enabled")
  /// Send / pre-send / fallback strategy for OFD messages.
  priorityOfdSend               String? @map("priority_ofd_send") @db.VarChar(30)
  /// CHESTNY_ZNAK_ON_CLOUD | OPERATOR
  sendMarksForCheck             Boolean @default(false) @map("send_marks_for_check")
  sendMarksToChestnyZnakOnCloud Boolean @default(false) @map("send_marks_to_chestny_znak_on_cloud")
  markingSellingMode            String? @map("marking_selling_mode") @db.VarChar(30)
  marksCheckMode                String? @map("marks_check_mode") @db.VarChar(30)
  tobaccoMrcControlType         String? @map("tobacco_mrc_control_type") @db.VarChar(30)

  // Card / QR acquiring
  bankPercent   Decimal? @map("bank_percent") @db.Decimal(5, 2)
  qrPayEnabled  Boolean  @default(false) @map("qr_pay_enabled")
  qrBankPercent Decimal? @map("qr_bank_percent") @db.Decimal(5, 2)
  qrTerminalId  String?  @map("qr_terminal_id") @db.VarChar(50)
  idQR          String?  @map("id_qr") @db.VarChar(255)

  // Master/minion fiscalization (cloud receipts via central terminal)
  /// 'NONE' | 'CHOSEN' | 'ANY'
  minionToMasterType String? @map("minion_to_master_type") @db.VarChar(20)
  /// Array of master RetailStore IDs (when minionToMasterType=CHOSEN).
  masterRetailStores Json?   @map("master_retail_stores")

  // Cashier UX details (denormalised JSON to match moysklad's wire shape)
  /// Default product folder set the cashier sees first.
  productFolders          Json?   @map("product_folders")
  createAgentsTags        Json?   @map("create_agents_tags")
  filterAgentsTags        Json?   @map("filter_agents_tags")
  /// Default state the cashier-created sale starts in.
  createOrderWithStateId  String? @map("create_order_with_state_id") @db.Uuid
  /// State that fulfilment moves the order to once shipped.
  orderToStateId          String? @map("order_to_state_id") @db.Uuid
  /// Customer-order states displayed in the cashier order picker.
  customerOrderStatesJson Json?   @map("customer_order_states_json")

  // Linked entities — cashiers, receipt template, environment, etc.
  /// JSON arrays of FKs (cashiers / receipt template / acquire / etc.)
  /// Stored as JSON because moysklad accepts MetaArray and we'd need
  /// many junction tables to keep it relational. Service code resolves
  /// the IDs to live entities at request time.
  cashiersJson      Json?   @map("cashiers_json")
  acquireId         String? @map("acquire_id") @db.Uuid
  qrAcquireId       String? @map("qr_acquire_id") @db.Uuid
  receiptTemplateId String? @map("receipt_template_id") @db.Uuid
  priceTypeId       String? @map("price_type_id") @db.Uuid

  /// Closing/stats roll-up. Moysklad surfaces this as nested objects;
  /// we store a single JSON for round-trip parity.
  environmentJson        Json?   @map("environment_json")
  lastOperationNamesJson Json?   @map("last_operation_names_json")
  /// Working state of the till: OPEN_SHIFT / IDLE / IN_TRANSACTION / ...
  state                  String? @db.VarChar(30)

  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organizationAccountId String? @map("organization_account_id") @db.Uuid

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("RetailStoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group               Group?               @relation("RetailStoreGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization        Organization         @relation("RetailStoreOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("RetailStoreOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store                @relation("RetailStoreStore", fields: [storeId], references: [id], onDelete: Restrict)
  priceType           PriceType?           @relation("RetailStorePriceType", fields: [priceTypeId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@index([accountId, archived])
  @@map("retail_stores")
}

/// Tech-process (Техпроцесс) — multi-stage routing definition. Differs
/// from BillOfMaterials (which is the recipe) — Process defines the
/// SEQUENCE of operations. A finished good takes its BOM through a
/// Process to define how stages cascade.
model ProcessingProcess {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  groupId      String?  @map("group_id") @db.Uuid
  name         String   @db.VarChar(255)
  code         String?  @db.VarChar(50)
  externalCode String?  @map("external_code") @db.VarChar(50)
  description  String?
  shared       Boolean  @default(false)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int      @default(1)

  account   Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner     Employee?                   @relation("ProcessingProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group     Group?                      @relation("ProcessingProcessGroup", fields: [groupId], references: [id], onDelete: SetNull)
  positions ProcessingProcessPosition[]

  @@unique([accountId, name])
  @@map("processing_processes")
}

/// §126 — moysklad `processingstage` (Этап производства): a STANDALONE,
/// reusable catalog entity (NOT a per-process child). A Техпроцесс
/// references stages through its positions; the same stage can appear
/// in many processes. The project's `laborCostMinor`/`materialMarkup`
/// are kept (the project cost model the §117 money-engine cascade
/// reads — Processing.processingStageId still points here, unchanged).
model ProcessingStage {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  ownerId               String?  @map("owner_id") @db.Uuid
  groupId               String?  @map("group_id") @db.Uuid
  name                  String   @db.VarChar(255)
  code                  String?  @db.VarChar(50)
  externalCode          String?  @map("external_code") @db.VarChar(50)
  description           String?
  /// Per-stage labour cost (project cost model — read by the §117
  /// productionStageCompletion cost cascade; unchanged).
  laborCostMinor        BigInt   @default(0) @map("labor_cost_minor")
  /// Material cost markup (percent) applied at this stage (§117).
  materialMarkup        Int      @default(0) @map("material_markup")
  /// moysklad `allPerformers` — any active employee assignable.
  allPerformers         Boolean  @default(true) @map("all_performers")
  /// §126 — moysklad `distributionRequired` (показывать исполнителю
  /// только назначенные задания).
  distributionRequired  Boolean  @default(false) @map("distribution_required")
  /// §126 — moysklad `standardHourCost` (Стоимость нормо-часа), tiyin.
  standardHourCostMinor BigInt   @default(0) @map("standard_hour_cost_minor")
  /// §126 — moysklad `materialStore` (склад материалов этапа).
  materialStoreId       String?  @map("material_store_id") @db.Uuid
  shared                Boolean  @default(false)
  archived              Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version               Int      @default(1)

  account       Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner         Employee?                   @relation("ProcessingStageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group         Group?                      @relation("ProcessingStageGroup", fields: [groupId], references: [id], onDelete: SetNull)
  materialStore Store?                      @relation("ProcessingStageMaterialStore", fields: [materialStoreId], references: [id], onDelete: SetNull)
  completions   Processing[]                @relation("ProcessingStageCompletion")
  positions     ProcessingProcessPosition[]
  performers    ProcessingStagePerformer[]

  @@index([accountId, archived])
  @@map("processing_stages")
}

/// §126 — moysklad `processingstage.performers` MetaArray: the set of
/// employees who MAY be assigned to a stage (when allPerformers=false
/// the assignable set is exactly these).
model ProcessingStagePerformer {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  stageId    String @map("stage_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  account  Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stage    ProcessingStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  employee Employee        @relation("ProcessingStagePerformerEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([stageId, employeeId])
  @@index([accountId, stageId])
  @@map("processing_stage_performers")
}

/// §126 — moysklad Техпроцесс POSITION: a stage's placement within a
/// process (1–100 per process). `nextPositions` (a self M:N via
/// ProcessingProcessPositionEdge) is the moysklad successor DAG —
/// full multi-successor branching, no V1 single-successor limit.
model ProcessingProcessPosition {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  processId         String   @map("process_id") @db.Uuid
  processingStageId String   @map("processing_stage_id") @db.Uuid
  /// Default display/iteration order (ASC). Branching is expressed by
  /// `nextPositions`; `position` remains the linear fallback order.
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account                         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  process         ProcessingProcess               @relation(fields: [processId], references: [id], onDelete: Cascade)
  processingStage ProcessingStage                 @relation(fields: [processingStageId], references: [id], onDelete: Restrict)
  /// DAG edges: this position → its next positions, and reverse.
  nextEdges       ProcessingProcessPositionEdge[] @relation("PositionFrom")
  prevEdges       ProcessingProcessPositionEdge[] @relation("PositionTo")

  @@index([accountId, processId, position])
  @@map("processing_process_positions")
}

/// §126 — a single edge of the moysklad `nextPositions` DAG
/// (from-position → to-position). Multi-successor branching.
model ProcessingProcessPositionEdge {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  fromPositionId String @map("from_position_id") @db.Uuid
  toPositionId   String @map("to_position_id") @db.Uuid

  account      Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fromPosition ProcessingProcessPosition @relation("PositionFrom", fields: [fromPositionId], references: [id], onDelete: Cascade)
  toPosition   ProcessingProcessPosition @relation("PositionTo", fields: [toPositionId], references: [id], onDelete: Cascade)

  @@unique([fromPositionId, toPositionId])
  @@index([accountId, fromPositionId])
  @@map("processing_process_position_edges")
}

/// BOM folder (Папка техкарт) — hierarchical organisation of BOMs.
/// moysklad lets you nest BOMs under categories ("Готовые блюда" →
/// "Супы" → ...).
model ProcessingPlanFolder {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  groupId      String?  @map("group_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  name         String   @db.VarChar(255)
  code         String?  @db.VarChar(50)
  externalCode String?  @map("external_code") @db.VarChar(50)
  pathName     String?  @map("path_name") @db.VarChar(500)
  description  String?
  shared       Boolean  @default(false)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account  Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner    Employee?              @relation("ProcessingPlanFolderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group    Group?                 @relation("ProcessingPlanFolderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  parent   ProcessingPlanFolder?  @relation("ProcessingPlanFolderSelf", fields: [parentId], references: [id], onDelete: SetNull)
  children ProcessingPlanFolder[] @relation("ProcessingPlanFolderSelf")

  @@unique([accountId, code])
  @@index([accountId, parentId])
  @@map("processing_plan_folders")
}

/// Production order document (Заказ на производство). High-level demand
/// pull: customer needs N of finished good X by date. Materialises into
/// one or more ProcessingOrders + Processing operations.
model Production {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId   String  @map("organization_id") @db.Uuid
  /// Output store (finished goods land here).
  storeId          String  @map("store_id") @db.Uuid
  /// moysklad «Склад материалов» — where materials are consumed FROM
  /// (§85, production.json; was missing — only output `storeId` existed).
  materialsStoreId String? @map("materials_store_id") @db.Uuid
  /// Optional CustomerOrder driving the production (make-to-order).
  customerOrderId  String? @map("customer_order_id") @db.Uuid
  /// moysklad parity — Проект (production doc: no counterparty → no
  /// Договор). Sibling docs (ProcessingOrder/Processing) had it; the
  /// Production header was the §-class consistency gap (§85).
  projectId        String? @map("project_id") @db.Uuid

  moment                DateTime  @default(now()) @db.Timestamptz()
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()
  /// moysklad «Дата начала / окончания производства» (§85).
  productionStart       DateTime? @map("production_start") @db.Timestamptz()
  productionEnd         DateTime? @map("production_end") @db.Timestamptz()
  /// moysklad «Резервировать материалы» (§85).
  reserve               Boolean   @default(false)
  /// §121 / round-5 — moysklad productiontask `awaiting` (Флаг
  /// ожидания продукта). The only genuine productiontask field the
  /// Production+ProcessingOrder+Processing decomposition lacked
  /// (measure-first §121). Additive, defaulted ⇒ existing rows
  /// byte-identical.
  awaiting              Boolean   @default(false)
  applicable            Boolean   @default(false)
  state                 String    @default("draft") @db.VarChar(30)
  postedAt              DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor    BigInt @default(0) @map("sum_minor")
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner            Employee?         @relation("ProductionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group            Group?            @relation("ProductionGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization     Organization      @relation("ProductionOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  store            Store             @relation("ProductionStore", fields: [storeId], references: [id], onDelete: Restrict)
  materialsStore   Store?            @relation("ProductionMaterialsStore", fields: [materialsStoreId], references: [id], onDelete: SetNull)
  customerOrder    CustomerOrder?    @relation("ProductionCustomerOrder", fields: [customerOrderId], references: [id], onDelete: SetNull)
  project          Project?          @relation("ProductionProject", fields: [projectId], references: [id], onDelete: SetNull)
  processingOrders ProcessingOrder[] @relation("ProcessingOrderProduction")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, projectId])
  @@map("productions")
}

/// Production order (Производственное задание) — actionable shop-floor
/// task derived from a Production document. Ties to a specific BOM and
/// quantity; tracks which Processing ops have been completed.
model ProcessingOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId   String  @map("organization_id") @db.Uuid
  storeId          String  @map("store_id") @db.Uuid
  productionId     String? @map("production_id") @db.Uuid
  processingPlanId String? @map("processing_plan_id") @db.Uuid
  // moysklad parity — Проект (production doc: no counterparty → no Договор).
  projectId        String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  /// Quantity of the finished good ordered. Stored ×1000 (matches
  /// Position.quantity convention).
  quantity              BigInt    @default(0)
  /// Planned delivery date for the produced output.
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()

  sumMinor      BigInt  @default(0) @map("sum_minor")
  /// Total cost of Processing ops linked to this order (incremented on
  /// Processing.post by the output cost; decremented on unpost/cancel).
  /// Read directly for fulfilment progress without aggregation.
  movedSumMinor BigInt  @default(0) @map("moved_sum_minor")
  description   String?
  shared        Boolean @default(false)
  printed       Boolean @default(false)
  published     Boolean @default(false)
  attributes    Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner          Employee?        @relation("ProcessingOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group          Group?           @relation("ProcessingOrderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization   Organization     @relation("ProcessingOrderOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  store          Store            @relation("ProcessingOrderStore", fields: [storeId], references: [id], onDelete: Restrict)
  production     Production?      @relation("ProcessingOrderProduction", fields: [productionId], references: [id], onDelete: SetNull)
  processingPlan BillOfMaterials? @relation("ProcessingOrderPlan", fields: [processingPlanId], references: [id], onDelete: SetNull)
  project        Project?         @relation("ProcessingOrderProject", fields: [projectId], references: [id], onDelete: SetNull)
  ops            Processing[]     @relation("ProcessingProcessingOrder")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, projectId])
  @@map("processing_orders")
}

/// Processing operation (Техоперация) — single shop-floor execution
/// record. Consumes input materials from a store, produces output
/// (intermediate or finished). Used in BOMs that have ProcessingProcess
/// stages — each ProcessingStage cascade emits a Processing record.
model Processing {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId        String  @map("organization_id") @db.Uuid
  /// moysklad «Счёт организации» — organizationAccount on the Техоперация
  /// (§85, processing.json; was missing).
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  /// Where materials are consumed FROM.
  materialsStoreId      String  @map("materials_store_id") @db.Uuid
  /// Where output product lands.
  productsStoreId       String  @map("products_store_id") @db.Uuid
  processingOrderId     String? @map("processing_order_id") @db.Uuid
  processingPlanId      String? @map("processing_plan_id") @db.Uuid
  // moysklad parity — Проект (production doc: no counterparty → no Договор).
  projectId             String? @map("project_id") @db.Uuid

  // §117 / round-4 unit 3 — moysklad «Выполнение этапа производства»
  // (productionstagecompletion) extensions. Processing IS the project's
  // stage-completion document (schema comment above + §116 audit); it
  // only lacked the stage link + labour-accounting fields. All
  // additive + defaulted ⇒ existing Processings are byte-identical
  // (no stage ⇒ no labour/markup ⇒ effectiveCost === material cost).
  /// Which ProcessingStage (Этап, §112) this op completes. Null ⇒
  /// legacy BOM-only Техоперация (no stage labour/markup applied).
  processingStageId     String? @map("processing_stage_id") @db.Uuid
  /// moysklad `performer` — Исполнитель (employee who executed it).
  performerId           String? @map("performer_id") @db.Uuid
  /// moysklad `defect` — Признак брака. Recorded; immutable after
  /// create (enforced in the service). V1: flag only, no defect-cost
  /// branch (documented honest scope).
  defect                Boolean @default(false)
  /// moysklad `enableHourAccounting` — нормо-час hisob rejimi.
  enableHourAccounting  Boolean @default(false) @map("enable_hour_accounting")
  /// moysklad `labourUnitCost` — оплата труда за единицу объёма
  /// производства, in tiyin. When enableHourAccounting it is derived
  /// (standardHourCost × standardHourUnit); else a fixed value.
  labourUnitCostMinor   BigInt  @default(0) @map("labour_unit_cost_minor")
  /// moysklad `standardHourUnit` — нормо-часы единицы объёма.
  standardHourUnit      Decimal @default(0) @map("standard_hour_unit") @db.Decimal(20, 6)
  /// moysklad `standardHourCost` — стоимость нормо-часа, in tiyin.
  standardHourCostMinor BigInt  @default(0) @map("standard_hour_cost_minor")

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  /// Quantity produced this operation (×1000).
  quantity BigInt @default(0)

  /// Aggregated cost basis of the consumed materials + labour for this op.
  /// Becomes the FIFO cost of the produced output product.
  costSumMinor BigInt @default(0) @map("cost_sum_minor")

  /// Snapshot of materials consumed at post time. Used for exact reversal
  /// on unpost/cancel even when the source BOM is edited mid-flight.
  /// Shape: { items: [{ productId, qty, costMinor }] }
  materialsSnapshot Json? @map("materials_snapshot")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("ProcessingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group               Group?               @relation("ProcessingGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization        Organization         @relation("ProcessingOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("ProcessingOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  materialsStore      Store                @relation("ProcessingMaterialsStore", fields: [materialsStoreId], references: [id], onDelete: Restrict)
  productsStore       Store                @relation("ProcessingProductsStore", fields: [productsStoreId], references: [id], onDelete: Restrict)
  processingOrder     ProcessingOrder?     @relation("ProcessingProcessingOrder", fields: [processingOrderId], references: [id], onDelete: SetNull)
  processingPlan      BillOfMaterials?     @relation("ProcessingPlan", fields: [processingPlanId], references: [id], onDelete: SetNull)
  project             Project?             @relation("ProcessingProject", fields: [projectId], references: [id], onDelete: SetNull)
  processingStage     ProcessingStage?     @relation("ProcessingStageCompletion", fields: [processingStageId], references: [id], onDelete: SetNull)
  performer           Employee?            @relation("ProcessingPerformer", fields: [performerId], references: [id], onDelete: SetNull)
  materials           ProcessingMaterial[]
  products            ProcessingProduct[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, projectId])
  @@index([accountId, processingStageId])
  @@map("processings")
}

/// Explicit per-operation material line (moysklad Техоперация `materials`
/// array, §88). When ≥1 ProcessingMaterial row exists the post() cascade
/// consumes THESE (actual consumption — substitutions, wastage, qty ≠
/// BOM standard) instead of exploding the BOM. Absent ⇒ BOM-explode
/// (unchanged v1 path). The output product still comes from the BOM
/// (processingPlanId); explicit `products`/multi-output is §89.
/// Cost/snapshot/exact-reversal engine is unchanged — it consumes
/// whatever (productId, qty) list it is handed.
model ProcessingMaterial {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  processingId String  @map("processing_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  /// Consumed quantity in human units (Decimal — matches Stock.qty).
  qty          Decimal @db.Decimal(20, 6)
  position     Int     @default(0)

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  processing Processing @relation(fields: [processingId], references: [id], onDelete: Cascade)
  product    Product    @relation("ProcessingMaterialProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([processingId, productId])
  @@index([accountId, processingId, position])
  @@map("processing_materials")
}

/// Explicit per-operation OUTPUT line (moysklad Техоперация `products`
/// array, §89). When ≥1 ProcessingProduct row exists the post()
/// cascade produces THESE (multi-output / by-products / co-products)
/// instead of the single BOM product. Absent ⇒ single BOM output
/// (unchanged). Total consumed cost is distributed across outputs by
/// qty-proportion (largest-remainder, exact tiyin conservation —
/// documented principled by-product costing convention; moysklad's
/// exact basis not in captured ref). N=1 ⇒ all cost to it
/// (byte-identical to pre-§89).
model ProcessingProduct {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  processingId String  @map("processing_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  /// Produced quantity in human units (Decimal — matches Stock.qty).
  qty          Decimal @db.Decimal(20, 6)
  position     Int     @default(0)

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  processing Processing @relation(fields: [processingId], references: [id], onDelete: Cascade)
  product    Product    @relation("ProcessingProductProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([processingId, productId])
  @@index([accountId, processingId, position])
  @@map("processing_products")
}

// =========================================================================
// Payroll (Ish haqi / Зарплата) — per-employee monthly payroll record.
// =========================================================================

/// Payroll document — single employee, single period (typically a month).
/// Lines break down basic salary, bonuses, deductions, taxes. Total
/// `sumMinor` is the net amount payable (post-deductions) and is what a
/// follow-up CashOut/PaymentOut document settles. The payment link is
/// soft (just a doc-level reference) — settlement is recorded separately.
///
/// FSM (planning-only, no stock/balance cascade):
///   draft → posted (commits the payroll figures as the official record)
///   posted → draft (unpost)
///   draft|posted → cancelled
///
/// Posting does NOT auto-create a CashOut. That's a deliberate split:
/// payroll calculation (HR concern) and payment execution (accounting
/// concern) are different responsibilities in real businesses.
model Payroll {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100) // "Z-2026-00001"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  /// The employee being paid. Required — payroll is always one-employee.
  employeeId     String @map("employee_id") @db.Uuid

  /// Period covered (inclusive). Typically a month, but free-form.
  periodStart DateTime  @map("period_start") @db.Timestamptz()
  periodEnd   DateTime  @map("period_end") @db.Timestamptz()
  moment      DateTime  @default(now()) @db.Timestamptz()
  applicable  Boolean   @default(false)
  state       String    @default("draft") @db.VarChar(30)
  postedAt    DateTime? @map("posted_at") @db.Timestamptz()

  /// Net payable amount in BigInt minor units (UZS tiyin).
  /// Derived from line items: SUM(positive earnings) − SUM(absolute(deductions)).
  /// Denormalised on header for fast list/sort.
  sumMinor BigInt @default(0) @map("sum_minor")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?     @relation("PayrollOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?        @relation("PayrollGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization Organization  @relation("PayrollOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee      @relation("PayrollEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  lines        PayrollLine[]

  @@unique([accountId, name])
  @@index([accountId, employeeId, periodStart])
  @@index([accountId, state, deletedAt])
  @@map("payrolls")
}

/// LabelTemplate — barcode label layout configuration. Each row is a
/// reusable "paper format" the clerk can pick when printing labels for
/// stock items. Defines grid (cols × rows), gaps, and which product
/// fields to include on each label.
///
/// Print jobs (which products × qty were actually printed) are tracked
/// via LabelPrintJob. The template is just the visual config.
model LabelTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  name        String  @db.VarChar(255)
  description String?

  /// Paper size — 'A4' | 'A5' | 'A6' | 'custom'.
  pageSize     String @default("A4") @map("page_size") @db.VarChar(20)
  /// Custom paper dimensions (mm) when pageSize='custom'. Ignored otherwise.
  pageWidthMm  Int?   @map("page_width_mm")
  pageHeightMm Int?   @map("page_height_mm")

  /// Labels per page: cols × rows.
  cols Int @default(3)
  rows Int @default(8)

  /// Margins + gaps in millimetres (precision: integer mm is enough for
  /// labels — printers don't position with sub-mm accuracy).
  marginTopMm   Int @default(10) @map("margin_top_mm")
  marginLeftMm  Int @default(10) @map("margin_left_mm")
  columnGapMm   Int @default(3) @map("column_gap_mm")
  rowGapMm      Int @default(3) @map("row_gap_mm")
  labelWidthMm  Int @default(60) @map("label_width_mm")
  labelHeightMm Int @default(30) @map("label_height_mm")

  /// Which product fields to print on each label.
  includeName    Boolean @default(true) @map("include_name")
  includePrice   Boolean @default(true) @map("include_price")
  includeBarcode Boolean @default(true) @map("include_barcode")
  includeArticle Boolean @default(true) @map("include_article")
  /// Optional fixed header text (shop name, etc).
  headerText     String? @map("header_text") @db.VarChar(255)

  /// Barcode format — 'EAN13' | 'CODE128' | 'QR'.
  barcodeFormat String @default("EAN13") @map("barcode_format") @db.VarChar(20)

  archived  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  printJobs LabelPrintJob[]

  @@unique([accountId, name])
  @@index([accountId, archived, deletedAt])
  @@map("label_templates")
}

/// LabelPrintJob — audit record of a print operation. Captures which
/// template + which products × quantities were printed, by whom, when.
/// No state machine — once created, it's a historical record.
model LabelPrintJob {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  ownerId   String @map("owner_id") @db.Uuid

  templateId String @map("template_id") @db.Uuid

  /// Snapshot of products + quantities printed. Shape:
  ///   { items: [{ productId, productName, qty, barcode }] }
  /// Snapshotted at print time so the audit row is stable even if the
  /// underlying product/barcode is later edited.
  itemsSnapshot Json @map("items_snapshot")

  /// Total label count across all items.
  totalLabels Int @default(0) @map("total_labels")

  /// Page count consumed (computed from totalLabels / (cols × rows)).
  pageCount Int @default(0) @map("page_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner    Employee      @relation("LabelPrintJobOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  template LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("label_print_jobs")
}

/// Public publication of a document. Lets a clerk share a CustomerOrder
/// / InvoiceOut / Quote etc. via a public URL that the recipient can
/// open without logging in. Tracks views (open counter) and supports
/// optional access token + expiry.
///
/// Polymorphic by (targetType, targetId). targetType is a free-form
/// enum matching moysklad: 'customerorder' | 'invoiceout' |
/// 'demand' | 'supply' | 'paymentin' | 'paymentout' | 'cashin' |
/// 'cashout' | 'salesreturn' | 'purchasereturn' | 'move' | 'enter' |
/// 'loss' | 'inventory' | 'purchaseorder' | 'invoicein' | 'payroll'.
///
/// One publication per (targetType, targetId) — re-publishing returns
/// the existing row (idempotent via unique constraint).
model Publication {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  /// Who created the publication.
  ownerId   String @map("owner_id") @db.Uuid

  /// Document kind (lowercase, matches moysklad's docType slugs).
  targetType String @map("target_type") @db.VarChar(40)
  targetId   String @map("target_id") @db.Uuid

  /// Opaque random token embedded in the public URL.
  /// Path: /p/<token>. Treat as a bearer credential — anyone with it sees the doc.
  token String @unique @db.VarChar(64)

  /// Optional human-readable description (private label only).
  description String?

  /// Number of times the public URL has been viewed. Bumped by the
  /// public viewer endpoint; eventual-consistent (no strict atomicity
  /// needed for the counter).
  viewCount Int @default(0) @map("view_count")

  /// Last-view timestamp for analytics.
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz()

  /// Optional expiry — link returns 410 Gone after this. Null = no expiry.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()

  /// Optional access password (hashed). When set, the viewer prompts
  /// for a passcode before rendering.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// Revoked publications stop serving (410 Gone) but the row is kept
  /// so analytics history is preserved.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner   Employee @relation("PublicationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([accountId, targetType, targetId])
  @@index([accountId, revokedAt, expiresAt])
  @@map("publications")
}

/// Single line in a Payroll. Positive `sumMinor` = earnings (salary,
/// bonus, overtime, ...). Negative `sumMinor` = deductions (tax,
/// advance, garnishment, ...).
///
/// `itemType` is a free-form enum so localisation can map it to display
/// labels — we don't constrain at the DB level so accounting teams can
/// add their own categories without a migration.
model PayrollLine {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  payrollId String @map("payroll_id") @db.Uuid

  position Int @default(0)

  /// e.g. 'salary' | 'bonus' | 'overtime' | 'vacation' | 'sick' |
  ///      'tax_income' | 'tax_social' | 'advance' | 'penalty' | 'other'
  itemType String @map("item_type") @db.VarChar(40)
  /// Human-readable description (e.g. "Asosiy oylik", "Premiya — yangi yil")
  itemName String @map("item_name") @db.VarChar(255)
  /// Signed minor amount: positive = earning, negative = deduction.
  sumMinor BigInt @map("sum_minor")
  /// Optional extra detail (hours worked, rate, etc.) as free-form JSON.
  meta     Json?

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId, position])
  @@map("payroll_lines")
}

// =========================================================================
// Tax invoices + commission reports + marking docs (RU/UZ compliance)
// =========================================================================
//
// These docs are rare in pure UZ workflow but moysklad surfaces them
// for parity. We model with minimal fields — full UZ fiscal doc set
// will replace them in the soliq.uz integration sprint (out-of-scope
// per user instruction, but the schema is here so docs that REFERENCE
// them have a target).

/// Outgoing tax invoice (Счёт-фактура выданная). RU compliance doc;
/// UZ uses MXIK chek and Soliq.uz EDO instead. Kept for moysklad parity
/// + future UZ EDO integration.
model FactureOut {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId          String  @map("agent_id") @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  /// moysklad «Счёт-фактура выданный» bases (§66, captured-reference
  /// factureout.json): `demands` is a 1+ array → canonical link is the
  /// FactureOutDemand join. `demandId` is kept as a denormalised
  /// "primary source" pointer (first demand) for back-compat + simple
  /// queries — NOT a parallel model (the join is the source of truth).
  /// Alternatively the facture is based on a возврат поставщику
  /// (purchaseReturnId) or an входящий платёж / аванс (paymentInId).
  demandId         String? @map("demand_id") @db.Uuid
  purchaseReturnId String? @map("purchase_return_id") @db.Uuid
  paymentInId      String? @map("payment_in_id") @db.Uuid
  /// «Ставка НДС для авансового платежа» — only on payment-based factures.
  advanceVatRate   Int?    @map("advance_vat_rate")

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor    BigInt @default(0) @map("sum_minor")
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner          Employee?          @relation("FactureOutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group          Group?             @relation("FactureOutGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent          Counterparty       @relation("FactureOutAgent", fields: [agentId], references: [id], onDelete: Restrict)
  organization   Organization       @relation("FactureOutOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  demand         Demand?            @relation("FactureOutDemand", fields: [demandId], references: [id], onDelete: SetNull)
  purchaseReturn PurchaseReturn?    @relation("FactureOutPurchaseReturn", fields: [purchaseReturnId], references: [id], onDelete: SetNull)
  paymentIn      PaymentIn?         @relation("FactureOutPaymentIn", fields: [paymentInId], references: [id], onDelete: SetNull)
  demandLinks    FactureOutDemand[]

  @@unique([accountId, name])
  @@index([accountId, purchaseReturnId])
  @@index([accountId, paymentInId])
  @@map("factures_out")
}

/// Join: Счёт-фактура выданный ↔ Отгрузки (moysklad `demands` array,
/// 1+). Canonical multi-source link (§66).
model FactureOutDemand {
  id           String @id @default(uuid()) @db.Uuid
  accountId    String @map("account_id") @db.Uuid
  factureOutId String @map("facture_out_id") @db.Uuid
  demandId     String @map("demand_id") @db.Uuid

  factureOut FactureOut @relation(fields: [factureOutId], references: [id], onDelete: Cascade)
  demand     Demand     @relation("FactureOutDemandLink", fields: [demandId], references: [id], onDelete: Cascade)

  @@unique([factureOutId, demandId])
  @@index([accountId, demandId])
  @@map("facture_out_demands")
}

/// Incoming tax invoice received from supplier. Mirror of FactureOut.
model FactureIn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId        String  @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// moysklad «Счёт-фактура полученный» bases (§66, captured-reference
  /// facturein.json): `supplies` is a 1+ array → canonical link is the
  /// FactureInSupply join; `supplyId` is the denormalised primary
  /// pointer (back-compat). Alternatively based on исходящий платёж
  /// (paymentOutId).
  supplyId       String? @map("supply_id") @db.Uuid
  paymentOutId   String? @map("payment_out_id") @db.Uuid

  /// Supplier's facture number + date (as printed on their paper).
  incomingNumber String?   @map("incoming_number") @db.VarChar(100)
  incomingDate   DateTime? @map("incoming_date") @db.Timestamptz()

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor    BigInt @default(0) @map("sum_minor")
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?         @relation("FactureInOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?            @relation("FactureInGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty      @relation("FactureInAgent", fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization      @relation("FactureInOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  supply       Supply?           @relation("FactureInSupply", fields: [supplyId], references: [id], onDelete: SetNull)
  paymentOut   PaymentOut?       @relation("FactureInPaymentOut", fields: [paymentOutId], references: [id], onDelete: SetNull)
  supplyLinks  FactureInSupply[]

  @@unique([accountId, name])
  @@index([accountId, paymentOutId])
  @@map("factures_in")
}

/// Join: Счёт-фактура полученный ↔ Приёмки (moysklad `supplies` array,
/// 1+). Canonical multi-source link (§66).
model FactureInSupply {
  id          String @id @default(uuid()) @db.Uuid
  accountId   String @map("account_id") @db.Uuid
  factureInId String @map("facture_in_id") @db.Uuid
  supplyId    String @map("supply_id") @db.Uuid

  factureIn FactureIn @relation(fields: [factureInId], references: [id], onDelete: Cascade)
  supply    Supply    @relation("FactureInSupplyLink", fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([factureInId, supplyId])
  @@index([accountId, supplyId])
  @@map("facture_in_supplies")
}

/// Outgoing commission report (Отчёт комиссионера). Used when we sell
/// goods on behalf of a counterparty (consignment) and report
/// settlement back. Rare in standard UZ retail.
model CommissionReportOut {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId        String  @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  contractId     String? @map("contract_id") @db.Uuid

  /// «Статус» — account-defined custom status (State row,
  /// entityType="commissionreportout"), mirroring Supply.statusId. Orthogonal to
  /// the FSM `state` + «Проведено»; onDelete: SetNull so deleting a status just
  /// unlinks it.
  statusId String? @map("status_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor              BigInt @default(0) @map("sum_minor")
  vatSumMinor           BigInt @default(0) @map("vat_sum_minor")
  rewardSumMinor        BigInt @default(0) @map("reward_sum_minor")
  rewardVatSumMinor     BigInt @default(0) @map("reward_vat_sum_minor")
  payedSumMinor         BigInt @default(0) @map("payed_sum_minor")
  // «Сумма комитента» payable to the consigner; «Прочие услуги» = non-commission
  // service positions. moysklad list columns; default 0 until the create/post sprint.
  commitentSumMinor     BigInt @default(0) @map("commitent_sum_minor")
  otherServicesSumMinor BigInt @default(0) @map("other_services_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?    @relation("CommReportOutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?       @relation("CommReportOutGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty @relation("CommReportOutAgent", fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization @relation("CommReportOutOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  contract     Contract?    @relation("CommReportOutContract", fields: [contractId], references: [id], onDelete: SetNull)
  status       State?       @relation("CommReportOutStatus", fields: [statusId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@map("commission_reports_out")
}

/// Incoming commission report — mirror of CommissionReportOut for the
/// case where someone sells our goods.
model CommissionReportIn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  agentId        String  @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  contractId     String? @map("contract_id") @db.Uuid

  /// «Статус» — account-defined custom status (State row,
  /// entityType="commissionreportin"), mirroring CommissionReportOut.statusId.
  statusId String? @map("status_id") @db.Uuid

  /// «Входящий номер» + «от» — the commissioner's own doc number/date on the
  /// received report (moysklad in-editor header fields; OUT has no equivalent).
  incomingNumber String?   @map("incoming_number") @db.VarChar(50)
  incomingDate   DateTime? @map("incoming_date") @db.Timestamptz()

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor              BigInt @default(0) @map("sum_minor")
  vatSumMinor           BigInt @default(0) @map("vat_sum_minor")
  rewardSumMinor        BigInt @default(0) @map("reward_sum_minor")
  rewardVatSumMinor     BigInt @default(0) @map("reward_vat_sum_minor")
  payedSumMinor         BigInt @default(0) @map("payed_sum_minor")
  // «Сумма комитента» payable to the consigner; «Прочие услуги» = non-commission
  // service positions. moysklad list columns; default 0 until the create/post sprint.
  commitentSumMinor     BigInt @default(0) @map("commitent_sum_minor")
  otherServicesSumMinor BigInt @default(0) @map("other_services_sum_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?    @relation("CommReportInOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?       @relation("CommReportInGroup", fields: [groupId], references: [id], onDelete: SetNull)
  agent        Counterparty @relation("CommReportInAgent", fields: [agentId], references: [id], onDelete: Restrict)
  organization Organization @relation("CommReportInOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  contract     Contract?    @relation("CommReportInContract", fields: [contractId], references: [id], onDelete: SetNull)
  status       State?       @relation("CommReportInStatus", fields: [statusId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@map("commission_reports_in")
}

/// Marking emission order (Заказ кодов маркировки) — request to the
/// marking system to mint N codes for a product. EmissionOrder →
/// MarkingCodeOrder → product gets coded → first sale RetireOrder.
/// RU + EAEU; UZ has its own ASL Belgisi flow (different API + format).
/// We model these for moysklad parity; the soliq.uz / ASL Belgisi
/// integration replaces the actual provider call in a separate sprint.
model EmissionOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)

  organizationId String @map("organization_id") @db.Uuid

  moment     DateTime @default(now()) @db.Timestamptz()
  applicable Boolean  @default(false)
  state      String   @default("draft") @db.VarChar(30)

  /// 'SHOES' | 'TOBACCO' | 'MEDICINES' | 'PERFUME' | 'TIRES' | 'DAIRY' | ...
  productGroup   String? @map("product_group") @db.VarChar(30)
  /// Total codes requested.
  codesRequested Int     @default(0) @map("codes_requested")
  codesIssued    Int     @default(0) @map("codes_issued")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner             Employee?          @relation("EmissionOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group             Group?             @relation("EmissionOrderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization      Organization       @relation("EmissionOrderOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  markingCodeOrders MarkingCodeOrder[] @relation("MarkingCodeOrderEmission")

  @@unique([accountId, name])
  @@map("emission_orders")
}

/// Marking code generation order — produces the codes after EmissionOrder
/// gets approved by the marking provider.
model MarkingCodeOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)

  organizationId  String  @map("organization_id") @db.Uuid
  emissionOrderId String? @map("emission_order_id") @db.Uuid

  moment     DateTime @default(now()) @db.Timestamptz()
  applicable Boolean  @default(false)
  state      String   @default("draft") @db.VarChar(30)

  /// Generated codes payload (CSV / DataMatrix list). Stored as JSON
  /// blob for simplicity; in production this is offloaded to S3 above
  /// ~10MB.
  codesJson  Json? @map("codes_json")
  codesCount Int   @default(0) @map("codes_count")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner         Employee?      @relation("MarkingCodeOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group         Group?         @relation("MarkingCodeOrderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization  Organization   @relation("MarkingCodeOrderOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  emissionOrder EmissionOrder? @relation("MarkingCodeOrderEmission", fields: [emissionOrderId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  @@map("marking_code_orders")
}

/// Retire order — marks codes as sold/retired. Generated automatically
/// by the marking integration after a fiscal Demand / RetailSale of a
/// marked product.
model RetireOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)

  organizationId String  @map("organization_id") @db.Uuid
  /// Source document that drove the retire (Demand / RetailSale / ...).
  parentEntity   String? @map("parent_entity") @db.VarChar(40)
  parentId       String? @map("parent_id") @db.Uuid

  moment     DateTime @default(now()) @db.Timestamptz()
  applicable Boolean  @default(false)
  state      String   @default("draft") @db.VarChar(30)

  /// Reason: RETAIL_SALE | DESTRUCTION | EXPORT_OUTSIDE_EEU | OWN_USE | ...
  retireType String? @map("retire_type") @db.VarChar(30)
  codesJson  Json?   @map("codes_json")

  syncId      String? @map("sync_id") @db.Uuid
  /// Captured for moysklad parity even though most retire orders use
  /// position-level totals; nullable.
  vatSumMinor BigInt  @default(0) @map("vat_sum_minor")
  /// Currency rate snapshot — cisType-1162 markings carry currency context.
  currency    String  @default("UZS") @db.VarChar(3)
  rateValue   BigInt  @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?    @relation("RetireOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?       @relation("RetireOrderGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization Organization @relation("RetireOrderOrg", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@map("retire_orders")
}

// =========================================================================
// Product (Sprint 1 main entity)
// =========================================================================

model Product {
  id              String  @id @default(uuid()) @db.Uuid
  accountId       String  @map("account_id") @db.Uuid
  ownerId         String? @map("owner_id") @db.Uuid
  productFolderId String? @map("product_folder_id") @db.Uuid
  groupId         String? @map("group_id") @db.Uuid
  // Default supplier for replenishment / purchase orders.
  supplierId      String? @map("supplier_id") @db.Uuid
  // «Кто изменил» — the Employee who last created/edited this product, set
  // from the request actor on create + every field-edit update (moysklad
  // surfaces this both as a list column and as a Фильтр field). Mirrors the
  // established PurchaseOrder.modifiedById convention. Nullable: rows created
  // before this column shipped, and any product whose last modifier was later
  // deleted (onDelete: SetNull), read as «unknown».
  modifiedById    String? @map("modified_by_id") @db.Uuid

  name         String  @db.VarChar(255)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  article      String? @db.VarChar(50)
  description  String?
  // Denormalised folder path ("Tovarlar/Elektronika/Telefonlar"). Cached on
  // save so list views can show the breadcrumb without extra joins.
  pathName     String? @map("path_name") @db.VarChar(500)
  // ISO 3166-1 alpha-2 country of origin ("UZ", "CN", "RU", ...).
  // moysklad models this as a Meta reference to Country; we keep a code
  // string and resolve labels at the i18n layer.
  country      String? @db.VarChar(2)

  // Product type discriminator (product | service | bundle | consignment)
  // Sprint 1 handles only 'product'. Others added in later sprints.
  kind String @default("product") @db.VarChar(20)

  // Pricing (stored in minor units = tiyin; scale 100)
  minPrice         BigInt? @map("min_price")
  buyPrice         BigInt? @map("buy_price")
  // Per-price currency (ISO code) — moysklad parity: each price row picks its
  // own currency. NULL = the account base currency. NOTE: the stored amount is
  // the as-entered value in that currency; downstream cost/profit/document math
  // currently assumes base currency (the account is UZS-only) — full
  // multi-currency correctness across analytics/documents is app-wide future
  // work, the same as for the salePrices currencyCode below.
  buyPriceCurrency String? @map("buy_price_currency") @db.VarChar(3)
  minPriceCurrency String? @map("min_price_currency") @db.VarChar(3)
  // Multi-tier prices: [{ priceTypeId, value, currencyCode }]
  salePrices       Json?   @map("sale_prices")

  // Physical
  weightG  Int?    @map("weight_g") // weight in grams
  volumeML Int?    @map("volume_ml") // volume in ml
  weighed  Boolean @default(false) // weighed goods (kg, not pcs)
  uom      String? @db.VarChar(20) // unit of measurement (e.g., "шт", "кг")

  // VAT
  vat          Int?
  vatEnabled   Boolean @default(true) @map("vat_enabled")
  useParentVat Boolean @default(true) @map("use_parent_vat")
  taxSystem    String? @map("tax_system") @db.VarChar(30)

  // UZ-specific
  mxikCode String? @map("mxik_code") @db.VarChar(20) // MXIK/IKPU tasnif.soliq.uz

  // Marking (ASL Belgisi)
  trackingType    String? @map("tracking_type") @db.VarChar(30) // null | SHOES | TOBACCO | MEDICINES | ...
  gtin            String? @db.VarChar(14) // GTIN-13/14 for marking
  // When true, marked items can be partially disposed (sold in fractions).
  // Drives the marking module's "Списание" workflow.
  partialDisposal Boolean @default(false) @map("partial_disposal")

  // Fiscal receipt classification — drives the printed receipt's
  // "Признак предмета расчета" field on Z-reports / OFD submissions.
  // Values (moysklad official enum): GOOD | EXCISABLE_GOOD | COMPOUND_PAYMENT_ITEM |
  // ANOTHER_PAYMENT_ITEM. (Was COMMODITY/EXCISABLE_GOODS — aligned 2026-06-20, see
  // migration 20260620110000_align_payment_item_type for the data backfill.)
  paymentItemType String? @map("payment_item_type") @db.VarChar(40)

  // Serial tracking
  isSerialTrackable Boolean @default(false) @map("is_serial_trackable")

  // K-reja (`docs/plans/2026-08-25-bolinadigan-tovar-bolak-hisobi.md`) — «Bo'lak
  // hisobi yuritilsin». Rulondan metrlab sotiladigan tovar (kabel, sim, shlang,
  // zanjir, lenta): qoldiq bitta son bo'lib turadi, ombordagi JISMONIY bo'laklar
  // (250+250+250+200+150+70+50 = 1220 m) esa hech qayerda yozilmaydi va kassir
  // mijozga «4 ta butun rulon bor» deb yanglishadi.
  //
  // Bayroq yoqilgan tovarning bo'lak reyestri `StockPiece` da yuritiladi. K1 da
  // bayroq FAQAT ustun sifatida qo'shiladi — hech qayerda yoqilmaydi va sverka
  // hisobotidan boshqa hech bir oqim uni o'qimaydi. Yoqish ekrani va siyosati —
  // K6 (birligi «m» bo'lgan YANGI tovarda yoqilgan holda keladi, K-Q9).
  pieceTracked Boolean @default(false) @map("piece_tracked")

  // K6 — BAYROQ SIYOSATI (K-Q9). `pieceTracked` ning O'ZI uch holatni ifodalay
  // olmaydi: `false` bir vaqtda ham «yo'q dedik», ham «hali hech kim
  // qaramagan» degani bo'lardi. «Hal qilinmagan» ro'yxati (K6/3-vazifa) esa
  // aynan ikkinchisini ko'rsatishi kerak — aks holda yangi nomenklatura
  // jimgina o'tib ketadi.
  //
  //   `piece_tracked_decided_at IS NULL`  ⇒ QAROR YO'Q (ro'yxatda turadi)
  //   `piece_tracked_decided_at` to'lgan  ⇒ odam ha/yo'q dedi (ro'yxatdan chiqdi)
  //
  // Birligi «m» bo'lgan YANGI tovar `piece_tracked = true` bilan keladi, lekin
  // qaror MUHRLANMAYDI: bayroq shovqinli ishlaydi (K-Q9 sababi) va tovar
  // baribir ro'yxatda ko'rinib turadi.
  pieceTrackedDecidedAt   DateTime? @map("piece_tracked_decided_at") @db.Timestamptz()
  pieceTrackedDecidedById String?   @map("piece_tracked_decided_by_id") @db.Uuid

  // Discount policy
  discountProhibited Boolean @default(false) @map("discount_prohibited")

  // NB: the per-product denormalised stock rollup columns (stock_minor /
  // reserve_minor / in_transit_minor) were DROPPED 2026-06-12 (migration
  // …_drop_vestigial_product_denorm_stock_columns). They were designed-but-
  // unwired (no app write / trigger / seed ⇒ permanently DEFAULT 0) and had
  // caused a silent-wrong bug (the 11h «Ниже минимума» filter compared against
  // the dead stock_minor). Both live consumers — the «Ниже минимума» re-order
  // filter and the «Остаток»/«Резерв»/«Доступно» list columns (both in
  // product.repository) — aggregate the LIVE Stock ledger at query time (a
  // ≤100-id grouped SUM over the indexed `stocks` table), so nothing referenced
  // them.
  // Lower threshold for alerts (live on-hand stock < minimumBalanceMinor
  // triggers the re-order suggestion). 0 disables.
  minimumBalanceMinor BigInt @default(0) @map("minimum_balance_minor")

  // Metadata
  shared       Boolean  @default(false)
  archived     Boolean  @default(false)
  syncId       String?  @map("sync_id") @db.Uuid
  barcodes     String[] @default([])
  // Per-barcode GTIN type (moysklad parity — moysklad stores barcodes typed:
  // `[{ean13: "…"}]`). Index-aligned PARALLEL array to `barcodes` (barcodeTypes[i]
  // is the type of barcodes[i]); empty/short ⇒ the FE defaults the row to "ean13".
  // Kept SEPARATE from `barcodes` on purpose so the list/search `has` filters over
  // raw barcode values stay unchanged. Additive, defaults [] (back-compat).
  barcodeTypes String[] @default([]) @map("barcode_types")
  attributes   Json?

  /// Optimistic concurrency version (moysklad parity). Incremented on every
  /// field-edit save; a stale value rejects the write with HTTP 409 so two
  /// users editing the same product can't silently lost-update each other.
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  // Soft delete
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                   Employee?                @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  modifiedBy              Employee?                @relation("ProductModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)
  pieceTrackedDecidedBy   Employee?                @relation("ProductPieceFlagDecidedBy", fields: [pieceTrackedDecidedById], references: [id], onDelete: SetNull)
  productFolder           ProductFolder?           @relation(fields: [productFolderId], references: [id], onDelete: SetNull)
  group                   Group?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  supplier                Counterparty?            @relation("ProductSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  packs                   ProductPack[]
  customerOrderPositions  CustomerOrderPosition[]  @relation("ProductCustomerOrderPositions")
  demandPositions         DemandPosition[]         @relation("ProductDemandPositions")
  invoiceOutPositions     InvoiceOutPosition[]     @relation("ProductInvoiceOutPositions")
  invoiceInPositions      InvoiceInPosition[]      @relation("ProductInvoiceInPositions")
  supplyPositions         SupplyPosition[]         @relation("ProductSupplyPositions")
  purchaseOrderPositions  PurchaseOrderPosition[]  @relation("ProductPurchaseOrderPositions")
  salesReturnPositions    SalesReturnPosition[]    @relation("ProductSalesReturnPositions")
  purchaseReturnPositions PurchaseReturnPosition[] @relation("ProductPurchaseReturnPositions")
  movePositions           MovePosition[]           @relation("ProductMovePositions")
  internalOrderPositions  InternalOrderPosition[]  @relation("ProductInternalOrderPositions")
  lossPositions           LossPosition[]           @relation("ProductLossPositions")
  enterPositions          EnterPosition[]          @relation("ProductEnterPositions")
  inventoryPositions      InventoryPosition[]      @relation("ProductInventoryPositions")
  variants                Variant[]
  bundleComponents        BundleComponent[]        @relation("BundleParent")
  asBundleComponentIn     BundleComponent[]        @relation("BundleComponentProduct")
  images                  ProductImage[]
  bomsAsOutput            BillOfMaterials[]        @relation("BomOutputProduct")
  bomsAsComponent         BomComponent[]           @relation("BomComponentProduct")
  processingMaterials     ProcessingMaterial[]     @relation("ProcessingMaterialProduct")
  processingProducts      ProcessingProduct[]      @relation("ProcessingProductProduct")
  retailSalePositions     RetailSalePosition[]     @relation("RetailSalePositionProduct")
  consignments            Consignment[]            @relation("ProductConsignment")
  // «Аналоги» — substitute products offered when this one is out of stock. The
  // join is stored DIRECTIONALLY (this product → its analog); `analogs` are the
  // rows owned by THIS product (its analog list, what the card's Аналоги tab
  // shows), `analogOf` are rows where this product is someone else's analog.
  analogs                 ProductAnalog[]          @relation("ProductAnalogsOwner")
  analogOf                ProductAnalog[]          @relation("ProductAnalogsTarget")
  // Multi-bin (2026-08-06, restores 7639050c dropped by 55cf3bf): every cell
  // this product is bound to, beyond the single denormalized
  // `attributes.__yacheyka` "home" cache. See ProductCellLink.
  cellLinks               ProductCellLink[]        @relation("ProductCellLinks")

  @@unique([accountId, code])
  @@unique([accountId, externalCode])
  @@index([accountId, archived, deletedAt])
  @@index([accountId, productFolderId])
  @@index([accountId, kind])
  @@index([accountId, trackingType])
  @@index([accountId, mxikCode])
  @@index([accountId, supplierId])
  @@index([accountId, groupId])
  @@index([accountId, modifiedById])
  // Trigram GIN (perf audit 2026-07-23) — product name ILIKE search.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  // DB-04 (audit 2026-08-08, faza 25) — POS barcode scan. The lookup is
  // `barcodes: { has: tok }` → `barcodes @> ARRAY[tok]`, which only a GIN
  // array_ops index can serve; without it every scan is a full account scan.
  // NOTE: this is an index only — barcode UNIQUENESS is deliberately NOT added
  // here (existing duplicates must be merged by a data-migration first).
  @@index([barcodes(ops: ArrayOps)], type: Gin, map: "products_barcodes_gin_idx")
  @@map("products")
}

// «Аналоги» — substitute products for a product. Mirrors moysklad's analog
// list on the product card (the «Аналоги» tab): other products the operator
// can offer a buyer when this product is out of stock or otherwise unsuitable.
//
// Self-referential many-to-many on Product, stored DIRECTIONALLY: one row =
// "productId offers analogId as an analog". The reverse is NOT auto-created —
// the tab shows exactly this product's own list (parity with the UI, which
// edits one product's analogs at a time). `@@unique([productId, analogId])`
// makes a duplicate add fail (the FE surfaces moysklad's «Такой аналог уже
// добавлен»). Both sides cascade-delete so removing either product cleans up.
model ProductAnalog {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  analogId  String   @map("analog_id") @db.Uuid
  // Display order in the tab (append-on-add). Kept so the list is stable.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation("ProductAnalogsOwner", fields: [productId], references: [id], onDelete: Cascade)
  analog  Product @relation("ProductAnalogsTarget", fields: [analogId], references: [id], onDelete: Cascade)

  @@unique([productId, analogId])
  @@index([accountId])
  @@index([productId])
  @@index([analogId])
  @@map("product_analogs")
}

// Product alternative pack / unit of measure. Mirrors moysklad's `packs`
// MetaArray on Product. Lets the operator define "Box of 12" as an
// alternative purchase / sale unit; quantities convert via multiplier.
//
// uomCode references the basic UoM ("шт", "кг") and multiplier expresses
// how many base units one pack contains. Barcode is optional (for cases
// where the carton has its own GTIN).
model ProductPack {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  // Variant-scoped pack: when set, the pack overrides the parent product's
  // packs for this variant only. moysklad lets each variant carry its own
  // alternative-pack list (e.g. red shirts in 6-packs, blue in 12-packs).
  variantId  String?  @map("variant_id") @db.Uuid
  // Display label: "Quti (12 dona)".
  name       String   @db.VarChar(255)
  uomCode    String   @map("uom_code") @db.VarChar(20)
  // How many base units one pack contains. Stored × 1000 (matches
  // quantity/stock convention) so 0.5 ≡ 500 and 12 ≡ 12000.
  multiplier BigInt
  barcode    String?  @db.VarChar(50)
  // «Тип кода» — barcode symbology of THIS pack's `barcode` (moysklad's pack-row
  // column, default "EAN13"). Same enum as a product barcode type
  // (ean13/ean8/code128/gtin). Null = treated as ean13 in the UI.
  codeType   String?  @map("code_type") @db.VarChar(20)
  // «Код упаковки ТАСНИФ» — Uzbekistan TASNIF package classification code
  // (moysklad «Товары и услуги» offers it as a column + Фильтр field). Optional;
  // set via the product editor's pack rows or import.
  tasnifCode String?  @map("tasnif_code") @db.VarChar(50)
  // Display order in pickers; lower = first.
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation("VariantPack", fields: [variantId], references: [id], onDelete: Cascade)

  @@index([accountId, productId])
  @@index([accountId, variantId])
  @@map("product_packs")
}

// =========================================================================
// Sales Documents (Sprint 3)
// =========================================================================

/// Заказ покупателя — CustomerOrder.
/// FSM: draft → confirmed → (partially_shipped | awaiting_payment) → fully_shipped / paid → closed
///      (any) → cancelled
/// Side effect on confirm: reserves positions[].quantity in stock.
model CustomerOrder {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document-level identity
  name         String  @db.VarChar(100) // visible number, e.g. "ЗП-2026-00001"
  // Internal code (separate from `name` which is the visible number).
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  // External system sync key (1C, e-commerce). Immutable once set.
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // customer counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  storeId               String  @map("store_id") @db.Uuid
  salesChannelId        String? @map("sales_channel_id") @db.Uuid
  // moysklad's user-defined «Статус» (Текширилмаган, …) — a tenant-configured
  // State (entityType="customerorder"), independent of the `state` FSM below
  // (which drives the payment/shipment lifecycle). Null = no custom status set.
  statusId              String? @map("status_id") @db.Uuid

  /// Optional contract scoping the order — moysklad's "Договор" field.
  /// Used downstream by reports and counterparty balance computations.
  contractId String? @map("contract_id") @db.Uuid
  /// Optional project tagging the order — moysklad's "Проект" field.
  /// Lets users group orders for cost-centre reporting.
  projectId  String? @map("project_id") @db.Uuid

  // Per-document tax-system override (USN_INCOME / USN_INCOME_OUTCOME /
  // ENVD / ESHN / PSN / OSN — UZ accounts mostly use USN_* + OSN). Null
  // means inherit from organization.
  taxSystem String? @map("tax_system") @db.VarChar(30)

  // Moment + lifecycle
  moment                DateTime  @default(now()) @db.Timestamptz()
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()
  applicable            Boolean   @default(false) // провéдено
  state                 String    @default("draft") @db.VarChar(30)

  // Money totals (tiyin minor units)
  // Computed from positions: sum = Σ(qty*price*(1-discount/100)) + vatSum
  sumMinor         BigInt @default(0) @map("sum_minor")
  vatSumMinor      BigInt @default(0) @map("vat_sum_minor")
  payedSumMinor    BigInt @default(0) @map("payed_sum_minor")
  invoicedSumMinor BigInt @default(0) @map("invoiced_sum_minor")
  reservedSumMinor BigInt @default(0) @map("reserved_sum_minor")
  shippedSumMinor  BigInt @default(0) @map("shipped_sum_minor")

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value") // rate * 10^8 precision

  // Shipment delivery address (denormalised at order time).
  shipmentAddress     String? @map("shipment_address") @db.VarChar(500)
  shipmentAddressFull Json?   @map("shipment_address_full")

  // Metadata
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?               @relation("CustomerOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount?    @relation("CustomerOrderAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount?    @relation("CustomerOrderOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  salesChannel        SalesChannel?           @relation("CustomerOrderSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  status              State?                  @relation("CustomerOrderStatus", fields: [statusId], references: [id], onDelete: SetNull)
  contract            Contract?               @relation("CustomerOrderContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?                @relation("CustomerOrderProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions           CustomerOrderPosition[]
  demands             Demand[]
  invoicesOut         InvoiceOut[]
  salesReturns        SalesReturn[]
  moves               Move[]                  @relation("MoveCustomerOrder")
  retailSales         RetailSale[]            @relation("RetailSaleCustomerOrder")
  prepayments         Prepayment[]            @relation("PrepaymentCustomerOrder")
  productions         Production[]            @relation("ProductionCustomerOrder")
  paymentInOperations PaymentInOperation[]    @relation("PaymentInOpCustomerOrder")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, deliveryPlannedMoment])
  @@index([accountId, ownerId])
  @@index([accountId, salesChannelId])
  // DB-08 (audit 2026-08-08, faza 25) — FK columns Postgres does NOT index by
  // itself. Single-column on purpose: these UUID FKs are already account-unique
  // (so `account_id = A AND status_id = S` stays selective), and only a leading
  // FK column serves the referential-integrity scan the parent's ON DELETE
  // SET NULL / RESTRICT runs (`WHERE status_id = $1` — no account_id there).
  @@index([statusId])
  @@index([contractId])
  @@index([projectId])
  @@index([storeId])
  @@map("customer_orders")
}

/// Position (line item) on a CustomerOrder.
/// Polymorphic via `assortmentKind` + `assortmentId` — currently only 'product'.
model CustomerOrderPosition {
  id              String @id @default(uuid()) @db.Uuid
  customerOrderId String @map("customer_order_id") @db.Uuid
  accountId       String @map("account_id") @db.Uuid // denormalized for scoped queries

  // Line order
  position Int

  // What's being sold
  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid // mirrors assortmentId when kind=product

  // Quantities
  quantity    Decimal @db.Decimal(20, 6)
  reservedQty Decimal @default(0) @map("reserved_qty") @db.Decimal(20, 6)
  shippedQty  Decimal @default(0) @map("shipped_qty") @db.Decimal(20, 6)

  // Pricing (tiyin, minor units)
  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2) // percent 0-100
  vat        Int? // percent, nullable
  vatEnabled Boolean @default(true) @map("vat_enabled")

  customerOrder       CustomerOrder        @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  product             Product?             @relation("ProductCustomerOrderPositions", fields: [productId], references: [id], onDelete: Restrict)
  demandPositions     DemandPosition[]     @relation("DemandFromCustomerOrderPosition")
  invoiceOutPositions InvoiceOutPosition[] @relation("InvoiceOutFromCustomerOrderPosition")

  @@index([customerOrderId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@map("customer_order_positions")
}

// =========================================================================
// Sprint 3.3 — InvoiceOut (Счёт покупателю)
// =========================================================================

/// Счёт покупателю — outbound invoice requesting payment.
/// FSM:
///   draft → posted (applicable=true, updates CO.invoicedSum)
///   posted → sent (email/portal delivery; published=true) — Sprint 3.3 later
///   posted|sent → partially_paid (derived from PaymentIn) — Sprint 3.4
///   posted|sent|partially_paid → paid (derived, payedSum ≥ sum) — Sprint 3.4
///   posted|sent|partially_paid → overdue (scheduled) — post-MVP
///   draft|posted|sent|overdue → cancelled
///
/// Linked to CustomerOrder (optional) — posting updates CO.invoicedSumMinor.
/// Dual progression: send state (published) + payment state (paid) evolve
/// independently; the `state` column tracks the dominant one.
model InvoiceOut {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "СЧ-2026-00001"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  // moysklad has store on InvoiceOut to disambiguate which warehouse
  // the invoice's items will ship from. Optional — null = inherit from
  // CustomerOrder.store on link.
  storeId               String? @map("store_id") @db.Uuid
  salesChannelId        String? @map("sales_channel_id") @db.Uuid
  /// Optional contract scoping the invoice — moysklad's "Договор" field.
  contractId            String? @map("contract_id") @db.Uuid
  /// Optional project tagging the invoice — moysklad's "Проект" field.
  projectId             String? @map("project_id") @db.Uuid
  customerOrderId       String? @map("customer_order_id") @db.Uuid
  /// moysklad «Статус» — account-defined custom status (State row,
  /// entityType="invoiceout"), mirroring Supply.statusId. Orthogonal to the
  /// FSM `state` column + the «Проведено» flag.
  statusId              String? @map("status_id") @db.Uuid

  // Moment + lifecycle
  moment               DateTime  @default(now()) @db.Timestamptz()
  paymentPlannedMoment DateTime? @map("payment_planned_moment") @db.Timestamptz()
  applicable           Boolean   @default(false)
  state                String    @default("draft") @db.VarChar(30)
  postedAt             DateTime? @map("posted_at") @db.Timestamptz()
  sentAt               DateTime? @map("sent_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor        BigInt @default(0) @map("sum_minor")
  vatSumMinor     BigInt @default(0) @map("vat_sum_minor")
  payedSumMinor   BigInt @default(0) @map("payed_sum_minor")
  // shippedSum tracks how much of this invoice's items have been delivered
  // (cascades from linked Demand documents). Drives the "Отгружено" column.
  shippedSumMinor BigInt @default(0) @map("shipped_sum_minor")

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Metadata
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("InvoiceOutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount? @relation("InvoiceOutAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("InvoiceOutOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store?               @relation("InvoiceOutStore", fields: [storeId], references: [id], onDelete: SetNull)
  salesChannel        SalesChannel?        @relation("InvoiceOutSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract            Contract?            @relation("InvoiceOutContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?             @relation("InvoiceOutProject", fields: [projectId], references: [id], onDelete: SetNull)
  customerOrder       CustomerOrder?       @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  // Custom «Статус» (State row) — SetNull so deleting a status just unlinks it.
  status              State?               @relation("InvoiceOutStatus", fields: [statusId], references: [id], onDelete: SetNull)
  positions           InvoiceOutPosition[]
  paymentInOperations PaymentInOperation[]
  cashInOperations    CashInOperation[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, customerOrderId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, paymentPlannedMoment])
  @@index([accountId, ownerId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("invoices_out")
}

/// Line position for InvoiceOut. Mirrors CustomerOrderPosition shape.
model InvoiceOutPosition {
  id           String @id @default(uuid()) @db.Uuid
  invoiceOutId String @map("invoice_out_id") @db.Uuid
  accountId    String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  customerOrderPositionId String? @map("customer_order_position_id") @db.Uuid

  quantity Decimal @db.Decimal(20, 6)

  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  invoiceOut            InvoiceOut             @relation(fields: [invoiceOutId], references: [id], onDelete: Cascade)
  product               Product?               @relation("ProductInvoiceOutPositions", fields: [productId], references: [id], onDelete: Restrict)
  customerOrderPosition CustomerOrderPosition? @relation("InvoiceOutFromCustomerOrderPosition", fields: [customerOrderPositionId], references: [id], onDelete: SetNull)

  @@index([invoiceOutId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([accountId, customerOrderPositionId])
  @@map("invoice_out_positions")
}

// =========================================================================
// Sprint 3.4 — Supply (Приёмка) — inbound stock
// =========================================================================

/// Приёмка — Supply (inbound receipt of goods from supplier).
/// FSM: draft → posted (applicable=true, stock incremented, cost recorded)
///      posted → draft (unpost: reverses stock)
///      draft → (soft-deleted)
///
/// Mirror of Demand but with positive stock deltas and per-position cost
/// basis (for future FIFO consumption on Demand posting).
model Supply {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "ПР-2026-00001"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // supplier counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  storeId               String  @map("store_id") @db.Uuid

  // Moment + lifecycle
  moment         DateTime  @default(now()) @db.Timestamptz()
  incomingDate   DateTime? @map("incoming_date") @db.Timestamptz() // declared receiving date
  incomingNumber String?   @map("incoming_number") @db.VarChar(50) // supplier's invoice #
  applicable     Boolean   @default(false)
  state          String    @default("draft") @db.VarChar(30) // draft | posted | cancelled
  postedAt       DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor             BigInt @default(0) @map("sum_minor")
  vatSumMinor          BigInt @default(0) @map("vat_sum_minor")
  // Cost aggregate (== sumMinor pre-VAT typically, but may differ with overhead allocation)
  costSumMinor         BigInt @default(0) @map("cost_sum_minor")
  payedSumMinor        BigInt @default(0) @map("payed_sum_minor")
  // Overhead — additional cost (delivery, customs) distributed across
  // line items. Drives FIFO cost basis at post time.
  overheadSumMinor     BigInt @default(0) @map("overhead_sum_minor")
  overheadDistribution String @default("WEIGHT") @map("overhead_distribution") @db.VarChar(20)
  overheadCurrency     String @default("UZS") @map("overhead_currency") @db.VarChar(3)

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Metadata
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  // Sprint 4.4: optional back-link to PurchaseOrder. Posting cascades into
  // PO.applyReceipt → updates PO.receivedSumMinor + auto-transitions to
  // partially_received / fully_received / closed.
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid
  /// Optional contract scoping the supply — moysklad's "Договор" field.
  contractId      String? @map("contract_id") @db.Uuid
  /// Optional project tagging the supply — moysklad's "Проект" field.
  projectId       String? @map("project_id") @db.Uuid
  /// moysklad «Статус» — account-defined custom status (State row,
  /// entityType="supply"), mirroring PurchaseOrder.statusId. Orthogonal to the
  /// FSM `state` column + the «Проведено» flag; the toolbar «Статус» menu sets
  /// it on the selected receipts. SetNull so deleting a status just unlinks.
  statusId        String? @map("status_id") @db.Uuid

  /// Multi-role approval workflow bosqichi (2026-07-29 spec). FSM `state` +
  /// `applicable`dan ORTOGONAL; taminotchi→omborchi→admin zanjirini boshqaradi.
  /// Stock faqat admin-tasdig'ida (stage→completed → transition 'post') oshadi.
  approvalStage String @default("none") @map("approval_stage") @db.VarChar(30) // none|awaiting_supplier|delivering|awaiting_admin|completed

  account             Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?             @relation("SupplyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount?  @relation("SupplyAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount?  @relation("SupplyOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  purchaseOrder       PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  contract            Contract?             @relation("SupplyContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?              @relation("SupplyProject", fields: [projectId], references: [id], onDelete: SetNull)
  status              State?                @relation("SupplyStatus", fields: [statusId], references: [id], onDelete: SetNull)
  positions           SupplyPosition[]
  approvalEvents      SupplyApprovalEvent[]
  approvalLinks       SupplyApprovalLink[]
  purchaseReturns     PurchaseReturn[]
  moves               Move[]                @relation("MoveSupply")
  factureIns          FactureIn[]           @relation("FactureInSupply")
  factureInLinks      FactureInSupply[]     @relation("FactureInSupplyLink")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, storeId, applicable])
  @@index([accountId, purchaseOrderId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("supplies")
}

/// Qabul-tasdiqlash workflow audit-izi (2026-07-29 spec). Har bosqich-o'tishiga
/// (forward yoki reject) bitta qator — kim / qachon / sabab / omborchi-tuzatishlari.
model SupplyApprovalEvent {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  supplyId  String @map("supply_id") @db.Uuid
  supply    Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  fromStage String  @map("from_stage") @db.VarChar(30)
  toStage   String  @map("to_stage") @db.VarChar(30)
  action    String  @db.VarChar(20) // send | supplier_ok | omborchi_ok | admin_ok | reject
  actorType String  @map("actor_type") @db.VarChar(20) // supplier | omborchi | admin | system
  actorId   String? @map("actor_id") @db.Uuid
  reason    String? @db.Text
  detail    Json? // omborchi tuzatishlari: [{positionId, was, now}]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId, supplyId, createdAt])
  @@map("supply_approval_events")
}

/// Qabul tasdiqlash MAGIC-LINK (Faza E, 2026-07-30) — taminotchi parolsiz kirib
/// tasdiq/rad qiladigan bir-martalik capability-token. Token supply+role+agentга
/// bog'langan va MUDDATLI (URL'дан accountId olinmaydi — bu qatordан). Public
/// endpoint FAQAT applySupplierDecision/reject chaqiradi (CRUD YO'Q).
model SupplyApprovalLink {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  supplyId  String @map("supply_id") @db.Uuid
  supply    Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  token   String  @unique @db.VarChar(64) // randomBytes(24).hex — taxmin-qilib-bo'lmas
  role    String  @db.VarChar(20) // 'supplier' (hozircha faqat tashqi taminotchi)
  agentId String? @map("agent_id") @db.Uuid // qaysi taminotchi (identifikatsiya)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz() // tasdiq/rad qilingач (audit)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId, supplyId])
  @@map("supply_approval_links")
}

/// Supply line position. Polymorphic assortment. costMinor is per-unit cost
/// that contributes to FIFO cost basis (remainingQty tracks how much of this
/// lot is still available for FIFO consumption by outbound Demands).
model SupplyPosition {
  id        String @id @default(uuid()) @db.Uuid
  supplyId  String @map("supply_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  quantity     Decimal @db.Decimal(20, 6)
  remainingQty Decimal @default(0) @map("remaining_qty") @db.Decimal(20, 6) // FIFO lot remaining

  // Pricing (tiyin) — receiving cost basis
  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  // Effective per-unit cost after discount (for FIFO). Computed at post time.
  costMinor BigInt? @map("cost_minor")

  // Sprint 4.4: back-link to the PO line this delivery fulfils. Used by
  // PO.applyReceipt to increment the exact PO.position.receivedQty (vs just
  // the header aggregate). Nullable — ad-hoc deliveries don't need a link.
  purchaseOrderPositionId String? @map("purchase_order_position_id") @db.Uuid

  // moysklad «Номер ГТД» / «Сумма ГТД» / «Страна» — import/customs block on
  // inventory-inbound positions (live-confirmed on Приёмка, PARITY-AUDIT §41).
  // moysklad «РНПТ» (registration number of goods batch) + «Маркировка» (Честный
  // знак marking code(s)) — free-text per-line entry on the Приёмка grid (scan-based
  // DataMatrix capture is a later enhancement; these persist the typed/pasted value).
  rnpt        String? @db.VarChar(255)
  marking     String? @db.VarChar(500)
  gtdNumber   String? @map("gtd_number") @db.VarChar(255)
  gtdSumMinor BigInt? @map("gtd_sum_minor")
  countryId   String? @map("country_id") @db.Uuid

  // moysklad «Ячейка» — address-storage bin (receive-into-cell). cellId drives
  // per-cell stock (StockByCell) on post; `cell` = denormalized «Зона / Ячейка» label.
  cellId String? @map("cell_id") @db.Uuid
  cell   String? @db.VarChar(255)

  /// K5 — kelgan RULONLAR («250x5»). Faqat BUTUN rulon: yetkazuvchidan kelgan
  /// tovar ta'rifiga ko'ra butun o'ram va u yorliq OLMAYDI (K-Q3). Qoldiq
  /// bo'lak kelsa omborchi uni K2 ekranida yorliq bilan qo'shadi — priyomka
  /// ekranida yorliq bosish oqimi yo'q, ya'ni bo'lakni jimgina qabul qilish
  /// uni javondan topib bo'lmaydigan qilib qoldirardi.
  pieceEntry String? @map("piece_entry")

  supply                  Supply                          @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  product                 Product?                        @relation("ProductSupplyPositions", fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderPosition   PurchaseOrderPosition?          @relation("SupplyFromPurchaseOrderPosition", fields: [purchaseOrderPositionId], references: [id], onDelete: SetNull)
  purchaseReturnPositions PurchaseReturnPosition[]        @relation("PurchaseReturnFromSupplyPosition")
  demandConsumptions      DemandPositionCostConsumption[]
  country                 Country?                        @relation("SupplyPositionCountry", fields: [countryId], references: [id], onDelete: SetNull)
  cellRef                 StoreCell?                      @relation("SupplyPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([supplyId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([accountId, purchaseOrderPositionId])
  @@index([cellId])
  @@index([countryId])
  /// FIFO scan path: oldest non-empty supply lot first.
  @@index([accountId, assortmentKind, assortmentId, remainingQty])
  @@map("supply_positions")
}

// =========================================================================
// Sprint 4.1 — PurchaseOrder (Заказ поставщику)
// =========================================================================

/// Заказ поставщику — PurchaseOrder (order placed with supplier).
/// FSM (Sprint 4.1 manual scope):
///   draft → confirmed (applicable=true; reservations deferred to 4.x)
///   confirmed → draft (unconfirm)
///   draft|confirmed → cancelled
///   draft → (soft-deleted)
///
/// Mirrors CustomerOrder shape but supplier-facing. Future sprints add:
///   - sent transition (email delivery)
///   - partially_received / fully_received (auto-transition when Supply
///     posts with purchaseOrderId link; requires Supply.purchaseOrderId +
///     Supply.position.purchaseOrderPositionId)
///   - closed (fully_received AND fully_invoiced AND fully_paid)
model PurchaseOrder {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  ownerId      String? @map("owner_id") @db.Uuid
  groupId      String? @map("group_id") @db.Uuid
  // moysklad-parity «Кто изменил» — author of last update.
  // SetNull on user deletion to preserve historical attribution
  // without a foreign-key violation.
  modifiedById String? @map("modified_by_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "ЗК-2026-00001" (Заказ К поставщику)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // supplier counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  storeId               String  @map("store_id") @db.Uuid
  // moysklad-parity «Проект» — optional project FK. Used to filter
  // purchase orders by project across the list view.
  projectId             String? @map("project_id") @db.Uuid
  // moysklad-parity «Договор» — optional contract FK. Counterparty
  // contract under which this PO is placed.
  contractId            String? @map("contract_id") @db.Uuid
  // moysklad «Статус» — account-defined custom status (State row,
  // entityType="purchaseorder"). Orthogonal to the FSM `state` + «Проведено»:
  // the pill shows a grey «Статус» until the admin creates statuses. SetNull
  // so deleting a status just unlinks it (mirror CustomerOrder.statusId).
  statusId              String? @map("status_id") @db.Uuid

  // Moment + lifecycle
  moment                DateTime  @default(now()) @db.Timestamptz()
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()
  applicable            Boolean   @default(false)
  state                 String    @default("draft") @db.VarChar(30)
  postedAt              DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor         BigInt @default(0) @map("sum_minor")
  vatSumMinor      BigInt @default(0) @map("vat_sum_minor")
  payedSumMinor    BigInt @default(0) @map("payed_sum_minor")
  invoicedSumMinor BigInt @default(0) @map("invoiced_sum_minor")
  receivedSumMinor BigInt @default(0) @map("received_sum_minor") // aggregate of Supply sums
  // shippedSum on a PurchaseOrder = how much the supplier reports having
  // shipped (mirrors of receivedSumMinor on our side, but sourced from the
  // supplier's notification, not our supply receipts). Often blank in UZ.
  shippedSumMinor  BigInt @default(0) @map("shipped_sum_minor")
  // waitSum — value of pending PaymentOut operations (we've committed
  // to pay but haven't actually paid yet). Drives the "Ожидание" column
  // on the supplier-orders list.
  waitSumMinor     BigInt @default(0) @map("wait_sum_minor")

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  // moysklad-parity «Ожидание» — manual flag set via «Поставить в
  // ожидание» / «Снять ожидание» bulk actions. Distinct from the
  // derived waitSumMinor (which counts pending PaymentOut totals);
  // `waiting=true` marks the PO as on-hold pending external action.
  waiting     Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account              Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                Employee?               @relation("PurchaseOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  modifiedBy           Employee?               @relation("PurchaseOrderModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)
  agent                Counterparty            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount         CounterpartyAccount?    @relation("PurchaseOrderAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount  OrganizationAccount?    @relation("PurchaseOrderOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store                Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  project              Project?                @relation("PurchaseOrderProject", fields: [projectId], references: [id], onDelete: SetNull)
  contract             Contract?               @relation("PurchaseOrderContract", fields: [contractId], references: [id], onDelete: SetNull)
  status               State?                  @relation("PurchaseOrderStatus", fields: [statusId], references: [id], onDelete: SetNull)
  positions            PurchaseOrderPosition[]
  invoicesIn           InvoiceIn[]
  paymentOutOperations PaymentOutOperation[]
  supplies             Supply[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, projectId])
  @@index([accountId, contractId])
  @@index([accountId, modifiedById])
  @@map("purchase_orders")
}

/// Position (line item) on a PurchaseOrder. Polymorphic assortment.
model PurchaseOrderPosition {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  accountId       String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  // Tracking qty: ordered vs already received (via Supply links)
  quantity    Decimal @db.Decimal(20, 6)
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(20, 6) // delivered via Supply
  // NB: the position-level `in_transit_qty` column was DROPPED 2026-06-12
  // (migration …_drop_vestigial_in_transit_qty_columns). It was a designed-but-
  // unwired scaffold (no app write anywhere ⇒ permanently DEFAULT 0). The
  // stock-balance report's «Ожидание» derives expected-incoming query-time from
  // (quantity − receivedQty) over active POs, so the stored column was dead.

  // Pricing (tiyin, minor units)
  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  purchaseOrder      PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product            Product?            @relation("ProductPurchaseOrderPositions", fields: [productId], references: [id], onDelete: Restrict)
  invoiceInPositions InvoiceInPosition[] @relation("InvoiceInFromPurchaseOrderPosition")
  supplyPositions    SupplyPosition[]    @relation("SupplyFromPurchaseOrderPosition")

  @@index([purchaseOrderId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@map("purchase_order_positions")
}

// =========================================================================
// Sprint 3.4b — PaymentIn (Входящий платёж)
// =========================================================================

/// Входящий платёж — inbound payment (customer pays us).
/// FSM: draft → posted (money in, invoices allocated) → draft (unpost)
///      draft|posted → cancelled
///
/// Optional allocations via PaymentInOperation link a single payment to one
/// or more InvoiceOut documents. Post triggers:
///   - InvoiceOut.payedSumMinor += allocation
///   - InvoiceOut auto-transition to partially_paid or paid
///   - (future: money ledger +sum on organizationAccount, -sum on agent balance)
model PaymentIn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "ПП-2026-00001"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // payer counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  salesChannelId        String? @map("sales_channel_id") @db.Uuid
  // moysklad parity — Договор / Проект (money doc has counterparty).
  contractId            String? @map("contract_id") @db.Uuid
  projectId             String? @map("project_id") @db.Uuid

  // Moment + lifecycle
  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor    BigInt @default(0) @map("sum_minor")
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Purpose + metadata
  paymentPurpose String?   @map("payment_purpose") @db.VarChar(500)
  incomingDate   DateTime? @map("incoming_date") @db.Timestamptz()
  incomingNumber String?   @map("incoming_number") @db.VarChar(50)
  description    String?
  shared         Boolean   @default(false)
  printed        Boolean   @default(false)
  published      Boolean   @default(false)
  attributes     Json?     @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("PaymentInOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount? @relation("PaymentInAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation("PaymentInOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  salesChannel        SalesChannel?        @relation("PaymentInSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract            Contract?            @relation("PaymentInContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?             @relation("PaymentInProject", fields: [projectId], references: [id], onDelete: SetNull)
  operations          PaymentInOperation[]
  bankStatementRows   BankStatementRow[]
  facturesOut         FactureOut[]         @relation("FactureOutPaymentIn")
  /// Faza 19 (`INT-02`) — Payme/Click capture'i shu hujjatni tug'dirgan bo'lsa.
  gatewayTxs          PaymentGatewayTx[]   @relation("PaymentGatewayTxPaymentIn")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("payments_in")
}

/// Allocation of a PaymentIn to a specific document (InvoiceOut for now,
/// CustomerOrder in a future sprint). Each operation row = one allocation.
model PaymentInOperation {
  id          String @id @default(uuid()) @db.Uuid
  paymentInId String @map("payment_in_id") @db.Uuid
  accountId   String @map("account_id") @db.Uuid

  // Target document (invoice-out OR customer-order; moysklad pays both).
  targetKind      String  @default("invoiceout") @map("target_kind") @db.VarChar(20)
  invoiceOutId    String? @map("invoice_out_id") @db.Uuid
  customerOrderId String? @map("customer_order_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")

  paymentIn     PaymentIn      @relation(fields: [paymentInId], references: [id], onDelete: Cascade)
  invoiceOut    InvoiceOut?    @relation(fields: [invoiceOutId], references: [id], onDelete: SetNull)
  customerOrder CustomerOrder? @relation("PaymentInOpCustomerOrder", fields: [customerOrderId], references: [id], onDelete: SetNull)

  @@index([paymentInId])
  @@index([accountId, invoiceOutId])
  @@index([accountId, customerOrderId])
  @@map("payment_in_operations")
}

// =========================================================================
// Sprint 4.3 — PaymentOut (Исходящий платёж) — purchase-side mirror
// =========================================================================

/// Исходящий платёж — PaymentOut (outbound payment to supplier).
/// FSM: draft → posted (applicable=true, invoices/orders allocated) → draft
///      draft|posted → cancelled
///
/// Unlike PaymentIn (which allocates only to InvoiceOut), PaymentOut allocates
/// polymorphically to InvoiceIn *or* directly to PurchaseOrder (advance
/// payment against a purchase order before the supplier has issued the
/// invoice). Post triggers:
///   - If targetKind=invoicein: InvoiceIn.payedSumMinor += amount; InvoiceIn
///     auto-transitions partially_paid / paid; InvoiceIn then cascades to
///     PO.payedSumMinor if linked.
///   - If targetKind=purchaseorder: PO.payedSumMinor += amount directly.
///
/// (future: money ledger -sum on organizationAccount, +sum on counterparty
/// outstanding balance)
model PaymentOut {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "ПР-2026-00001" (Платёж Расход)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // payee counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  salesChannelId        String? @map("sales_channel_id") @db.Uuid
  // moysklad parity — Договор / Проект (money doc has counterparty).
  contractId            String? @map("contract_id") @db.Uuid
  projectId             String? @map("project_id") @db.Uuid
  expenseItem           String? @map("expense_item") @db.VarChar(100)

  // Moment + lifecycle
  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor    BigInt @default(0) @map("sum_minor")
  vatSumMinor BigInt @default(0) @map("vat_sum_minor")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Purpose + metadata
  paymentPurpose String? @map("payment_purpose") @db.VarChar(500)
  description    String?
  shared         Boolean @default(false)
  printed        Boolean @default(false)
  published      Boolean @default(false)
  attributes     Json?   @default("{}")
  noClosingDocs  Boolean @default(false) @map("no_closing_docs")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?             @relation("PaymentOutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount?  @relation("PaymentOutAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount?  @relation("PaymentOutOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  salesChannel        SalesChannel?         @relation("PaymentOutSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract            Contract?             @relation("PaymentOutContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?              @relation("PaymentOutProject", fields: [projectId], references: [id], onDelete: SetNull)
  operations          PaymentOutOperation[]
  bankStatementRows   BankStatementRow[]
  facturesIn          FactureIn[]           @relation("FactureInPaymentOut")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("payments_out")
}

/// Allocation of a PaymentOut to a specific document. Polymorphic:
/// `targetKind` = "invoicein" | "purchaseorder". Exactly one of
/// `invoiceInId` / `purchaseOrderId` is set per row.
model PaymentOutOperation {
  id           String @id @default(uuid()) @db.Uuid
  paymentOutId String @map("payment_out_id") @db.Uuid
  accountId    String @map("account_id") @db.Uuid

  targetKind      String  @default("invoicein") @map("target_kind") @db.VarChar(20)
  invoiceInId     String? @map("invoice_in_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")

  paymentOut    PaymentOut     @relation(fields: [paymentOutId], references: [id], onDelete: Cascade)
  invoiceIn     InvoiceIn?     @relation(fields: [invoiceInId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([paymentOutId])
  @@index([accountId, invoiceInId])
  @@index([accountId, purchaseOrderId])
  @@map("payment_out_operations")
}

// =========================================================================
// Sprint 3.2 — Demand (Отгрузка) + Stock ledger
// =========================================================================

/// Отгрузка — Demand (outbound shipment of goods).
/// FSM: draft → posted (applicable=true, stock deducted)
///      posted → draft (unpost: reverses stock)
///      posted → cancelled
///      draft → (soft-deleted)
/// Linked to CustomerOrder (optional) — posting updates CO.shippedSumMinor
/// and may auto-transition CO to partially_shipped / fully_shipped.
model Demand {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // visible number, e.g. "ОТ-2026-00001"
  // Internal code (separate from `name` which is the visible number).
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  // External system sync key (1C, e-commerce). Immutable once set.
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String    @map("agent_id") @db.Uuid
  agentAccountId        String?   @map("agent_account_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  organizationAccountId String?   @map("organization_account_id") @db.Uuid
  storeId               String    @map("store_id") @db.Uuid
  customerOrderId       String?   @map("customer_order_id") @db.Uuid // optional link back to CO
  salesChannelId        String?   @map("sales_channel_id") @db.Uuid
  /// Optional contract scoping the shipment — moysklad's "Договор" field.
  contractId            String?   @map("contract_id") @db.Uuid
  /// Optional project tagging the shipment — moysklad's "Проект" field.
  projectId             String?   @map("project_id") @db.Uuid
  /// moysklad «Статус» — account-defined custom status (State row,
  /// entityType="demand"), mirroring Supply.statusId. Orthogonal to the FSM
  /// `state` (draft/posted/cancelled) + «Проведено»; onDelete SetNull unlinks.
  statusId              String?   @map("status_id") @db.Uuid
  /// «План. дата отгрузки» — planned shipment date (moysklad demand field;
  /// mirrors InternalOrder/CustomerOrder.deliveryPlannedMoment).
  deliveryPlannedMoment DateTime? @map("delivery_planned_moment") @db.Timestamptz()
  /// «План. дата оплаты» — planned payment date (DOM-grounded field-role label
  /// in dom/08-edit-default.html; mirrors InvoiceOut/InvoiceIn.paymentPlannedMoment).
  paymentPlannedMoment  DateTime? @map("payment_planned_moment") @db.Timestamptz()
  // moysklad «Другие поля» — shipping / logistics block (all optional).
  consignorId           String?   @map("consignor_id") @db.Uuid // Грузоотправитель
  consigneeId           String?   @map("consignee_id") @db.Uuid // Грузополучатель
  carrierId             String?   @map("carrier_id") @db.Uuid // Перевозчик
  cargoName             String?   @map("cargo_name") @db.VarChar(255) // Наименование груза
  shipperInstructions   String?   @map("shipper_instructions") // Указания грузоотправителя
  transportFacility     String?   @map("transport_facility") @db.VarChar(255) // Транспортное средство
  carNumber             String?   @map("car_number") @db.VarChar(50) // Номер автомобиля
  placesCount           Int?      @map("places_count") // Всего мест
  shippingDocNo         String?   @map("shipping_doc_no") @db.VarChar(100) // Перевозочный документ №
  shippingDocDate       DateTime? @map("shipping_doc_date") @db.Timestamptz() // … от (дата)
  stateContractId       String?   @map("state_contract_id") @db.VarChar(100) // ИД гос. контракта

  // Moment + lifecycle
  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false) // провéдено
  state      String    @default("draft") @db.VarChar(30) // draft | posted | cancelled
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor             BigInt @default(0) @map("sum_minor")
  vatSumMinor          BigInt @default(0) @map("vat_sum_minor")
  // Self-cost aggregate. Populated by FIFO at post time (Sprint 3.4+). Null until then.
  costSumMinor         BigInt @default(0) @map("cost_sum_minor")
  payedSumMinor        BigInt @default(0) @map("payed_sum_minor")
  // Overhead — additional cost distributed across line items (delivery,
  // packaging, customs). Stored at the document level; line cost computed
  // by the FIFO writer using a chosen distribution method.
  overheadSumMinor     BigInt @default(0) @map("overhead_sum_minor")
  overheadDistribution String @default("WEIGHT") @map("overhead_distribution") @db.VarChar(20)
  // Overhead currency — usually same as document currency, but moysklad
  // allows declaring overhead in a different currency (rare).
  overheadCurrency     String @default("UZS") @map("overhead_currency") @db.VarChar(3)

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Shipment delivery address (denormalised at document time — counterparty
  // address may change later, but the demand reflects what was shipped).
  shipmentAddress     String? @map("shipment_address") @db.VarChar(500)
  shipmentAddressFull Json?   @map("shipment_address_full")

  // Metadata
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("DemandOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount? @relation(fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount? @relation(fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerOrder       CustomerOrder?       @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  salesChannel        SalesChannel?        @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract            Contract?            @relation("DemandContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?             @relation("DemandProject", fields: [projectId], references: [id], onDelete: SetNull)
  status              State?               @relation("DemandStatus", fields: [statusId], references: [id], onDelete: SetNull)
  consignor           Counterparty?        @relation("DemandConsignor", fields: [consignorId], references: [id], onDelete: SetNull)
  consignee           Counterparty?        @relation("DemandConsignee", fields: [consigneeId], references: [id], onDelete: SetNull)
  carrier             Counterparty?        @relation("DemandCarrier", fields: [carrierId], references: [id], onDelete: SetNull)
  positions           DemandPosition[]
  salesReturns        SalesReturn[]
  moves               Move[]               @relation("MoveDemand")
  factureOuts         FactureOut[]         @relation("FactureOutDemand")
  factureOutLinks     FactureOutDemand[]   @relation("FactureOutDemandLink")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, storeId, applicable])
  @@index([accountId, customerOrderId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@index([accountId, consignorId])
  @@index([accountId, consigneeId])
  @@index([accountId, carrierId])
  // Trigram GIN (perf audit 2026-07-23) — serves the ILIKE '%term%' list search
  // on name/description (btree can't; leading wildcard). See migration
  // 20260723_trgm_search_indexes. Needs the pg_trgm extension.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "demands_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "demands_description_trgm_idx")
  // DB-08 (faza 25) — statusId was the one FK left unindexed here while its
  // siblings (contractId/projectId) were covered; see CustomerOrder for why
  // single-column.
  @@index([statusId])
  @@map("demands")
}

/// Demand line position. Polymorphic assortment (like CustomerOrderPosition).
/// FIFO consumption ledger — records which SupplyPosition lots were
/// drawn down to fulfil each DemandPosition at post time. Lets unpost
/// reverse the decrement exactly (instead of guessing FIFO order on
/// reversal, which would be wrong if other Demands consumed from the
/// same lots in the meantime).
///
/// Also acts as the audit trail for cost-of-goods-sold: sum(quantity ×
/// unit cost) across this ledger for a Demand = Demand.costSumMinor.
model DemandPositionCostConsumption {
  id               String   @id @default(uuid()) @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  demandPositionId String   @map("demand_position_id") @db.Uuid
  supplyPositionId String   @map("supply_position_id") @db.Uuid
  /// Quantity consumed from this lot (in the demand's units).
  quantity         Decimal  @db.Decimal(20, 6)
  /// Per-unit cost of the supply lot at consumption time, in tiyin. Frozen
  /// at consumption — even if Supply is later edited (rare; usually locked),
  /// the Demand's COGS stays consistent.
  unitCostMinor    BigInt   @map("unit_cost_minor")
  /// Pre-computed line cost = quantity × unitCostMinor, in tiyin.
  /// Persisted (not derived) so reports SUM() on this column directly
  /// instead of pulling Decimal × BigInt math into application code.
  lineCostMinor    BigInt   @map("line_cost_minor")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  demandPosition DemandPosition @relation(fields: [demandPositionId], references: [id], onDelete: Cascade)
  supplyPosition SupplyPosition @relation(fields: [supplyPositionId], references: [id], onDelete: Restrict)

  @@index([demandPositionId])
  @@index([supplyPositionId])
  @@index([accountId])
  @@map("demand_position_cost_consumptions")
}

model DemandPosition {
  id        String @id @default(uuid()) @db.Uuid
  demandId  String @map("demand_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid // denormalized for scoped queries

  // Line order
  position Int

  // What's being shipped
  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  // Back-link to CustomerOrderPosition (when demand is derived from CO)
  customerOrderPositionId String? @map("customer_order_position_id") @db.Uuid

  // Quantities
  quantity Decimal @db.Decimal(20, 6)

  // Pricing (tiyin)
  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  // Cost (per unit, tiyin). Populated at post time from the per-store weighted
  // average (Faza 18a; the FIFO walk it originally came from is retired).
  costMinor BigInt? @map("cost_minor")

  // Exact line cost that left the store at post time, tiyin (Faza Q4 / STK-08).
  // `costMinor × quantity` cannot express it when the shipment EMPTIES the
  // store: the line then takes the whole Stock.costBalanceMinor, which is
  // generally not a multiple of the rounded per-unit. Nullable on purpose —
  // rows posted before Faza Q4 keep NULL and reverse through the old
  // per-unit × qty arithmetic, bit-for-bit as before.
  baseCostMinor BigInt? @map("base_cost_minor")

  // moysklad «Ячейка» — address-storage bin the goods leave FROM. cellId drives
  // per-cell stock (StockByCell) on post; `cell` = denormalized «Зона / Ячейка»
  // label. Mirrors PurchaseReturnPosition (the other outbound sibling).
  cellId String? @map("cell_id") @db.Uuid
  cell   String? @db.VarChar(255)

  demand                Demand                          @relation(fields: [demandId], references: [id], onDelete: Cascade)
  product               Product?                        @relation("ProductDemandPositions", fields: [productId], references: [id], onDelete: Restrict)
  customerOrderPosition CustomerOrderPosition?          @relation("DemandFromCustomerOrderPosition", fields: [customerOrderPositionId], references: [id], onDelete: SetNull)
  salesReturnPositions  SalesReturnPosition[]           @relation("SalesReturnFromDemandPosition")
  costConsumptions      DemandPositionCostConsumption[]
  cellRef               StoreCell?                      @relation("DemandPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([demandId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([accountId, customerOrderPositionId])
  @@index([cellId])
  @@map("demand_positions")
}

// =========================================================================
// Sprint 5.1 — SalesReturn (Возврат покупателя)
// =========================================================================

/// Возврат покупателя — SalesReturn (goods coming back from customer).
/// FSM: draft → posted (stock +, Demand/CO revert, credit to counterparty)
///      posted → draft (unpost: reverse stock + revert aggregates)
///      posted → cancelled (same as unpost + state=cancelled)
///      draft → (soft-deleted)
///
/// Mirror of Demand shape but INBOUND stock side (goods re-enter inventory).
/// Optional link to the original Demand (preferred for traceability) and its
/// CustomerOrder. Posting cascades:
///   - Stock ledger: +quantity (docType='salesreturn')
///   - Demand.positions[].shippedQty decrement via
///     CustomerOrderService.applyShipment(tx, ..., direction='revert')
///   - CO.shippedSumMinor decrement + potential state rollback
///     (fully_shipped → partially_shipped / confirmed)
///
/// Refund money is handled by a separate PaymentOut or PrepaymentReturn
/// (Sprint 6) — this doc only registers the goods return.
model SalesReturn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "ВП-2026-00001" (Возврат Покупателя)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // customer returning goods
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  storeId               String  @map("store_id") @db.Uuid // receiving warehouse
  salesChannelId        String? @map("sales_channel_id") @db.Uuid
  /// Optional contract scoping the return — moysklad's "Договор" field.
  contractId            String? @map("contract_id") @db.Uuid
  /// Optional project tagging the return — moysklad's "Проект" field.
  projectId             String? @map("project_id") @db.Uuid
  demandId              String? @map("demand_id") @db.Uuid // original shipment (optional)
  customerOrderId       String? @map("customer_order_id") @db.Uuid // original CO (optional)
  /// G3 (2026-08-24) — «manba hujjat» kassa cheki bo'lgan holat. POS sotuvi
  /// `Demand` YARATMAYDI (u `RetailSale`), shuning uchun `demandId` bu yo'lni
  /// ifodalay olmaydi. Faqat ASL chekka (mirror EMAS) bog'lanadi; qaytarish
  /// cap'i shu chek bo'yicha hisoblanadi: sotilgan − POS mirror qaytarishlari
  /// − shu chekka bog'langan avvalgi (bekor qilinmagan) vozvratlar.
  retailSaleId          String? @map("retail_sale_id") @db.Uuid

  /// moysklad «Статус» — account-defined custom status (State row,
  /// entityType="salesreturn"), mirroring PurchaseReturn.statusId. Orthogonal
  /// to the FSM `state` (draft/posted/cancelled) + «Проведено»; onDelete
  /// SetNull so deleting a status just unlinks the returns that used it.
  statusId String? @map("status_id") @db.Uuid

  // Moment + lifecycle
  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30) // draft | posted | cancelled
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor      BigInt @default(0) @map("sum_minor")
  vatSumMinor   BigInt @default(0) @map("vat_sum_minor")
  payedSumMinor BigInt @default(0) @map("payed_sum_minor")

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Return reason (free-form): "Mahsulot buzilgan" / "O'lchami to'g'ri kelmadi" / ...
  reason      String?
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account             Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?             @relation("SalesReturnOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount?  @relation("SalesReturnAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount?  @relation("SalesReturnOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  salesChannel        SalesChannel?         @relation("SalesReturnSalesChannel", fields: [salesChannelId], references: [id], onDelete: SetNull)
  contract            Contract?             @relation("SalesReturnContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?              @relation("SalesReturnProject", fields: [projectId], references: [id], onDelete: SetNull)
  demand              Demand?               @relation(fields: [demandId], references: [id], onDelete: SetNull)
  customerOrder       CustomerOrder?        @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  status              State?                @relation("SalesReturnStatus", fields: [statusId], references: [id], onDelete: SetNull)
  /// G3 — manba kassa cheki (`retailSaleId`).
  retailSale          RetailSale?           @relation("SalesReturnFromRetailSale", fields: [retailSaleId], references: [id], onDelete: SetNull)
  positions           SalesReturnPosition[]
  /// G1 — kassadan qaytarilgan pul hujjatlari (`kind='return_payout'`).
  drawerPayouts       RetailDrawerCashOut[] @relation("RetailDrawerOutSalesReturn")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, storeId, applicable])
  @@index([accountId, demandId])
  @@index([accountId, customerOrderId])
  // G3 — chek bo'yicha qaytarish cap'i (har qabul oqimida o'qiladi).
  @@index([accountId, retailSaleId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, salesChannelId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("sales_returns")
}

/// Position (line item) on a SalesReturn.
model SalesReturnPosition {
  id            String @id @default(uuid()) @db.Uuid
  salesReturnId String @map("sales_return_id") @db.Uuid
  accountId     String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  // Back-link to original Demand position (for traceability + return-qty cap)
  demandPositionId String? @map("demand_position_id") @db.Uuid

  quantity Decimal @db.Decimal(20, 6)

  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  // Per-unit WEIGHTED-AVERAGE cost frozen at post-time (tiyin). The customer
  // return re-enters inventory at the store's carrying cost — NOT the sale
  // price — so a margin doesn't inflate Stock.costBalanceMinor. Mirrors
  // LossPosition.costMinor; post() freezes it, unpost()/cancel() reverse the
  // exact same value (cost zero-sum). NULL on a draft (cost basis unknown
  // until posted).
  costMinor BigInt? @map("cost_minor")

  // moysklad «Себестоимость ГТД» / «Страна» — customs block on inventory-
  // inbound return positions (live-confirmed on Возврат покупателя,
  // PARITY-AUDIT §45; mirrors §41 SupplyPosition). РНПТ/Маркировка NOT here.
  gtdNumber   String? @map("gtd_number") @db.VarChar(255)
  gtdSumMinor BigInt? @map("gtd_sum_minor")
  countryId   String? @map("country_id") @db.Uuid

  // moysklad «Ячейка» — address-storage bin the returned goods are placed
  // INTO. cellId drives per-cell stock (StockByCell) on post; `cell` =
  // denormalized «Зона / Ячейка» label. Mirrors PurchaseReturnPosition /
  // SupplyPosition (the inbound-doc siblings).
  cellId String? @map("cell_id") @db.Uuid
  cell   String? @db.VarChar(255)

  /// K5 — mijozdan QAYTGAN bo'lak («BLK-000041:180» yoki «?:180»). Post
  /// paytida bo'lak reyestrga qaytadi: yorlig'i tanilsa AYNAN o'sha qator
  /// `consumed` dan `active` ga o'tadi (`sourcePieceId` tarixi va mijozdagi
  /// yorliq raqami saqlanadi), tanilmasa yangi qator + yangi yorliq.
  pieceEntry String? @map("piece_entry")

  salesReturn    SalesReturn     @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product        Product?        @relation("ProductSalesReturnPositions", fields: [productId], references: [id], onDelete: Restrict)
  demandPosition DemandPosition? @relation("SalesReturnFromDemandPosition", fields: [demandPositionId], references: [id], onDelete: SetNull)
  country        Country?        @relation("SalesReturnPositionCountry", fields: [countryId], references: [id], onDelete: SetNull)
  cellRef        StoreCell?      @relation("SalesReturnPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([salesReturnId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([accountId, demandPositionId])
  @@index([countryId])
  @@index([cellId])
  @@map("sales_return_positions")
}

// =========================================================================
// Sprint 5.2 — PurchaseReturn (Возврат поставщику)
// =========================================================================

/// Возврат поставщику — PurchaseReturn (goods going back to supplier).
/// FSM: draft → posted (stock -, Supply/PO revert, debit to supplier)
///      posted → draft (unpost)
///      posted → cancelled
///      draft → (soft-deleted)
///
/// Mirror of Supply but OUTBOUND stock side (goods leave our inventory back
/// to supplier). Optional link to the original Supply. Posting cascades:
///   - Stock ledger: -quantity (docType='purchasereturn')
///   - If linked Supply has FIFO lot: mark the returned-qty portion
///     (Sprint 5+ refines this with proper FIFO reversal)
///   - PurchaseOrder.receivedSum decrement if Supply was linked to PO
model PurchaseReturn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(100) // "ВТ-2026-00001" (Возврат Т[поставщику])
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  // References
  agentId               String  @map("agent_id") @db.Uuid // supplier receiving goods back
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  storeId               String  @map("store_id") @db.Uuid // source warehouse
  supplyId              String? @map("supply_id") @db.Uuid // original receipt (optional)
  /// Optional contract scoping the return — moysklad's "Договор" field.
  contractId            String? @map("contract_id") @db.Uuid
  /// Optional project tagging the return — moysklad's "Проект" field.
  projectId             String? @map("project_id") @db.Uuid

  // Moment + lifecycle
  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30) // draft | posted | cancelled
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor      BigInt @default(0) @map("sum_minor")
  vatSumMinor   BigInt @default(0) @map("vat_sum_minor")
  payedSumMinor BigInt @default(0) @map("payed_sum_minor")

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Return reason (free-form): "Sifat yomon" / "Kam jo'natilgan" / ...
  reason      String?
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)
  /// moysklad «Статус» — account-defined custom status (State row,
  /// entityType="purchasereturn"), mirroring Supply.statusId. Orthogonal to the
  /// FSM `state` column + the «Проведено» flag; the toolbar «Статус» menu sets
  /// it on the selected returns. SetNull so deleting a status just unlinks.
  statusId  String?   @map("status_id") @db.Uuid

  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?                @relation("PurchaseReturnOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent               Counterparty             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount        CounterpartyAccount?     @relation("PurchaseReturnAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount?     @relation("PurchaseReturnOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supply              Supply?                  @relation(fields: [supplyId], references: [id], onDelete: SetNull)
  contract            Contract?                @relation("PurchaseReturnContract", fields: [contractId], references: [id], onDelete: SetNull)
  project             Project?                 @relation("PurchaseReturnProject", fields: [projectId], references: [id], onDelete: SetNull)
  status              State?                   @relation("PurchaseReturnStatus", fields: [statusId], references: [id], onDelete: SetNull)
  positions           PurchaseReturnPosition[]
  facturesOut         FactureOut[]             @relation("FactureOutPurchaseReturn")

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, storeId, applicable])
  @@index([accountId, supplyId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("purchase_returns")
}

/// Position (line item) on a PurchaseReturn.
model PurchaseReturnPosition {
  id               String @id @default(uuid()) @db.Uuid
  purchaseReturnId String @map("purchase_return_id") @db.Uuid
  accountId        String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  // Back-link to original Supply position
  supplyPositionId String? @map("supply_position_id") @db.Uuid

  quantity Decimal @db.Decimal(20, 6)

  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  // Per-unit WEIGHTED-AVERAGE cost frozen at post-time (tiyin). The supplier
  // return removes goods at the store's carrying cost — NOT the document
  // price — so Stock.costBalanceMinor stays consistent. Mirrors
  // LossPosition.costMinor; post() freezes it, unpost()/cancel() reverse the
  // exact same value (cost zero-sum). NULL on a draft.
  costMinor BigInt? @map("cost_minor")

  // moysklad «Ячейка» — address-storage bin the goods leave FROM. cellId drives
  // per-cell stock (StockByCell) on post; `cell` = denormalized «Зона / Ячейка»
  // label. Mirrors SupplyPosition (the Приёмка sibling).
  cellId String? @map("cell_id") @db.Uuid
  cell   String? @db.VarChar(255)

  purchaseReturn PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product?        @relation("ProductPurchaseReturnPositions", fields: [productId], references: [id], onDelete: Restrict)
  supplyPosition SupplyPosition? @relation("PurchaseReturnFromSupplyPosition", fields: [supplyPositionId], references: [id], onDelete: SetNull)
  cellRef        StoreCell?      @relation("PurchaseReturnPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([purchaseReturnId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([accountId, supplyPositionId])
  @@index([cellId])
  @@map("purchase_return_positions")
}

// =========================================================================
// Sprint 5.3 — Stock movements: Move / Loss / Enter / Inventory
// =========================================================================

/// Перемещение — Move (stock transfer between stores).
/// FSM: draft → posted (−qty on sourceStore, +qty on destinationStore)
///      posted → draft (unpost), posted → cancelled
///      draft → (soft-deleted)
/// No agent — internal operation. Requires two stores of the same account.
model Move {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid

  name         String  @db.VarChar(100) // "ПЕ-YYYY-NNNNN"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid
  groupId      String? @map("group_id") @db.Uuid
  // moysklad-parity «Кто изменил» — author of last update. SetNull on user
  // deletion to preserve attribution. Mirrors PurchaseOrder.modifiedById.
  modifiedById String? @map("modified_by_id") @db.Uuid

  organizationId     String  @map("organization_id") @db.Uuid
  sourceStoreId      String  @map("source_store_id") @db.Uuid
  destinationStoreId String  @map("destination_store_id") @db.Uuid
  // Optional cross-references — moysklad lets a Move document the origin
  // (CustomerOrder / Demand / Supply / InternalOrder) for audit traceability.
  customerOrderId    String? @map("customer_order_id") @db.Uuid
  demandId           String? @map("demand_id") @db.Uuid
  supplyId           String? @map("supply_id") @db.Uuid
  // moysklad parity — Проект (internal stock doc: no counterparty → no Договор).
  projectId          String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30) // draft | posted | cancelled
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Aggregate cost of moved goods (sum of position costs)
  sumMinor             BigInt @default(0) @map("sum_minor")
  // Overhead distributed across positions (e.g. inter-warehouse delivery
  // truck cost). Optional.
  overheadSumMinor     BigInt @default(0) @map("overhead_sum_minor")
  overheadDistribution String @default("WEIGHT") @map("overhead_distribution") @db.VarChar(20)
  overheadCurrency     String @default("UZS") @map("overhead_currency") @db.VarChar(3)

  // Currency + rate. Stock-internal docs default to UZS at rate=1 since the
  // cost basis is preserved per-position; included for moysklad parity.
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner            Employee?      @relation("MoveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group            Group?         @relation("MoveGroup", fields: [groupId], references: [id], onDelete: SetNull)
  modifiedBy       Employee?      @relation("MoveModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceStore      Store          @relation("MoveSourceStore", fields: [sourceStoreId], references: [id], onDelete: Restrict)
  destinationStore Store          @relation("MoveDestinationStore", fields: [destinationStoreId], references: [id], onDelete: Restrict)
  customerOrder    CustomerOrder? @relation("MoveCustomerOrder", fields: [customerOrderId], references: [id], onDelete: SetNull)
  demand           Demand?        @relation("MoveDemand", fields: [demandId], references: [id], onDelete: SetNull)
  supply           Supply?        @relation("MoveSupply", fields: [supplyId], references: [id], onDelete: SetNull)
  project          Project?       @relation("MoveProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions        MovePosition[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, sourceStoreId])
  @@index([accountId, destinationStoreId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, projectId])
  @@index([accountId, modifiedById])
  @@map("moves")
}

model MovePosition {
  id        String @id @default(uuid()) @db.Uuid
  moveId    String @map("move_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  quantity Decimal @db.Decimal(20, 6)

  // Cost (per unit) at moment of transfer — carried across stores for
  // accurate cost basis at destination (preserves FIFO cost history).
  costMinor BigInt? @map("cost_minor")

  /// Faza 34 / STK-08 — the EXACT line cost that left the source store at
  /// post time (tiyin). `costMinor × quantity` cannot express it: when a
  /// transfer empties the source, the line must take the whole remaining
  /// costBalanceMinor, which is generally NOT a multiple of the rounded
  /// per-unit. unpost()/cancel() reverse from THIS value, so the cycle is
  /// zero-sum by construction. NULL on rows posted before Faza 34 (and on
  /// drafts) — readers fall back to costMinor × quantity, i.e. exactly the
  /// pre-Faza-34 behaviour, so legacy documents still reverse bit-for-bit.
  baseCostMinor BigInt? @map("base_cost_minor")

  move    Move     @relation(fields: [moveId], references: [id], onDelete: Cascade)
  product Product? @relation("ProductMovePositions", fields: [productId], references: [id], onDelete: Restrict)

  @@index([moveId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@map("move_positions")
}

/// Списание — Loss (stock writeoff with reason).
/// FSM: draft → posted (−qty on store), draft → (soft-deleted)
///      posted → cancelled (re-adds stock)
model Loss {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100) // "СП-YYYY-NNNNN"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  // moysklad lets you tag a Loss with the account-level "expense item"
  // (e.g. "Damages", "Theft", "Promotional samples") for P&L roll-up.
  // Free-form string here; the values are managed in account settings.
  expenseItem    String? @map("expense_item") @db.VarChar(100)
  // moysklad parity — Проект (internal stock doc: no counterparty → no Договор).
  projectId      String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Aggregate cost of written-off goods
  sumMinor BigInt @default(0) @map("sum_minor")

  // Currency + rate (consistent with other documents).
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Loss reason: damaged, expired, theft, quality, other
  reason      String  @default("other") @db.VarChar(30)
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?      @relation("LossOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?         @relation("LossGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  project      Project?       @relation("LossProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions    LossPosition[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, storeId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, projectId])
  @@map("losses")
}

model LossPosition {
  id        String @id @default(uuid()) @db.Uuid
  lossId    String @map("loss_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  quantity Decimal @db.Decimal(20, 6)

  costMinor BigInt? @map("cost_minor")

  // moysklad «Причина списания» — per-position free-text write-off reason
  // (mirror EnterPosition.reason). The document-level Loss.reason enum is the
  // legacy single-reason; moysklad models the write-off reason PER LINE as text.
  reason String? @db.VarChar(255)
  // moysklad «Ячейка» — warehouse bin (address storage). `cellId` is the picked
  // StoreCell (validated); `cell` keeps a denormalized «Зона / Ячейка» label for
  // display/list/print + legacy free-text rows. post() decrements per-cell stock
  // (StockByCell) for the picked cell.
  cellId String? @map("cell_id") @db.Uuid
  cell   String? @db.VarChar(255)

  loss    Loss       @relation(fields: [lossId], references: [id], onDelete: Cascade)
  product Product?   @relation("ProductLossPositions", fields: [productId], references: [id], onDelete: Restrict)
  cellRef StoreCell? @relation("LossPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([lossId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([cellId])
  @@map("loss_positions")
}

/// Оприходование — Enter (ad-hoc stock entry).
/// FSM: draft → posted (+qty on store) → draft (unpost) / cancelled
///      draft → (soft-deleted)
/// Used for: initial stock, found goods, gifts, corrections.
model Enter {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  ownerId      String? @map("owner_id") @db.Uuid
  groupId      String? @map("group_id") @db.Uuid
  // moysklad-parity «Кто изменил» — author of last update. SetNull on user
  // deletion to preserve attribution. Mirrors Move.modifiedById.
  modifiedById String? @map("modified_by_id") @db.Uuid

  name         String  @db.VarChar(100) // "ОП-YYYY-NNNNN"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  // moysklad parity — Проект (internal stock doc: no counterparty → no Договор).
  projectId      String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor             BigInt @default(0) @map("sum_minor")
  // Distributed delivery / acquisition cost across positions.
  overheadSumMinor     BigInt @default(0) @map("overhead_sum_minor")
  overheadDistribution String @default("WEIGHT") @map("overhead_distribution") @db.VarChar(20)
  overheadCurrency     String @default("UZS") @map("overhead_currency") @db.VarChar(3)

  // Currency + rate (consistent with other documents).
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Entry reason: initial, found, gift, correction, other
  reason      String  @default("other") @db.VarChar(30)
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)

  published  Boolean @default(false)
  attributes Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?       @relation("EnterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?          @relation("EnterGroup", fields: [groupId], references: [id], onDelete: SetNull)
  modifiedBy   Employee?       @relation("EnterModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  project      Project?        @relation("EnterProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions    EnterPosition[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, storeId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, projectId])
  @@index([accountId, modifiedById])
  @@map("enters")
}

model EnterPosition {
  id        String @id @default(uuid()) @db.Uuid
  enterId   String @map("enter_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  quantity  Decimal @db.Decimal(20, 6)
  // Cost basis for entered goods (sets FIFO lot cost)
  costMinor BigInt  @map("cost_minor")

  // «Причина оприходования» — moysklad models the entry reason as free text
  // PER POSITION (not a document-level enum). 2026-06-21 parity move: the old
  // document-level Enter.reason enum is deprecated in favour of this.
  reason String? @db.VarChar(255)

  // moysklad «Номер ГТД» / «Сумма ГТД» / «Страна» — import/customs block shown
  // on the #enter create grid (mirror SupplyPosition §41). РНПТ/Маркировка
  // intentionally NOT here — separate marking-system feature (consistent with
  // Supply/Return). Ячейка (bin) needs the unbuilt address-storage model.
  gtdNumber   String? @map("gtd_number") @db.VarChar(255)
  gtdSumMinor BigInt? @map("gtd_sum_minor")
  countryId   String? @map("country_id") @db.Uuid
  // «РНПТ» (goods-batch registration no.) + «Ячейка» (warehouse bin) — free-text
  // per-position fields on the #enter grid. РНПТ here is a plain text field (NOT
  // the full Честный Знак marking system); Ячейка is a free-text cell reference
  // (NOT the validated address-storage picker — that needs a warehouse cell model).
  rnpt        String? @db.VarChar(255)
  // moysklad «Ячейка» — address-storage bin. `cellId` = picked StoreCell (validated);
  // `cell` keeps the denormalized «Зона / Ячейка» label for display + legacy rows.
  // post() increments per-cell stock (StockByCell) for the picked cell.
  cellId      String? @map("cell_id") @db.Uuid
  cell        String? @db.VarChar(255)

  enter   Enter      @relation(fields: [enterId], references: [id], onDelete: Cascade)
  product Product?   @relation("ProductEnterPositions", fields: [productId], references: [id], onDelete: Restrict)
  country Country?   @relation("EnterPositionCountry", fields: [countryId], references: [id], onDelete: SetNull)
  cellRef StoreCell? @relation("EnterPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([enterId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([countryId])
  @@index([cellId])
  @@map("enter_positions")
}

/// Инвентаризация — Inventory (physical recount).
/// FSM: draft → posted (generates delta: over-count → Enter, short-count →
///      Loss — both as separate posted documents referencing this inventory)
///      draft → (soft-deleted)
/// Each position records expected (from Stock) vs actual (counted) quantity.
model Inventory {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100) // "ИН-YYYY-NNNNN"
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  // moysklad parity — Проект (internal stock doc: no counterparty → no Договор).
  projectId      String? @map("project_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  // Sum of (counted_qty × cost) — populated when the recount is finalised.
  // Used to back the "Стоимость" column on the inventory list.
  sumMinor BigInt @default(0) @map("sum_minor")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?           @relation("InventoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?              @relation("InventoryGroup", fields: [groupId], references: [id], onDelete: SetNull)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  project      Project?            @relation("InventoryProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions    InventoryPosition[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, storeId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, projectId])
  @@map("inventories")
}

model InventoryPosition {
  id          String @id @default(uuid()) @db.Uuid
  inventoryId String @map("inventory_id") @db.Uuid
  accountId   String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  // Captured at post time from Stock row
  expectedQty Decimal @map("expected_qty") @db.Decimal(20, 6)
  // Entered by the counter
  actualQty   Decimal @map("actual_qty") @db.Decimal(20, 6)
  // Computed: actualQty - expectedQty (positive = surplus, negative = shortage)
  varianceQty Decimal @map("variance_qty") @db.Decimal(20, 6)

  // Cost per unit used for variance valuation (from current Stock cost basis)
  costMinor BigInt? @map("cost_minor")

  // moysklad «Ячейка» — per-cell recount row (address storage). `cellId` = counted
  // StoreCell (validated via assertCellsInStore); `cell` = denormalized «Зона /
  // Ячейка» label (display survives cell deletion — FK is SetNull). A cell row's
  // expectedQty is snapshot from StockByCell (not Stock) at post time, and its
  // variance delta carries cellId so applyDeltas aligns Stock AND StockByCell.
  // cellId = null keeps the pre-cell store-level behaviour byte-for-byte.
  cellId String? @map("cell_id") @db.Uuid
  cell   String? @db.VarChar(255)

  /// K5 — omborchi SANAGAN bo'lak tarkibi («250x3+BLK-000041:200+?:150»).
  /// Faqat `pieceTracked` tovarlarda to'ldiriladi; post paytida bo'lak reyestri
  /// (`stock_pieces`) shu tarkibga TENGLASHTIRILADI (mutlaq amal — omborchining
  /// ko'zi haqiqat manbai). Σ tarkib === `actualQty` bo'lishi SHART, aks holda
  /// post bo'lgan zahoti reyestr va qoldiq bir-biriga zid bo'lardi.
  pieceEntry String? @map("piece_entry")

  inventory Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product?   @relation("ProductInventoryPositions", fields: [productId], references: [id], onDelete: Restrict)
  cellRef   StoreCell? @relation("InventoryPositionCell", fields: [cellId], references: [id], onDelete: SetNull)

  @@index([inventoryId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([cellId])
  @@map("inventory_positions")
}

/// Append-only stock ledger. Source of truth for all inventory movements.
/// Every posted Demand (and future Supply / Loss / Move) writes one entry per position.
/// The materialized `Stock` row is a read-optimized projection of this ledger.
model StockOperation {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  assortmentKind String @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String @map("assortment_id") @db.Uuid

  // moysklad «Ячейка» — the address-storage cell this movement applied to (null =
  // store-level only). Informational on the ledger; the materialized per-cell
  // balance lives in StockByCell. No relation (append-only ledger, like docPositionId).
  cellId String? @map("cell_id") @db.Uuid

  // Signed delta: positive = inflow (supply / unpost-reversal), negative = outflow (demand posting).
  qtyDelta       Decimal @map("qty_delta") @db.Decimal(20, 6)
  // Signed cost delta (tiyin). Null this sprint (FIFO deferred).
  costDeltaMinor BigInt? @map("cost_delta_minor")

  // Originating document.
  docType       String  @map("doc_type") @db.VarChar(30) // 'demand' | 'demand_unpost' | 'demand_cancel' | 'supply' (future) | ...
  docId         String  @map("doc_id") @db.Uuid
  docPositionId String? @map("doc_position_id") @db.Uuid // back-pointer to position row

  reason      String   @db.VarChar(30) // 'post' | 'unpost' | 'cancel'
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  createdById String?  @map("created_by_id") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([accountId, storeId, assortmentKind, assortmentId])
  @@index([accountId, docType, docId])
  @@index([accountId, occurredAt(sort: Desc)])
  @@map("stock_operations")
}

/// Append-only stock RESERVATION ledger — the soft-hold axis, separate
/// from StockOperation (which is the hard qty-movement axis). A
/// reservation does NOT move `Stock.qty`; it raises `Stock.reservedQty`
/// so available = qty − reservedQty drops for everyone else.
///
/// Round-4 unit 2 (§114) — the first real reservation implementation.
/// CustomerOrder/PurchaseOrder/OnlineOrder all still defer reservation
/// (their schema comments say so); this ledger is the shared primitive
/// they can adopt later. Release reverses the EXACT recorded qtyDelta
/// per (docType,docId) — never recomputed from a BOM that may have
/// changed (the materialsSnapshot exact-reversal discipline).
///
/// Rebuildable: Stock.reservedQty == SUM(qtyDelta) grouped by
/// (store, assortment).
model StockReservation {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  assortmentKind String @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String @map("assortment_id") @db.Uuid

  /// Signed: positive = reserve (hold), negative = release.
  qtyDelta Decimal @map("qty_delta") @db.Decimal(20, 6)

  /// Originating document (extensible — 'production' is the first).
  docType String @map("doc_type") @db.VarChar(30)
  docId   String @map("doc_id") @db.Uuid

  /// 'reserve' | 'release_unpost' | 'release_cancel' | 'release_consume'.
  reason      String   @db.VarChar(30)
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  createdById String?  @map("created_by_id") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([accountId, storeId, assortmentKind, assortmentId])
  @@index([accountId, docType, docId])
  @@index([accountId, occurredAt(sort: Desc)])
  @@map("stock_reservations")
}

/// Materialized stock balance. Dual-written with StockOperation inside the same transaction.
/// Rebuildable from the ledger — SUM(StockOperation.qtyDelta) grouped by (store, assortment).
model Stock {
  accountId      String @map("account_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  assortmentKind String @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String @map("assortment_id") @db.Uuid

  qty              Decimal @default(0) @db.Decimal(20, 6)
  reservedQty      Decimal @default(0) @map("reserved_qty") @db.Decimal(20, 6)
  // NB: the `in_transit_qty` column was DROPPED 2026-06-12 (migration
  // …_drop_vestigial_in_transit_qty_columns). Nothing ever wrote it (every
  // StockService upsert created it as 0, no increment/decrement anywhere) ⇒ it
  // sat at DEFAULT 0 forever, yet getBalances/lockBalances surfaced that
  // permanent 0 to the /stocks UI endpoint — the silent-wrong-0 trap of the
  // 11h «Ниже минимума» / 11s Product.stock_minor bug-class. The report's
  // «Ожидание» is derived query-time from active supplier-order positions.
  /// Running aggregate cost-of-goods for what's in this (store, assortment).
  /// Weighted-average basis: per-unit cost = costBalanceMinor / qty when qty>0.
  /// Updated by StockService.applyDeltas when callers pass costDeltaMinor.
  costBalanceMinor BigInt  @default(0) @map("cost_balance_minor")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([accountId, storeId, assortmentKind, assortmentId])
  @@index([accountId, assortmentKind, assortmentId])
  @@map("stocks")
}

/// Per-cell stock balance (Адресное хранение, Phase 4). Materialized aggregate of
/// the qty held in one (store, cell, assortment), dual-written with Stock inside the
/// same transaction by StockService.applyDeltas whenever a delta carries a cellId.
///
/// FORWARD-LOOKING: a cell only appears here once a cell-tagged movement (enter/loss/…
/// with a picked Ячейка) touches it. Stock received WITHOUT a cell is "uncelled", so
/// Σ(StockByCell.qty) over a (store, assortment) is ≤ Stock.qty — the remainder is the
/// implicit «Без ячейки» bucket. NO backfill of historical store-level stock.
///
/// Derived views (no status column, per StoreCell comment):
///   «Занята»  = EXISTS row with cellId=X AND qty>0   ·  «Свободна» otherwise
///   «С этим товаром» = rows with (store, assortment) AND qty>0 → their cells
/// assortmentId stays FK-less (product|variant|bundle via assortmentKind) — mirrors Stock.
model StockByCell {
  accountId      String @map("account_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  cellId         String @map("cell_id") @db.Uuid
  assortmentKind String @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String @map("assortment_id") @db.Uuid

  qty       Decimal  @default(0) @db.Decimal(20, 6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store   Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Restrict: a cell holding stock cannot be silently deleted (parity «нельзя удалить
  // непустую ячейку»); the deleteCell service guard rejects with a friendly message first.
  cell    StoreCell @relation(fields: [cellId], references: [id], onDelete: Restrict)

  @@id([accountId, storeId, cellId, assortmentKind, assortmentId])
  // «С этим товаром» — cells holding a product across the store.
  @@index([accountId, storeId, assortmentKind, assortmentId])
  // «Свободна/Занята» — any qty>0 row for a cell.
  @@index([cellId])
  @@map("stock_by_cell")
}

/// Bo'lak reyestri — K-reja (`docs/plans/2026-08-25-bolinadigan-tovar-bolak-hisobi.md`),
/// K1 fazasi. Rulondan metrlab sotiladigan tovarning (kabel/sim/shlang) ombordagi
/// JISMONIY bo'laklari: **bitta qator = bitta jismoniy bo'lak**.
///
/// 🔷 ASOSIY G'OYA (K-reja 2-bo'lim): **kesish qoldiqni O'ZGARTIRMAYDI.** 250 m lik
/// rulondan 180 m kesilganda ombordagi kabel kamaymaydi — `250` o'rniga `180 + 70`
/// bo'ladi, jami o'sha 250. Shuning uchun bu jadval `Stock`/`StockByCell` ga
/// PARALLEL turadi va ularni HECH QACHON o'zgartirmaydi; qoldiq avvalgidek faqat
/// to'lov paytida kamayadi (F-reja Q1).
///
/// INVARIANT: `Σ length WHERE status='active'` == o'sha (ombor × yacheyka × tovar)
/// qoldig'i (`StockByCell.qty`, yacheykasizda `Stock.qty − Σ StockByCell.qty`).
/// Farq chiqsa **kassa TO'XTAMAYDI** — sverka hisoboti signal beradi (K1/3-vazifa).
/// Bu ataylab shunday: 2026-08-24 da kassa aynan qoldiq mexanizmiga tegilgani
/// uchun to'xtagan edi (`docs/plans/2026-08-24-split-kassa-hodisasi.md`).
///
/// `whole` (butun rulon) ≠ bo'lak — egasining qarori (K-Q3): butun rulonlar
/// bir-biridan farq qilmaydi (uchala 250 m bir xil, qaysinisini olish farqsiz) va
/// YORLIQSIZ turadi (UI ularni «250 m × 3» deb guruhlaydi); bo'laklar esa har biri
/// individ va UNIKAL yorliq oladi. Shundan `whole = true ⟹ label IS NULL` — DB
/// CHECK va `stock-piece-core.ts` guardi bilan ikki qavat qulflangan.
model StockPiece {
  id             String  @id @default(uuid()) @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  /// NULL = yacheykaga biriktirilmagan, ombor darajasidagi «Без ячейки» hovuzi.
  /// ATAYLAB (G-reja E1 bilan bir sabab): jonlida qoldiqning ~94 % i hech bir
  /// yacheykaga biriktirilmagan (`docs/ops/jonli-holat.md`). Faqat yacheykali
  /// bo'lakni qo'llasak reyestr aynan eng katta qismni ko'ra olmasdi.
  cellId         String? @map("cell_id") @db.Uuid
  /// `StockByCell`/`Stock` bilan AYNAN bir xil polimorf kalit (product|variant).
  /// FK ATAYLAB yo'q — `stock_by_cell` da ham yo'q (assortiment ikki jadvalda).
  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  /// QOLGAN uzunlik (kesimdan keyin yangilanadi). `StockByCell.qty` bilan AYNAN
  /// bir xil aniqlik — aks holda sverka yaxlitlash tufayli abadiy farq berardi.
  length         Decimal @db.Decimal(20, 6)
  /// Butun rulonmi (yorliqsiz, almashtiriladigan) — K-Q3.
  whole          Boolean @default(false)
  /// Bo'lak yorlig'i, `BLK-` makonida (K-reja 7.3). Tovar shtrixlari ataylab
  /// UNIKAL EMAS (multi-hit tanlovi), bo'lak yorlig'i esa aynan BITTA jismoniy
  /// bo'lakni bildiradi ⇒ majburan unikal. Unikallik AKKAUNT ichida: yorliq
  /// raqami akkaunt bo'yicha yuritiladi va global unikallik ikki tenantni
  /// to'qnashtirardi (`products.code` naqshi).
  label          String? @db.VarChar(40)
  /// Qaysi bo'lakdan kesilgan (tarix zanjiri).
  sourcePieceId  String? @map("source_piece_id") @db.Uuid
  /// `active` — omborda turibdi, sverkaga KIRADI; `consumed` — mijozga ketgan
  /// yoki hisobdan chiqarilgan, sverkada SANALMAYDI (tarix uchun qoladi).
  status         String  @default("active") @db.VarChar(20)

  /// K4 — bo'lak QAYSI chek qatoriga kesilgani («mijoz oldida turibdi»).
  ///
  /// 🔴 Band bo'lgan bo'lak HAM omborda va sverkada SANALADI: kesim
  /// STOK-NEYTRAL, qoldiq esa faqat to'lovda kamayadi (K-reja 2-bo'lim).
  /// Ya'ni bu maydon «kim uchun ajratilgan» degan izoh, «yo'q» degani EMAS.
  ///
  /// Ikkala tomonda ham SET NULL ATAYLAB: chek bekor qilinsa yoki qatorini
  /// kontrol o'chirsa, kesilgan bo'lak omborda YORLIG'I bilan qolaveradi va
  /// ertaga boshqa mijozga ketadi (K-reja 2-bo'lim: «mijoz voz kechsa hech
  /// nima buzilmaydi»). Kabelni qaytarib ulab bo'lmaydi — bo'lakning o'zi
  /// jismoniy haqiqat, chek esa yo'qoladigan hujjat.
  reservedSaleId     String? @map("reserved_sale_id") @db.Uuid
  reservedPositionId String? @map("reserved_position_id") @db.Uuid

  /// Nega `consumed` bo'lgani — sverkadagi farqni tushuntiradigan YAGONA joy:
  /// `sold` (mijozga ketdi, to'lov paytida), `scrap` (1 m dan kalta qoldiq,
  /// K-Q6), `cut-loss` (omborchi tuzatgan kesim yo'qotishi), `closed`
  /// (K2 ekranidagi «tugadi»). NULL — K4 dan oldingi qatorlar.
  consumedReason String? @map("consumed_reason") @db.VarChar(20)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Restrict: bo'lagi bor ombor jimgina o'chmasin (`StockByCell.store` naqshi).
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // SetNull: yacheyka o'chsa bo'lak ombor darajasiga TUSHADI, yo'qolmaydi —
  // jismoniy bo'lak omborda qolaveradi va sverkadan chiqib ketmasligi kerak.
  cell        StoreCell?   @relation(fields: [cellId], references: [id], onDelete: SetNull)
  // SetNull: manba bo'lak o'chsa bola yetim qoladi, lekin YO'QOLMAYDI.
  sourcePiece StockPiece?  @relation("StockPieceCut", fields: [sourcePieceId], references: [id], onDelete: SetNull)
  cutPieces   StockPiece[] @relation("StockPieceCut")
  // K4 — band qilingan chek/qator (yuqoridagi izoh: SetNull, bo'lak omonat emas).
  reservedSale     RetailSale?         @relation("StockPieceReservedSale", fields: [reservedSaleId], references: [id], onDelete: SetNull)
  reservedPosition RetailSalePosition? @relation("StockPieceReservedPosition", fields: [reservedPositionId], references: [id], onDelete: SetNull)

  @@unique([accountId, label])
  // Sverka va K2/K3 ekranlari: (ombor × tovar) kesimidagi faol bo'laklar.
  @@index([accountId, storeId, assortmentKind, assortmentId, status], map: "stock_pieces_account_store_assortment_status_idx")
  // Yacheyka tarkibi (K2 ekrani, TSD sanash).
  @@index([cellId])
  @@index([sourcePieceId])
  // K4 — `post()`/`cancel()` chek qatorlari bo'yicha bo'laklarni topadi.
  @@index([accountId, reservedPositionId], map: "stock_pieces_account_reserved_position_idx")
  @@index([accountId, reservedSaleId], map: "stock_pieces_account_reserved_sale_idx")
  @@map("stock_pieces")
}

// =========================================================================
// Sprint 4.2 — InvoiceIn (Счёт поставщика) — purchase-side mirror of InvoiceOut
// =========================================================================

/// Счёт поставщика — InvoiceIn (invoice received from supplier).
/// FSM: draft → posted (applicable=true, updates PO.invoicedSum)
///      posted → draft (unpost: reverts PO.invoicedSum)
///      draft|posted → cancelled
///      posted → partially_paid / paid (derived from PaymentOut, Sprint 4.3)
///
/// Unlike InvoiceOut, InvoiceIn has no 'sent' state (the supplier sent it, we
/// receive) and no 'overdue' (supplier's concern — we track only own payment
/// due date here for our planning).
model InvoiceIn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  // Document identity
  name           String    @db.VarChar(100) // "СФ-2026-00001" (Счёт-фактура входящий)
  code           String?   @db.VarChar(50)
  externalCode   String?   @map("external_code") @db.VarChar(50)
  syncId         String?   @map("sync_id") @db.Uuid
  // Supplier's original document number (as printed on their invoice)
  incomingNumber String?   @map("incoming_number") @db.VarChar(100)
  incomingDate   DateTime? @map("incoming_date") @db.Timestamptz()

  // References
  agentId               String  @map("agent_id") @db.Uuid // supplier counterparty
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  // moysklad has store on InvoiceIn — which warehouse the linked Supply
  // would receive into. Optional — null = caller picks at posting time.
  storeId               String? @map("store_id") @db.Uuid
  purchaseOrderId       String? @map("purchase_order_id") @db.Uuid
  /// Optional contract scoping the invoice — moysklad's "Договор" field.
  contractId            String? @map("contract_id") @db.Uuid
  /// Optional project tagging the invoice — moysklad's "Проект" field.
  projectId             String? @map("project_id") @db.Uuid

  // Moment + lifecycle
  moment               DateTime  @default(now()) @db.Timestamptz()
  paymentPlannedMoment DateTime? @map("payment_planned_moment") @db.Timestamptz()
  applicable           Boolean   @default(false)
  state                String    @default("draft") @db.VarChar(30)
  postedAt             DateTime? @map("posted_at") @db.Timestamptz()

  // Money totals (tiyin)
  sumMinor        BigInt @default(0) @map("sum_minor")
  vatSumMinor     BigInt @default(0) @map("vat_sum_minor")
  payedSumMinor   BigInt @default(0) @map("payed_sum_minor")
  // Tracks how much of the invoice's items have been physically received
  // (cascades from linked Supply documents). UI column "Получено".
  shippedSumMinor BigInt @default(0) @map("shipped_sum_minor")

  // VAT config
  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  // Currency + rate
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Metadata
  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int       @default(1)

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                Employee?             @relation("InvoiceInOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  agent                Counterparty          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentAccount         CounterpartyAccount?  @relation("InvoiceInAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount  OrganizationAccount?  @relation("InvoiceInOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store                Store?                @relation("InvoiceInStore", fields: [storeId], references: [id], onDelete: SetNull)
  purchaseOrder        PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  contract             Contract?             @relation("InvoiceInContract", fields: [contractId], references: [id], onDelete: SetNull)
  project              Project?              @relation("InvoiceInProject", fields: [projectId], references: [id], onDelete: SetNull)
  positions            InvoiceInPosition[]
  paymentOutOperations PaymentOutOperation[]
  cashOutOperations    CashOutOperation[]

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, agentId])
  @@index([accountId, purchaseOrderId])
  @@index([accountId, moment(sort: Desc)])
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([accountId, ownerId])
  @@index([accountId, contractId])
  @@index([accountId, projectId])
  @@map("invoices_in")
}

/// Line position for InvoiceIn. Mirrors PurchaseOrderPosition shape.
model InvoiceInPosition {
  id          String @id @default(uuid()) @db.Uuid
  invoiceInId String @map("invoice_in_id") @db.Uuid
  accountId   String @map("account_id") @db.Uuid

  position Int

  assortmentKind String  @default("product") @map("assortment_kind") @db.VarChar(20)
  assortmentId   String  @map("assortment_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  purchaseOrderPositionId String? @map("purchase_order_position_id") @db.Uuid

  quantity Decimal @db.Decimal(20, 6)

  priceMinor BigInt  @map("price_minor")
  discount   Decimal @default(0) @db.Decimal(5, 2)
  vat        Int?
  vatEnabled Boolean @default(true) @map("vat_enabled")

  invoiceIn             InvoiceIn              @relation(fields: [invoiceInId], references: [id], onDelete: Cascade)
  product               Product?               @relation("ProductInvoiceInPositions", fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderPosition PurchaseOrderPosition? @relation("InvoiceInFromPurchaseOrderPosition", fields: [purchaseOrderPositionId], references: [id], onDelete: SetNull)

  @@index([invoiceInId, position])
  @@index([accountId, assortmentKind, assortmentId])
  @@index([accountId, purchaseOrderPositionId])
  @@map("invoice_in_positions")
}

// =========================================================================
// Audit Log (ADR-0005)
// =========================================================================

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  entity       String   @db.VarChar(100)
  entityId     String   @map("entity_id") @db.Uuid
  action       String   @db.VarChar(50)
  // Field-level diff: { field: { before, after } } for updates. null for create/delete.
  fieldChanges Json?    @map("field_changes")
  // Context: { ip, userAgent, sessionId, source }
  context      Json?
  at           DateTime @default(now()) @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    Employee? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, entity, entityId, at(sort: Desc)])
  @@index([accountId, userId, at(sort: Desc)])
  @@index([accountId, at(sort: Desc)])
  @@map("audit_log")
}

// Pipeline (Воронка продаж) — sales funnel definition.
// Each account has at least one pipeline; opportunities flow through that
// pipeline's stages. Multiple pipelines let you separate B2B from B2C, or
// "primary sales" from "post-sale upsell", each with their own stages.
model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(255)
  // Default pipeline new opportunities land in if none specified. Exactly
  // one pipeline per account should have isDefault=true at any time; the
  // service enforces that invariant.
  isDefault Boolean  @default(false) @map("is_default")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version   Int      @default(1)

  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([accountId, name])
  @@index([accountId, archived])
  @@map("pipelines")
}

// PipelineStage — one column in the Kanban / one step in the funnel.
// type='open' is a working stage; type='won'/'lost' are terminal — moving
// an opportunity into them sets its closedAt and updates its cached status.
model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  pipelineId  String   @map("pipeline_id") @db.Uuid
  name        String   @db.VarChar(100)
  position    Int      @default(0)
  // 'open' | 'won' | 'lost'.
  type        String   @default("open") @db.VarChar(10)
  // 0..100 — default probability percent for opportunities in this stage.
  // Overridable per-opportunity via Opportunity.probability.
  probability Int      @default(50)
  // Optional Tailwind/CSS hex like '#3B82F6' for the Kanban column accent.
  color       String?  @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([accountId, pipelineId, position])
  @@map("pipeline_stages")
}

// Opportunity (Сделка) — a sales deal currently in the funnel.
// Number is auto-generated per account per year as СД-YYYY-NNNNN.
// status mirrors stage.type so list/Kanban filtering stays cheap; the
// service updates status whenever stageId changes.
model Opportunity {
  id              String  @id @default(uuid()) @db.Uuid
  accountId       String  @map("account_id") @db.Uuid
  number          String  @db.VarChar(50)
  name            String  @db.VarChar(255)
  pipelineId      String  @map("pipeline_id") @db.Uuid
  stageId         String  @map("stage_id") @db.Uuid
  counterpartyId  String? @map("counterparty_id") @db.Uuid
  contactPersonId String? @map("contact_person_id") @db.Uuid
  ownerId         String? @map("owner_id") @db.Uuid

  // Money in tiyin (BigInt) following the global money convention.
  amount            BigInt    @default(0)
  currency          String    @default("UZS") @db.VarChar(3)
  // null → use stage probability; otherwise an override 0..100.
  probability       Int?
  expectedCloseDate DateTime? @map("expected_close_date") @db.Timestamptz()
  // 'open' | 'won' | 'lost' — cached from current stage.type for fast filtering.
  status            String    @default("open") @db.VarChar(10)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz()
  // 'website' | 'phone' | 'referral' | 'cold' | 'event' | 'other' (free-form for now).
  source            String?   @db.VarChar(50)
  // Free-text reason captured when an opportunity is moved into a 'lost' stage.
  lostReason        String?   @map("lost_reason")
  description       String?
  archived          Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version           Int       @default(1)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id])
  stage         PipelineStage  @relation(fields: [stageId], references: [id])
  counterparty  Counterparty?  @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  contactPerson ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  owner         Employee?      @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([accountId, number])
  @@index([accountId, pipelineId, stageId])
  @@index([accountId, counterpartyId, status])
  @@index([accountId, ownerId, status])
  @@index([accountId, status, archived])
  @@index([accountId, archived, createdAt(sort: Desc)])
  @@map("opportunities")
}

// Attachment — generic file storage attached to any business entity
// (Demand, InvoiceOut, CustomerOrder, Supply, Counterparty, Opportunity,
// ...). Identified polymorphically via (entity, entityId). For binary
// payload we keep bytea inline up to ~10 MB; a future S3 migration can
// add a `storageUrl` column without touching callers.
//
// We deliberately do NOT create FK constraints on (entity, entityId)
// — the entity is a string discriminator and pointing to specific
// tables would require either inheritance or per-entity tables. The
// service is responsible for cascading deletes when host entities die.
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  entity      String   @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  uploaderId  String?  @map("uploader_id") @db.Uuid
  filename    String   @db.VarChar(255)
  mime        String   @db.VarChar(100)
  sizeBytes   Int      @map("size_bytes")
  content     Bytes
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uploader Employee? @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([accountId, entity, entityId, createdAt(sort: Desc)])
  @@index([accountId, uploaderId, createdAt(sort: Desc)])
  @@map("attachments")
}

// EmailConfig — per-account SMTP configuration. One row per account
// (enforced by the @unique on accountId). Password is stored encrypted
// (AES-256-GCM, keyed by EMAIL_ENCRYPTION_KEY env var) so even DB
// dumps don't leak credentials. The service rotates encryption on
// each save.
model EmailConfig {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @unique @map("account_id") @db.Uuid
  // UI hint only: 'gmail' | 'yandex' | 'mailru' | 'custom'.
  provider       String    @default("custom") @db.VarChar(20)
  fromName       String?   @map("from_name") @db.VarChar(255)
  fromEmail      String    @map("from_email") @db.VarChar(255)
  replyTo        String?   @map("reply_to") @db.VarChar(255)
  // SMTP server.
  host           String    @db.VarChar(255)
  port           Int       @default(587)
  // true = implicit TLS (port 465); false = STARTTLS (port 587).
  secure         Boolean   @default(false)
  username       String    @db.VarChar(255)
  // base64(iv:12 || tag:16 || cipher) — see crypto.ts in api.
  passwordCipher String    @map("password_cipher")
  // Last connection-test snapshot (for showing in the settings UI).
  lastTestedAt   DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk     Boolean?  @map("last_test_ok")
  lastTestMsg    String?   @map("last_test_msg")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

// EmailLog — append-only audit trail of every email send attempt.
// We log the rendered HTML body too so the user can re-inspect what
// was actually sent (useful for billing disputes). entity/entityId
// are nullable because some emails — like one-off contact letters —
// aren't tied to a specific business document.
model EmailLog {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  senderId      String?   @map("sender_id") @db.Uuid
  entity        String?   @db.VarChar(50)
  entityId      String?   @map("entity_id") @db.Uuid
  toAddresses   String[]  @map("to_addresses")
  ccAddresses   String[]  @default([]) @map("cc_addresses")
  subject       String    @db.VarChar(500)
  bodyHtml      String    @map("body_html")
  /// Snapshot of attachment IDs at enqueue time. Used by the retry worker
  /// to re-resolve binary content on each attempt (attachments are stored
  /// in their own bytea table; we reference, not embed).
  attachmentIds String[]  @default([]) @map("attachment_ids") @db.Uuid
  /// 'pending' | 'sending' | 'sent' | 'dead'.
  /// 'sending' = exclusive worker claim, SMTP call in flight; `next_retry_at`
  /// is the claim lease (Faza 28, see api `shared/outbox-claim.ts`).
  /// Note: pre-Sprint-17.4 rows may have status='failed' from the legacy
  /// inline-send path. Worker treats those as terminal — no retry.
  status        String    @default("pending") @db.VarChar(20)
  /// 1-based attempt counter — incremented per worker tick.
  attempt       Int       @default(1)
  /// After this many failed attempts the row goes to status='dead'.
  /// Default 4 ⇒ schedule 1m → 5m → 15m → 1h, then dead.
  maxAttempts   Int       @default(4) @map("max_attempts")
  /// When the worker should pick this row up. Set on enqueue (=now) and
  /// bumped on each failed attempt by the backoff schedule. NULL once
  /// the row reaches a terminal state ('sent' or 'dead').
  nextRetryAt   DateTime? @map("next_retry_at") @db.Timestamptz()
  /// Last attempt timestamp (NULL until the worker first picks it up).
  attemptedAt   DateTime? @map("attempted_at") @db.Timestamptz()
  errorMsg      String?   @map("error_msg")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sender  Employee? @relation("EmailLogSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([accountId, entity, entityId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  /// Hot-path index for the EmailDeliveryService cron worker:
  /// pick rows where status='pending' and nextRetryAt<=NOW(), oldest first.
  @@index([status, nextRetryAt])
  @@map("email_logs")
}

// =========================================================================
// Production (Ishlab chiqarish) — Sprint 11.6
// =========================================================================

/// Bill of Materials (Техкарта / ТК).
/// V1 constraints:
///   - One BOM per output product (@@unique accountId+productId).
///   - Direct components only — no recursive/nested BOM expansion.
///   - Single output product — no multi-output BOMs.
///   - standardCostMinor is computed at save time by BomService.
model BillOfMaterials {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  name              String   @db.VarChar(255)
  /// moysklad «Внешний код» — universal external-system sync key.
  /// processingplan (Техкарта) carries it in moysklad; was missing here.
  externalCode      String?  @map("external_code") @db.VarChar(50)
  /// Output product — the thing this BOM produces.
  productId         String   @map("product_id") @db.Uuid
  /// Standard output qty per BOM run (e.g. recipe yields 10 units).
  outputQty         Decimal  @default(1) @map("output_qty") @db.Decimal(20, 6)
  /// Standard cost (tiyin) = Σ(componentQty × product.buyPrice). Recomputed on every component change.
  standardCostMinor BigInt   @default(0) @map("standard_cost_minor")
  description       String?
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version           Int      @default(1)

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product          Product           @relation("BomOutputProduct", fields: [productId], references: [id], onDelete: Restrict)
  components       BomComponent[]
  workOrders       WorkOrder[]
  processingOrders ProcessingOrder[] @relation("ProcessingOrderPlan")
  processings      Processing[]      @relation("ProcessingPlan")

  /// One BOM per output product per account (V1 simplification).
  @@unique([accountId, productId])
  @@index([accountId, archived])
  @@map("bills_of_materials")
}

/// BomComponent — one ingredient row inside a BillOfMaterials.
model BomComponent {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  bomId     String  @map("bom_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  qty       Decimal @db.Decimal(20, 6)
  position  Int     @default(0)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bom     BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product         @relation("BomComponentProduct", fields: [productId], references: [id], onDelete: Restrict)

  /// One component row per (bom, product) — no duplicate ingredients.
  @@unique([bomId, productId])
  @@index([accountId, bomId, position])
  @@map("bom_components")
}

/// WorkOrder (Техническое задание / ТЗ).
/// FSM:
///   draft → in_progress  (sets startedAt = now())
///   in_progress → completed  (sets completedAt = now(); producedQty must be > 0)
///   draft | in_progress → cancelled
///   completed → cancelled  (manual override; audit trail preserved)
///
/// Stock cascade (IMPLEMENTED — work-order.service.ts; this comment
/// previously claimed a stale "V1 — no cascade", corrected §86):
///   in_progress → completed : consume BOM components (qty × runs,
///     runs = producedQty / BOM.outputQty), sufficiency-checked, emit
///     producedQty of the output product.
///   completed → cancelled   : exact reverse via the persisted
///     producedQty (components back in, output out).
/// Atomic with the FSM flip inside a $transaction, guarded by a
/// CAS update (state=from) so concurrent transitions can't double-fire.
/// Adversarially covered by work-order.service.test.ts (§86).
model WorkOrder {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  /// Auto-number: ТЗ-YYYY-NNNNN
  name           String    @db.VarChar(50)
  bomId          String    @map("bom_id") @db.Uuid
  /// Where components are consumed + output produced (V2).
  storeId        String    @map("store_id") @db.Uuid
  plannedQty     Decimal   @map("planned_qty") @db.Decimal(20, 6)
  producedQty    Decimal   @default(0) @map("produced_qty") @db.Decimal(20, 6)
  /// draft | in_progress | completed | cancelled
  state          String    @default("draft") @db.VarChar(20)
  /// moysklad «Дата документа» (processingorder.moment) — the editable
  /// document date. Mirrors InternalOrder.moment / Production.moment; the
  /// /new editor bound an editable date control whose value was silently
  /// dropped before this column existed (only the immutable createdAt was
  /// stored). Defaulted ⇒ existing rows backfilled from created_at.
  moment         DateTime  @default(now()) @map("moment") @db.Timestamptz()
  plannedStartAt DateTime? @map("planned_start_at") @db.Timestamptz()
  plannedEndAt   DateTime? @map("planned_end_at") @db.Timestamptz()
  startedAt      DateTime? @map("started_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version        Int       @default(1)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner   Employee?       @relation("WorkOrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  bom     BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Restrict)
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@index([accountId, state, deletedAt])
  @@index([accountId, bomId])
  @@map("work_orders")
}

// =========================================================================
// Retail / POS — Sprint 12
// =========================================================================

/// CashierSession — open/close shift at a specific CashDesk by a specific
/// cashier (Employee). One session = one shift. RetailSale rows are
/// tied to exactly one open session. Closing the session locks it
/// (state='closed') and records the discrepancy between expected and
/// actual cash drawer.
model CashierSession {
  id                    String  @id @default(uuid()) @db.Uuid
  accountId             String  @map("account_id") @db.Uuid
  ownerId               String? @map("owner_id") @db.Uuid
  groupId               String? @map("group_id") @db.Uuid
  cashierId             String  @map("cashier_id") @db.Uuid
  cashDeskId            String  @map("cash_desk_id") @db.Uuid
  // Smena tizimi: sessiya qaysi smenaga tegishli (/sotuv navbat boshqaruvi).
  smenaId               String? @map("smena_id") @db.Uuid
  // Smena vaqtidan TASHQARI ochilgan bo'lsa — kassir ko'rsatgan sabab.
  outOfShiftReason      String? @map("out_of_shift_reason") @db.VarChar(500)
  storeId               String  @map("store_id") @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid

  // Document identity (moysklad parity)
  name         String  @default("") @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  openedAt          DateTime  @default(now()) @map("opened_at") @db.Timestamptz()
  closedAt          DateTime? @map("closed_at") @db.Timestamptz()
  openingCashMinor  BigInt    @default(0) @map("opening_cash_minor")
  closingCashMinor  BigInt?   @map("closing_cash_minor")
  expectedCashMinor BigInt?   @map("expected_cash_minor")
  discrepancyMinor  BigInt?   @map("discrepancy_minor")
  state             String    @default("open") @db.VarChar(10)

  /// DOLLAR YASHIQ (MK31 · kassa TZ §8.1/§8.4) — SENTDA, so'mga
  /// o'girilmaydi. Dollar farqi ataylab alohida yuritiladi: kurs bilan
  /// o'girish yo'qolgan dollarni «taxminiy so'm»ga aylantirib, farq aktini
  /// dalil bo'lishdan to'xtatardi.
  ///
  /// `closing`/`expected`/`discrepancy` NULLABLE va `null` MA'NOLI:
  /// «sanalmagan» ≠ «sanadim, dollar yo'q» (0). Dollarsiz ishlaydigan
  /// kassalarda uchalasi ham NULL bo'lib qoladi va hech qanday akt
  /// yozilmaydi — mavjud smenalar uchun xulq o'zgarmaydi.
  openingCashUsdMinor  BigInt  @default(0) @map("opening_cash_usd_minor")
  closingCashUsdMinor  BigInt? @map("closing_cash_usd_minor")
  expectedCashUsdMinor BigInt? @map("expected_cash_usd_minor")
  discrepancyUsdMinor  BigInt? @map("discrepancy_usd_minor")

  salesCount      Int    @default(0) @map("sales_count")
  salesSumMinor   BigInt @default(0) @map("sales_sum_minor")
  returnsCount    Int    @default(0) @map("returns_count")
  returnsSumMinor BigInt @default(0) @map("returns_sum_minor")

  // Z-report breakdowns (moysklad's Cheque + proceeds/received fields).
  // proceedsCash    = total cash sales during shift (gross)
  // proceedsNoCash  = total card / non-cash sales (incl. acquiring fees gross)
  // receivedCash    = net cash kept (proceeds - drawer pickups - returns)
  // receivedNoCash  = net non-cash settled to bank account
  proceedsCashMinor   BigInt @default(0) @map("proceeds_cash_minor")
  proceedsNoCashMinor BigInt @default(0) @map("proceeds_no_cash_minor")
  receivedCashMinor   BigInt @default(0) @map("received_cash_minor")
  receivedNoCashMinor BigInt @default(0) @map("received_no_cash_minor")

  // Acquiring (card processing) settlement
  bankPercent           Decimal? @map("bank_percent") @db.Decimal(5, 2)
  bankCommissionMinor   BigInt   @default(0) @map("bank_commission_minor")
  // QR-payment acquiring (Humo / Click QR) — moysklad tracks as separate
  // bank because rates differ from card acquiring.
  qrBankPercent         Decimal? @map("qr_bank_percent") @db.Decimal(5, 2)
  qrBankCommissionMinor BigInt   @default(0) @map("qr_bank_commission_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  /// MENEJER QABULI (MK08 / 4M TZ §6) — `state` dan ALOHIDA o'q.
  ///
  /// `state` = smena hayoti (`open`/`closed`), bu ustun = «kim buni ko'rdi va
  /// rozi bo'ldi». Ikkalasini bitta ustunga siqish yopilgan-u ko'rilmagan
  /// smenani ko'rsatib bo'lmas holatga olib kelardi.
  ///
  /// Qiymatlar `cashier-session/shift-acceptance.ts` FSM'idan: `open` →
  /// `pending` → `accepted` | `rejected` | `escalated` | `force_accepted` |
  /// `stale`. VarChar (enum EMAS) — sxemaning umumiy konvensiyasi.
  acceptanceState String @default("open") @map("acceptance_state") @db.VarChar(20)

  /// Kim va qachon qabul qilgan. FK YO'Q — `actorId` naqshi
  /// (`EmployeeDailyKpi.acceptedById`, `SupplyApprovalEvent`): aktyor tizim
  /// yoki egasi ham bo'lishi mumkin.
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz()

  /// Qabul holati OXIRGI MARTA qachon o'zgardi — eskalatsiya soati shundan
  /// sanaydi. `updatedAt` YARAMAYDI: u har qanday tahrirda yangilanadi, ya'ni
  /// javobsiz turgan smena har tegishda «yangi» bo'lib ko'rinardi va hech
  /// qachon egaga chiqmasdi (kunlik KPI'dagi `stateChangedAt` bilan bir sabab).
  acceptanceChangedAt DateTime? @map("acceptance_changed_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account             Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?             @relation("CashierSessionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group               Group?                @relation("CashierSessionGroup", fields: [groupId], references: [id], onDelete: SetNull)
  cashier             Employee              @relation("CashierSessionCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  cashDesk            CashDesk              @relation(fields: [cashDeskId], references: [id], onDelete: Restrict)
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccount OrganizationAccount?  @relation("CashierSessionOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  smena               Smena?                @relation(fields: [smenaId], references: [id], onDelete: SetNull)
  sales               RetailSale[]
  drawerCashIn        RetailDrawerCashIn[]  @relation("RetailDrawerInShift")
  drawerCashOut       RetailDrawerCashOut[] @relation("RetailDrawerOutShift")
  retailSalesReturns  RetailSalesReturn[]   @relation("RetailSalesReturnShift")
  auditEvents         CashierAuditEvent[]
  variances          CashierSessionVariance[] @relation("CashierSessionVarianceSession")
  acceptanceEvents   CashierSessionAcceptanceEvent[]

  @@index([accountId, cashierId, state])
  @@index([accountId, cashDeskId, state])
  /// Menejer navbati: «qabul kutayotgan smenalar, eng eskisi birinchi».
  @@index([accountId, acceptanceState, acceptanceChangedAt])
  /// Javobgarlik taxtasi: «shu kassirda nechta yopilmagan smena qolgan».
  @@index([accountId, cashierId, acceptanceState])
  @@map("cashier_sessions")
}

/// Smena qabulining APPEND-ONLY jurnali (MK08 / 4M TZ §6, §7).
///
/// NEGA JADVAL, ustun emas: menejer «har harakati ham o'lchanadi» (TZ §7) —
/// egaga haftalik xulosa «nechta qabul, nechta rad etish, qaysi sabablar»
/// degan savolga aynan shu qatorlardan javob beradi. Yagona `rejectReason`
/// ustuni faqat OXIRGI holatni saqlardi va nizo paytida yozma iz qolmasdi.
///
/// Qator HECH QACHON tahrirlanmaydi/o'chirilmaydi. Tushuntirish halqasi ham
/// shu yerda: kassir javobi `explain` hodisasining `comment` maydonida.
model CashierSessionAcceptanceEvent {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  fromState String @map("from_state") @db.VarChar(20)
  toState   String @map("to_state") @db.VarChar(20)

  /// `shift-acceptance.ts` dagi SHIFT_ACCEPTANCE_ACTION qiymati.
  action String @db.VarChar(30)

  /// system | manager | cashier | owner (FSM'dagi SHIFT_ACTOR).
  actorType String  @map("actor_type") @db.VarChar(20)
  actorId   String? @map("actor_id") @db.Uuid

  /// Yopiq ro'yxatdan (FSM SHIFT_REASON_CODES). `other` bo'lsa izoh MAJBURIY.
  reasonCode String? @map("reason_code") @db.VarChar(40)
  /// Rad etish izohi yoki KASSIRNING TUSHUNTIRISHI — nizoda yagona yozma iz.
  comment    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session CashierSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Smena kartochkasidagi tarix.
  @@index([accountId, sessionId, createdAt])
  /// Egaga haftalik xulosa: «shu haftada nima bo'ldi».
  @@index([accountId, createdAt(sort: Desc)])
  /// «Qaysi sabab bilan ko'p rad etilyapti» statistikasi.
  @@index([accountId, action, createdAt(sort: Desc)])
  @@map("cashier_session_acceptance_events")
}

/// CashierAuditEvent — kassa TZ §9: the control half of the «trust the cashier»
/// model. The cashier may set any price, sell below cost, cancel a receipt and
/// refund freely (Q8/Q11/Q16); none of that is blocked, so ALL of it has to
/// leave a trace. Without this table «freedom» is simply an absence of control.
///
/// Deliberately NOT the existing `AuditLog`. That one is the moysklad History
/// tab: a per-entity field diff (entity/entityId/fieldChanges), queried as
/// "what happened to THIS document". These events are queried along a
/// completely different axis — by shift and by cashier ("who discounts the
/// most", "whose debts grow fastest", "who cancels most") — and carry a typed
/// business payload rather than a before/after map. Forcing them into AuditLog
/// would drop `sessionId`, which is the very axis the analytics need.
///
/// `type` is a VarChar rather than a Postgres enum, matching the convention
/// used across this schema (RestockTask.status, RetailSale.state): new event
/// types then ship without a migration. Known values:
///   PRICE_CHANGED          — sold at a price other than the card's retail tier
///   SOLD_BELOW_WHOLESALE   — below the negotiated floor («Оптовая цена»)
///   SOLD_BELOW_COST        — below cost; payload carries the loss amount
///   SALE_CANCELLED         — receipt cancelled; payload carries the stage
///   REFUND                 — mirror receipt created
///   SHIFT_OUT_OF_SCHEDULE  — shift opened outside its schedule, with reason
/// Reserved for later waves (features do not exist yet): SOLD_ON_CREDIT,
/// EXPENSE, SHIFT_VARIANCE.
/// Smena farq akti (kassa TZ §8.4) — sanalgan naqd kutilgandan farq qilganda.
///
/// NEGA ALOHIDA JADVAL: `CashierSession.discrepancyMinor` faqat OXIRGI raqamni
/// saqlaydi va u yerda sabab ham, kassir izohi ham, kim ko'rgani ham yo'q.
/// Farq — pul yo'qolishi haqidagi da'vo: uning yonida DALIL turishi kerak,
/// aks holda menejer keyin «nega minus edi» degan savolga javob topa olmaydi.
///
/// Yozuv HECH QACHON o'chirilmaydi/ustidan yozilmaydi: bir smenaning farqi
/// bitta akt. Tan olinishi (`acknowledgedAt`) alohida maydon — aktning o'zi
/// o'zgarmaydi.
model CashierSessionVariance {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  /// Kim yopgan (odatda smena kassiri; admin boshqa smenani yopishi mumkin).
  cashierId String @map("cashier_id") @db.Uuid

  /// Sanoq VALYUTASI. USD farqi UZS'ga O'GIRILMAYDI (§8.4): kurs bilan
  /// o'girish yo'qolgan dollarni «taxminiy so'm» ga aylantirib, dalilni
  /// yo'qotardi. Har valyuta uchun alohida qator.
  currency String @default("UZS") @db.VarChar(3)

  expectedMinor BigInt @map("expected_minor")
  countedMinor  BigInt @map("counted_minor")
  /// `counted − expected`. Manfiy = KAMOMAD, musbat = ORTIQCHA.
  varianceMinor BigInt @map("variance_minor")

  /// 'shortage' | 'surplus' — hisoblanadigan qiymat, lekin saqlanadi:
  /// hisobotlar shu bo'yicha filtrlaydi va `variance_minor < 0` sharti
  /// har so'rovda takrorlanishi indekssiz skanerga olib kelardi.
  kind String @db.VarChar(20)

  /// Kassirning izohi (yopish formasida yoziladi, ixtiyoriy).
  cashierNote String? @map("cashier_note")

  /// Menejer aktni ko'rib, tan olgani. NULL = hali ko'rilmagan.
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz()
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  managerNote      String?   @map("manager_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session        CashierSession @relation("CashierSessionVarianceSession", fields: [sessionId], references: [id], onDelete: Cascade)
  cashier        Employee       @relation("CashierSessionVarianceCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  acknowledgedBy Employee?      @relation("CashierSessionVarianceAck", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  /// Bir smena + bir valyuta = bitta akt. Ikki marta yopishga urinish
  /// (§8.4 idempotentligi) ikkinchi aktni yaratmaydi.
  @@unique([sessionId, currency])
  /// Menejerning asosiy savoli: «ko'rilmagan aktlar qaysi?»
  @@index([accountId, acknowledgedAt, createdAt(sort: Desc)])
  /// «Qaysi kassirda farq tez-tez chiqadi» (4-bo'lim / HR jarima asosi).
  @@index([accountId, cashierId, kind, createdAt(sort: Desc)])
  @@map("cashier_session_variances")
}

model CashierAuditEvent {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  /// The shift the event belongs to — the primary analytics axis.
  sessionId  String  @map("session_id") @db.Uuid
  /// Who did it. Kept as its own column (not derived from the session) because
  /// an admin can act inside another cashier's shift.
  employeeId String  @map("employee_id") @db.Uuid
  type       String  @db.VarChar(40)
  /// The document the event is about (RetailSale id for sale events). Not a FK:
  /// the event must survive the document being deleted — an audit trail that
  /// disappears with its subject is not an audit trail.
  docId      String? @map("doc_id") @db.Uuid
  /// Typed per `type`; money always in minor units as strings (BigInt is not
  /// JSON-safe). See the per-type shapes in `cashier-audit.ts`.
  payload    Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session  CashierSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee       @relation("CashierAuditEventEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  // Shift report / Z-report: everything that happened in one shift, newest first.
  @@index([accountId, sessionId, createdAt(sort: Desc)])
  // «Which cashier does X, and how often» — the manager's question (3-bo'lim).
  @@index([accountId, employeeId, type, createdAt(sort: Desc)])
  // Account-wide feed of one event kind (e.g. every below-cost sale this month).
  @@index([accountId, type, createdAt(sort: Desc)])
  @@map("cashier_audit_events")
}

/// RetailSale — POS receipt. One open session can hold many. Each sale
/// has line items + payment split (cash + card).
model RetailSale {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid
  sessionId String  @map("session_id") @db.Uuid

  // Document identity
  name         String  @db.VarChar(50)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  /// QOG'OZDAGI chek raqami — kassirning SHU KUNDAGI ketma-ket soni
  /// (egasi, 2026-09-02: «120 ta sotuv bo'lsa keyingi chek 121»).
  ///
  /// `name` (`ТРН-2026-00073`) HUJJAT nomi bo'lib qoladi — tizim ichidagi
  /// qidiruv, reyestr va moysklad-paritet o'sha ustunda. Bu esa faqat mijoz
  /// qo'lidagi qog'oz uchun: qisqa va kassirga tushunarli.
  ///
  /// 🔴 SAQLANADI, hisoblanmaydi. «Shu kunning nechanchi cheki» ni o'qishda
  /// sanash mumkin edi-yu, chek BEKOR qilinsa yoki qaytarilsa qolganlarining
  /// raqami surilib ketardi — mijoz qo'lidagi qog'oz bilan bazadagi raqam
  /// ajralardi. Chek — moliyaviy hujjat: raqami post() onida MUZLAYDI.
  ///
  /// NULL = 2026-09-02 dan OLDINGI cheklar (backfill ataylab yo'q: o'sha
  /// kunlarning qog'ozida bu raqam umuman chiqmagan). Renderer NULL ko'rsa
  /// eski xulqqa qaytadi va `name` ni bosadi.
  receiptNo Int? @map("receipt_no")

  // References
  agentId               String? @map("agent_id") @db.Uuid
  agentAccountId        String? @map("agent_account_id") @db.Uuid
  organizationId        String? @map("organization_id") @db.Uuid
  organizationAccountId String? @map("organization_account_id") @db.Uuid
  storeId               String? @map("store_id") @db.Uuid
  customerOrderId       String? @map("customer_order_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  state      String    @default("draft") @db.VarChar(20)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()
  applicable Boolean   @default(false)

  // Total + payment split. moysklad allows multiple split components on a
  // single retail receipt — we store all of them for parity. Legacy
  // names (cashAmountMinor, cardAmountMinor) preserved alongside the
  // moysklad-style sums to avoid a destructive migration; canonical aliases:
  //   cashAmountMinor = cash portion (gap-tool maps `cashSum` → here)
  //   cardAmountMinor = card portion (legacy; new code should write
  //                     noCashSumMinor too — it's an additive field)
  //   qrSumMinor      = QR-payment portion (Click/Humo QR)
  //   advancePaymentSumMinor = customer credit / store credit applied
  //   prepaymentCashSum / prepaymentNoCashSum / prepaymentQrSum
  //                          = pre-paid amounts redeemed at this sale
  //   payedSumMinor          = total actually paid (computed)
  //   changeMinor            = cash change returned to customer
  //   vatSumMinor            = VAT portion of the receipt
  sumMinor                 BigInt @default(0) @map("sum_minor")
  payedSumMinor            BigInt @default(0) @map("payed_sum_minor")
  cashAmountMinor          BigInt @default(0) @map("cash_amount_minor")
  cardAmountMinor          BigInt @default(0) @map("card_amount_minor")
  noCashSumMinor           BigInt @default(0) @map("no_cash_sum_minor")
  qrSumMinor               BigInt @default(0) @map("qr_sum_minor")
  advancePaymentSumMinor   BigInt @default(0) @map("advance_payment_sum_minor")
  prepaymentCashSumMinor   BigInt @default(0) @map("prepayment_cash_sum_minor")
  prepaymentNoCashSumMinor BigInt @default(0) @map("prepayment_no_cash_sum_minor")
  prepaymentQrSumMinor     BigInt @default(0) @map("prepayment_qr_sum_minor")
  changeMinor              BigInt @default(0) @map("change_minor")
  vatSumMinor              BigInt @default(0) @map("vat_sum_minor")
  /// SALES-04 — qaytarish chekida (mirror) qarz hisobidan yopilgan ulush.
  /// Qarzga sotilgan chek qaytarilganda pul kassadan CHIQMAYDI: mijozning
  /// balansidagi qarz shu summaga kamayadi. Sotuv chekida doim 0.
  /// Ketma-ket qisman qaytarishlarning kumulyativ chegarasi shu ustundan
  /// hisoblanadi (`computeRefundSettlementCaps`).
  debtReturnMinor          BigInt @default(0) @map("debt_return_minor")

  vatEnabled  Boolean @default(true) @map("vat_enabled")
  vatIncluded Boolean @default(false) @map("vat_included")
  // Per-receipt tax-system override (USN/OSN/...). Null = inherit org.
  taxSystem   String? @map("tax_system") @db.VarChar(30)

  // Currency + rate (UZS at rate=1 by default; multi-currency POS rare)
  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  // Refund link (RetailSale can refund another RetailSale)
  refundedFromId String? @map("refunded_from_id") @db.Uuid

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version Int @default(1)

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner               Employee?            @relation("RetailSaleOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group               Group?               @relation("RetailSaleGroup", fields: [groupId], references: [id], onDelete: SetNull)
  session             CashierSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  agent               Counterparty?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentAccount        CounterpartyAccount? @relation("RetailSaleAgentAccount", fields: [agentAccountId], references: [id], onDelete: SetNull)
  organization        Organization?        @relation("RetailSaleOrg", fields: [organizationId], references: [id], onDelete: SetNull)
  organizationAccount OrganizationAccount? @relation("RetailSaleOrgAccount", fields: [organizationAccountId], references: [id], onDelete: SetNull)
  store               Store?               @relation("RetailSaleStore", fields: [storeId], references: [id], onDelete: SetNull)
  customerOrder       CustomerOrder?       @relation("RetailSaleCustomerOrder", fields: [customerOrderId], references: [id], onDelete: SetNull)
  refundedFrom        RetailSale?          @relation("RetailSaleRefund", fields: [refundedFromId], references: [id], onDelete: SetNull)
  refunds             RetailSale[]         @relation("RetailSaleRefund")
  positions           RetailSalePosition[]
  payments            RetailSalePayment[]
  retailSalesReturns  RetailSalesReturn[]  @relation("RetailSalesReturnSource")
  /// G3 — shu chekdan omborda qabul qilingan vozvratlar (ВП- hujjatlari).
  salesReturns        SalesReturn[]        @relation("SalesReturnFromRetailSale")
  /// K4 — shu chek uchun omborda kesilgan bo'laklar (mijoz oldida turgani).
  reservedPieces      StockPiece[]         @relation("StockPieceReservedSale")

  @@unique([accountId, name])
  @@index([accountId, sessionId, state])
  @@index([accountId, state, moment(sort: Desc)])
  @@index([accountId, customerOrderId])
  // PERF-12 (faza 25) — the «Покупатели» counterparty tab runs
  // `id IN (SELECT agent_id FROM retail_sales WHERE agent_id IS NOT NULL)`;
  // unindexed that is a seq scan of the fastest-growing table in a POS
  // business. Single-column (the subquery carries no account_id, and it also
  // serves the RI scan when a counterparty is deleted).
  @@index([agentId])
  @@map("retail_sales")
}

/// RetailSalePayment — kassa TZ §6: bitta chek bir NECHA to'lov turi bilan
/// yopilishi mumkin (500 000 naqd + 300 000 plastik + qolgani qarz).
///
/// Nega kerak bo'ldi: `/sotuv` to'lov oynasi allaqachon to'rtta turni
/// yuborardi (naqd · karta · terminal · qarz), server esa faqat ikkitasini
/// bilardi — terminal orqali to'langan chek 400 «Payment insufficient» olardi.
/// Ya'ni bu jadval yangi imkoniyat emas, avvalo mavjud interfeysning
/// serverdagi juftligi.
///
/// `RetailSale.cashAmountMinor` / `cardAmountMinor` ustunlari O'CHIRILMAYDI —
/// ular endi shu qatorlardan HISOBLANADI (TZ §6.3), shunda eski hisobotlar va
/// `moysklad-compat` qatlami buzilmaydi.
///
/// `method` — VarChar, Postgres enum EMAS (sxema bo'ylab konventsiya:
/// RetailSale.state, RestockTask.status). Yangi kanal (CLICK/PAYME/QR)
/// migratsiyasiz qo'shiladi. Hozir yozib turilganlari:
///   CASH_UZS · CASH_USD · CARD · TERMINAL · DEBT
/// `CASH_USD` (F5, 2026-08-11) ULANDI: kassa ekrani kunlik kursni
/// `GET /exchange-rates/rate` dan oladi, u `rateMinor` ga MUZLATILADI va
/// kurs topilmasa to'lov BLOKLANADI (jim 1:1 qabul qilish taqiqlanadi).
/// TZ'da rejalashtirilgan, hali ULANMAGAN: CLICK, PAYME, QR.
model RetailSalePayment {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  saleId    String @map("sale_id") @db.Uuid

  method          String  @db.VarChar(20)
  /// To'lov valyutasidagi summa (tiyin/sent).
  amountMinor     BigInt  @map("amount_minor")
  currency        String  @default("UZS") @db.VarChar(3)
  /// `CASH_USD` uchun qo'llanilgan kurs — chekka MUZLATILADI (kurs keyin
  /// o'zgarsa, eski chek qayta baholanmasin). UZS to'lovda NULL.
  /// Masshtab: KANONIK ×10^8 (DB-01, Faza 16) — rateValue bilan bir xil.
  /// Yozuvchi: `retail-sale.service.ts` `post()` (F5 dan beri CASH_USD
  /// qatorlari uchun). Eski qatorlarda NULL — backfill kerak emas
  /// (ular so'm to'lovlari, kursi yo'q).
  rateMinor       BigInt? @map("rate_minor")
  /// Hisob valyutasiga (UZS) o'girilgan summa — BARCHA hisob-kitob shundan.
  /// UZS to'lovda `amountMinor` bilan teng.
  amountBaseMinor BigInt  @map("amount_base_minor")
  /// Terminal chek raqami / Click tranzaksiya id — nizoli holatda izlash uchun.
  reference       String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sale    RetailSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([accountId, saleId])
  // «Shu smenada terminal orqali qancha tushdi» — Z-hisobot savoli (TZ §8.5).
  @@index([accountId, method, createdAt(sort: Desc)])
  @@map("retail_sale_payments")
}

/// RetailSalePosition — single line on a POS receipt.
model RetailSalePosition {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  retailSaleId String  @map("retail_sale_id") @db.Uuid
  productId    String? @map("product_id") @db.Uuid
  position     Int     @default(0)
  quantity     Decimal @db.Decimal(20, 6)
  priceMinor   BigInt  @map("price_minor")
  discount     Decimal @default(0) @db.Decimal(5, 2)
  sumMinor     BigInt  @map("sum_minor")

  // ── Frozen price snapshot (written once, at post() — kassa TZ §5.3) ────────
  // Why frozen and not read live: the product card's buyPrice / sale prices are
  // edited over time. A profit report re-derived from TODAY's product card would
  // silently rewrite LAST MONTH's numbers. These two columns pin the figures the
  // receipt was actually sold against.
  //   costMinor      = Product.buyPrice at the moment of post()
  //   basePriceMinor = the default («Розничная цена») tier at the moment of post()
  // NULL is meaningful and NOT the same as 0: it means "never collected" — either
  // the receipt predates this migration, or the product had no such price. Cost
  // reports must render NULL as «tan narx yig'ilmagan», never as zero cost (that
  // is exactly the 100%-margin lie profitability.service currently tells).
  // Currency: the raw as-entered minor value, consistent with
  // Product.buyPriceCurrency / salePrices[].currencyCode — app-wide multi-currency
  // cost math is future work (see the note on Product.buyPriceCurrency).
  costMinor      BigInt? @map("cost_minor")
  basePriceMinor BigInt? @map("base_price_minor")

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  retailSale RetailSale @relation(fields: [retailSaleId], references: [id], onDelete: Cascade)
  product    Product?   @relation("RetailSalePositionProduct", fields: [productId], references: [id], onDelete: Restrict)

  /// K4 — KASSIRNING mijoz bilan kelishgan bo'lak tarkibi: «150+30».
  ///
  /// Nega ustun, jadval emas: bu O'LCHOV emas, KELISHUV matni. Haqiqiy
  /// bo'laklar `stock_pieces.reservedPositionId` orqali biriktiriladi (ular
  /// omborchi kesgach paydo bo'ladi) — bu ustun esa omborchiga «nimani kesish
  /// kerak» deb aytadi. K3 uni faqat savatda saqlardi va omborga yetib
  /// bormasdi (K3 hisobotining «ASOSIY qarz» bandi).
  ///
  /// Format: «+» bilan ajratilgan uzunliklar («150+30»), `piece-cut-core.ts`
  /// dagi `parsePieceLengths`/`formatPieceLengths` yagona o'quvchi-yozuvchisi.
  /// NULL — oddiy tovar yoki bo'linmagan qator.
  pieceLengths String? @map("piece_lengths")

  /// G4 — bu qator qaysi ombor(lar)ning qaysi yacheyka(lar)idan olinishi.
  allocations RetailSalePositionAllocation[]
  /// K4 — shu qator uchun kesilgan jismoniy bo'laklar.
  pieces      StockPiece[]                  @relation("StockPieceReservedPosition")
  /// K4 — shu qatorga bog'langan yig'ish topshirig'i qatorlari.
  restockLines RestockTaskLine[]            @relation("RestockLinePosition")

  @@index([retailSaleId, position])
  @@index([accountId, productId])
  @@map("retail_sale_positions")
}

/// G4 (Q1-v2, 2026-08-24) — chek qatorining KO'P OMBORLI taqsimoti.
///
/// Nega alohida jadval, ustun emas: egasining 3-qoidasi bitta pozitsiyani BIR
/// NECHTA yacheykaga bo'lishi mumkin («hech bir yacheyka yolg'iz qoplamasa —
/// bo'linadi»), ya'ni `RetailSalePosition.cellId` degan yagona ustun uni
/// ifodalay olmaydi. Bu jadval rezerv, yig'ish topshirig'i va `post()`
/// deltalari uchun YAGONA haqiqat manbai bo'ladi.
///
/// `cellId` NULL bo'lishi ATAYLAB: jonlida qoldiqning ~94 % i hech bir
/// yacheykaga biriktirilmagan (E1) — u holda manba «ombor darajasidagi
/// yacheykasiz qoldiq» bo'ladi va omborchiga aniq manzil ko'rsatilmaydi.
model RetailSalePositionAllocation {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  positionId String  @map("position_id") @db.Uuid
  storeId    String  @map("store_id") @db.Uuid
  /// NULL = ombor darajasidagi yacheykasiz qoldiqdan (E1).
  cellId     String? @map("cell_id") @db.Uuid

  qty Decimal @db.Decimal(20, 6)

  /// Kassir avto-taqsimotni QO'LDA o'zgartirgan (Q1-v2: «kassir o'zgartira oladi»).
  /// Qayta hisoblashda qo'lda tanlangan qatorlar saqlanadi.
  manual Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  position RetailSalePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  // Restrict: taqsimoti bor ombor jimgina o'chib ketmasin (qoldiq izi).
  store    Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // SetNull: yacheyka o'chsa taqsimot qoladi — ombor darajasiga tushadi.
  cell     StoreCell?         @relation(fields: [cellId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([accountId, storeId, cellId])
  @@map("retail_sale_position_allocations")
}

// =========================================================================
// E-commerce / Online Sales
// =========================================================================

/// SalesChannel — outbound sales connector. Each channel represents a
/// connection to an external storefront (e.g. Telegram bot, Instagram
/// shop, custom site). Orders sync IN, products sync OUT.
model SalesChannel {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  ownerId      String?   @map("owner_id") @db.Uuid
  groupId      String?   @map("group_id") @db.Uuid
  name         String    @db.VarChar(255)
  code         String?   @db.VarChar(50)
  externalCode String?   @map("external_code") @db.VarChar(50)
  description  String?
  /// 'telegram' | 'instagram' | 'website' | 'marketplace_uzum' |
  /// 'marketplace_olcha' | 'custom'
  kind         String    @db.VarChar(30)
  /// moysklad's `type` enum field — narrower than our `kind`. Mirrors
  /// MESSENGER / SOCIAL_NETWORK / MARKETPLACE / ECOMMERCE / OTHER. Kept
  /// alongside kind for direct serialisation parity.
  type         String?   @db.VarChar(30)
  /// External handle / shop URL / bot username — display only
  externalRef  String?   @map("external_ref") @db.VarChar(500)
  /// Connection settings as JSON (api keys are out-of-band — store
  /// only meta here; tokens go in env)
  settings     Json?
  shared       Boolean   @default(false)
  archived     Boolean   @default(false)
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz()
  lastSyncOk   Boolean?  @map("last_sync_ok")
  lastSyncMsg  String?   @map("last_sync_msg")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Optimistic concurrency version (moysklad parity). See Product.version.
  version      Int       @default(1)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner          Employee?       @relation("SalesChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group          Group?          @relation("SalesChannelGroup", fields: [groupId], references: [id], onDelete: SetNull)
  orders         OnlineOrder[]
  demands        Demand[]
  customerOrders CustomerOrder[] @relation("CustomerOrderSalesChannel")
  invoicesOut    InvoiceOut[]    @relation("InvoiceOutSalesChannel")
  salesReturns   SalesReturn[]   @relation("SalesReturnSalesChannel")
  cashIns        CashIn[]        @relation("CashInSalesChannel")
  cashOuts       CashOut[]       @relation("CashOutSalesChannel")
  paymentsIn     PaymentIn[]     @relation("PaymentInSalesChannel")
  paymentsOut    PaymentOut[]    @relation("PaymentOutSalesChannel")

  @@index([accountId, archived])
  @@index([accountId, kind])
  @@map("sales_channels")
}

/// OnlineOrder — incoming order from a SalesChannel. Sits in 'pending'
/// until a staff member converts it into a CustomerOrder + Demand.
/// V1 only persists the row; the convert action is a no-op stub.
model OnlineOrder {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  channelId       String   @map("channel_id") @db.Uuid
  externalOrderId String   @map("external_order_id") @db.VarChar(100)
  customerName    String?  @map("customer_name") @db.VarChar(255)
  customerPhone   String?  @map("customer_phone") @db.VarChar(20)
  customerAddress String?  @map("customer_address")
  sumMinor        BigInt   @default(0) @map("sum_minor")
  currency        String   @default("UZS") @db.VarChar(3)
  /// Free-form JSON cart from the storefront — array of {name, qty, price}
  items           Json?
  /// 'pending' | 'accepted' | 'rejected' | 'converted'
  state           String   @default("pending") @db.VarChar(20)
  /// CustomerOrder.id once converted
  customerOrderId String?  @map("customer_order_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalOrderId])
  @@index([accountId, state, receivedAt(sort: Desc)])
  @@index([accountId, channelId, state])
  @@map("online_orders")
}

// =========================================================================
// Apps Marketplace
// =========================================================================

/// AppInstall — entry in the in-app marketplace. V1 = static catalog
/// of "available integrations" with install state. No actual code
/// execution — install flips a flag and shows config.
model AppInstall {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  /// 'telegram_bot' | 'sms_eskiz' | 'webhook_export' | 'soliq_bot' |
  /// 'crm_amocrm' | 'analytics_metrika'
  appKey      String   @map("app_key") @db.VarChar(50)
  enabled     Boolean  @default(false)
  config      Json?
  installedAt DateTime @default(now()) @map("installed_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, appKey])
  @@map("app_installs")
}

// =========================================================================
// Sprint 12.5 — CBRU exchange rates (UZ Tier-1)
// =========================================================================

/// Daily exchange rate snapshot vs UZS, fetched from cbu.uz public API.
/// Stored at the global (account-less) level since the central-bank rate
/// is the same for everyone — saves N×rows per tenant. Per-tenant manual
/// overrides (e.g. internal rate margin) live elsewhere (V2).
///
/// Rate is stored as Decimal(20,6) since CBRU publishes 4–6 decimal digits.
/// Convention: rate × amount(currency) / nominal = amount(UZS).
model ExchangeRate {
  /// Date this rate is effective FOR (the rate published on D applies for D).
  /// CBRU publishes weekday-only; consumers carry forward (last-known) on weekends.
  date      DateTime @db.Date
  currency  String   @db.VarChar(3)
  rate      Decimal  @db.Decimal(20, 6)
  /// Source identifier — 'CBRU' for the central-bank feed. Future sources
  /// (CB user override, parallel-market) discriminate via this column.
  source    String   @default("CBRU") @db.VarChar(20)
  /// CBRU's nominal divisor — currencies like KRW quote per-1000.
  nominal   Int      @default(1)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz()

  @@id([date, currency, source])
  @@index([currency, date(sort: Desc)])
  @@map("exchange_rates")
}

// =========================================================================
// Sprint 12.6 — MXIK (UZ tax classifier)
// =========================================================================

/// MXIK = Mahsulot va xizmatlarning xalq ro'yxati — Uzbekistan's mandatory
/// tax classifier code. Every VAT-bearing line item on a tax invoice must
/// reference one MXIK. The official catalog is published by Soliq (tax
/// authority) at tasnif.soliq.uz; ~250k entries spanning all goods and
/// services. We cache it locally so invoice forms can autocomplete without
/// hitting an external API on every keystroke.
///
/// Stored at the global (account-less) level — the catalog is the same for
/// every tenant. Authoritative source is Soliq; the `source` column lets a
/// future tenant override (custom internal codes) layer above without
/// stepping on the imported rows.
///
/// V1 scope: manual entry + CSV bulk-import. The auto-sync against
/// tasnif.soliq.uz is a follow-up because their public endpoint requires
/// merchant authentication — V1.5 will wire it once credentials are
/// provisioned.
model MxikCode {
  /// 17-digit Soliq classifier code (always exactly 17 chars, decimal).
  code String @id @db.VarChar(17)

  /// Localized names — UZ Latin is canonical for the UI; Russian is the
  /// most common cyrillic locale in older invoices. English is best-effort.
  nameUz String  @map("name_uz") @db.VarChar(500)
  nameRu String? @map("name_ru") @db.VarChar(500)
  nameEn String? @map("name_en") @db.VarChar(500)

  /// Unit-of-measure code from the Soliq UoM catalog (e.g. '796' = piece).
  /// Free-form here because the UoM catalog itself is a separate table V1.5.
  unitCode String? @map("unit_code") @db.VarChar(20)

  /// Group / class hierarchy. The 17-digit code is itself hierarchical
  /// (first 4 = section, next 4 = group, etc.); we denormalize the parent
  /// chain into these strings so search-by-section is a simple LIKE.
  groupCode String? @map("group_code") @db.VarChar(17)
  classCode String? @map("class_code") @db.VarChar(17)

  /// Where this row came from — 'soliq' for the imported catalog, 'manual'
  /// for tenant-specific custom additions, 'override' for tenant overrides
  /// of an imported row. V1 only writes 'manual' (CSV import via the UI).
  source String @default("manual") @db.VarChar(20)

  /// Soft-archive — Soliq retires codes occasionally; we keep the row so
  /// historical invoices still resolve, just hide it from autocomplete.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([archived, nameUz])
  @@index([groupCode])
  @@map("mxik_codes")
}

/// AttributeMetadata — configurable custom field definitions per entity type.
///
/// Mirrors moysklad's "Дополнительные поля" — admins create new fields per
/// entity (Counterparty, Product, CustomerOrder, Demand, ...) and each
/// document/entity then stores its values in its own `attributes Json`
/// column. The metadata row is the source of truth for type, required-ness,
/// enum options, and reference target.
///
/// Field codes are unique per (account, entity). The code is what the
/// `attributes` JSON keys against; renaming `name` is safe, renaming `code`
/// requires a migration of existing values.
model AttributeMetadata {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Target entity type — must match one of the documented entity names:
  /// "Counterparty" | "Product" | "Variant" | "Bundle" | "Service" |
  /// "ProductFolder" | "CustomerOrder" | "Demand" | "InvoiceOut" |
  /// "SalesReturn" | "PurchaseOrder" | "Supply" | "InvoiceIn" |
  /// "PurchaseReturn" | "Move" | "Loss" | "Enter" | "Inventory" |
  /// "PaymentIn" | "PaymentOut" | "CashIn" | "CashOut" | "Project" |
  /// "Contract" | "Employee" | "Organization" | "Store" | "ProcessingPlan" |
  /// "RetailSale" | "InternalOrder" | "Prepayment" | "PriceList".
  entity String @db.VarChar(50)

  /// Machine name — used as the JSON key in entity.attributes.
  /// Lowercase, alphanumeric + underscore. Cannot be changed once created.
  code String @db.VarChar(50)

  /// Human label shown in UI (Uzbek/Russian).
  name String @db.VarChar(255)

  /// Field type:
  ///   "string" | "text" | "long" | "double" | "boolean" | "date" |
  ///   "file" | "link" | "enum" | "reference"
  type String @db.VarChar(20)

  /// Whether the field is required. Validated server-side on create/update.
  required Boolean @default(false)

  /// Default value when not provided. JSON-encoded so it works for any type.
  defaultValue Json? @map("default_value")

  /// Optional help text shown under the input.
  description String?

  /// For type="enum" — array of { value, label } options.
  /// For type="reference" — set referenceEntity instead.
  enumOptions Json? @map("enum_options")

  /// For type="reference" — entity name being referenced ("Counterparty",
  /// "Product", "CustomEntity", ...). Validated against entity allowlist.
  referenceEntity String? @map("reference_entity") @db.VarChar(50)

  /// For type="reference" with referenceEntity="CustomEntity" — the
  /// specific CustomEntity dictionary id. The value JSON stores the
  /// CustomEntityValue id.
  customEntityId String? @map("custom_entity_id") @db.Uuid

  /// Sort position within the entity's attribute list.
  position Int @default(0)

  /// Hide from create/edit forms but keep historical values addressable.
  archived Boolean @default(false)

  /// Show in subaccounts (multi-tenant features moysklad has — currently
  /// always per-account here, but kept for forward compatibility).
  shared Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([accountId, entity, code])
  @@index([accountId, entity, archived, position])
  @@map("attribute_metadata")
}

// =========================================================================
// Sprint 20 — Service Desk (Заявки)
// =========================================================================

/// Service request / customer ticket. moysklad-equivalent: "Заявка".
/// Customer-facing support flow with SLA + assignment + audit trail.
///
/// FSM:
///   new → in_progress (manual; assignee picks up)
///   in_progress → waiting_customer (need more info)
///   waiting_customer → in_progress
///   in_progress | waiting_customer → resolved
///   resolved → closed (after grace window or customer confirmation)
///   any → cancelled (drop request without resolution)
model ServiceRequest {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  /// Auto-numbered: ZP-YYYY-NNNNN ("Заявка").
  name         String  @db.VarChar(100)
  externalCode String? @map("external_code") @db.VarChar(50)

  /// Subject line shown in lists / notifications.
  subject     String  @db.VarChar(500)
  description String?

  /// Counterparty who raised the ticket. Nullable for internal tickets.
  counterpartyId  String? @map("counterparty_id") @db.Uuid
  contactPersonId String? @map("contact_person_id") @db.Uuid

  /// Current owner / responder.
  assigneeId String? @map("assignee_id") @db.Uuid

  /// 'phone' | 'email' | 'chat' | 'in_person' | 'web_form' | 'other'
  channel  String @default("other") @db.VarChar(20)
  /// 'low' | 'normal' | 'high' | 'critical'
  priority String @default("normal") @db.VarChar(20)
  /// 'new' | 'in_progress' | 'waiting_customer' | 'resolved' | 'closed' | 'cancelled'
  status   String @default("new") @db.VarChar(30)

  /// SLA target — when this ticket should be resolved by.
  dueDate    DateTime? @map("due_date") @db.Timestamptz()
  /// Set when status moves to 'resolved'.
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()
  /// Set when status moves to 'closed'.
  closedAt   DateTime? @map("closed_at") @db.Timestamptz()

  attributes Json?    @default("{}")
  tags       String[] @default([])

  shared   Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner         Employee?      @relation("ServiceRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignee      Employee?      @relation("ServiceRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  group         Group?         @relation("ServiceRequestGroup", fields: [groupId], references: [id], onDelete: SetNull)
  counterparty  Counterparty?  @relation("ServiceRequestCp", fields: [counterpartyId], references: [id], onDelete: SetNull)
  contactPerson ContactPerson? @relation("ServiceRequestContact", fields: [contactPersonId], references: [id], onDelete: SetNull)

  @@unique([accountId, name])
  /// Hot path: active queue ordered by SLA.
  @@index([accountId, status, dueDate])
  /// Per-assignee list view.
  @@index([accountId, assigneeId, status])
  /// Per-counterparty history (customer-portal lookup).
  @@index([accountId, counterpartyId, createdAt(sort: Desc)])
  @@map("service_requests")
}

// =========================================================================
// Sprint 21 — Print template editor
// =========================================================================

/// Custom print template — moysklad's "Шаблоны печатных форм".
///
/// Per-account override of the default Handlebars-style template body
/// for a given document type. When a doc is printed, PrintService looks
/// for a template here matching (entity, format) — falls back to the
/// hardcoded default when none exists. Operators can clone, edit, and
/// disable per-account.
model PrintTemplate {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid

  /// Document discriminator: 'invoiceout' | 'demand' | 'customerorder' | ...
  /// Lowercase moysklad slugs (matches Webhook entityType convention).
  entity String @db.VarChar(40)
  /// Output format: 'pdf' | 'docx' | 'html' | 'txt'.
  format String @default("pdf") @db.VarChar(10)

  name        String  @db.VarChar(255)
  description String?

  /// Handlebars-flavoured template source. Variables resolved at render
  /// time from the document context: {{order.number}}, {{customer.name}},
  /// {{#each positions}}, etc. See docs/print-template-vars.md.
  bodyHtml String @map("body_html")

  /// Template content (binary) when uploaded as DOCX. Mutually exclusive
  /// with bodyHtml — operator picks one editor mode at create time.
  bodyDocx Bytes? @map("body_docx")

  /// Page size + margins for PDF rendering.
  pageSize     String @default("A4") @map("page_size") @db.VarChar(10)
  marginTop    Int    @default(20) @map("margin_top")
  marginRight  Int    @default(15) @map("margin_right")
  marginBottom Int    @default(20) @map("margin_bottom")
  marginLeft   Int    @default(15) @map("margin_left")

  /// Default template for its (entity, format) pair — only one per pair.
  /// Set true to override the system default; when this row is disabled
  /// or deleted, the system default re-takes over.
  isDefault Boolean @default(false) @map("is_default")
  enabled   Boolean @default(true)
  archived  Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Lookup at print time: pick the enabled, default template for (entity,format).
  @@index([accountId, entity, format, enabled, isDefault])
  @@index([accountId, archived])
  @@map("print_templates")
}

// =========================================================================
// Sprint 22 — Help drawer / knowledge base
// =========================================================================

/// Help article — context-aware doc shown in the right-side help drawer.
/// Per-account so operators can localise / supplement the system articles.
/// Articles are rendered as Markdown; the drawer surfaces by route key.
model HelpArticle {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Stable slug — referenced from the UI via Help.openArticle('demand-post').
  slug String @db.VarChar(120)

  /// Optional route-key match — when the user is on a path matching this
  /// pattern (substring match), the drawer shows this article first.
  /// Examples: '/demands', '/customer-orders/[id]', '/settings/email'.
  routeKey String? @map("route_key") @db.VarChar(120)

  /// 'uz' | 'ru' — same article slug, different locales.
  locale String @default("uz") @db.VarChar(8)

  title    String   @db.VarChar(255)
  /// Markdown body — rendered with light prose styling in the drawer.
  bodyMd   String   @map("body_md")
  /// Sort key inside its category section.
  position Int      @default(0)
  category String?  @db.VarChar(80)
  tags     String[] @default([])

  enabled  Boolean @default(true)
  archived Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, slug, locale])
  @@index([accountId, routeKey, enabled, locale])
  @@index([accountId, category, position])
  @@map("help_articles")
}

// =========================================================================
// Sprint 23 — Onboarding wizard
// =========================================================================

/// Per-account onboarding progress tracker. One row per account, written
/// once on first login and updated as the user completes each wizard step.
/// The web app reads this on /dashboard mount and resumes the wizard if
/// not all steps are done.
///
/// Steps (string keys for forward compat — schema doesn't enforce):
///   organization · currency · store · first_product · first_counterparty ·
///   first_sale · email_setup · skipped
model OnboardingProgress {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// Which step the user is currently on (or 'done' / 'skipped' terminal).
  currentStep    String   @default("organization") @map("current_step") @db.VarChar(40)
  /// Steps completed so far (allows out-of-order completion).
  completedSteps String[] @default([]) @map("completed_steps")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  skippedAt   DateTime? @map("skipped_at") @db.Timestamptz()

  /// User who started the wizard (creator/admin of the tenant).
  startedById String? @map("started_by_id") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

// =========================================================================
// Sprint 26b — Eskiz SMS integration
// =========================================================================

/// Per-account Eskiz SMS provider config. Eskiz is a UZ SMS aggregator
/// (eskiz.uz) that issues a JWT-bearer-style token after email/password
/// auth; our service stores the token + auto-refreshes when 401 hits.
model SmsConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// 'eskiz' | 'playmobile' | 'custom' — extensible for future UZ providers.
  provider String @default("eskiz") @db.VarChar(20)

  /// Eskiz login email.
  email          String @db.VarChar(255)
  /// Eskiz password (AES-encrypted at rest, same crypto helpers as EmailConfig).
  passwordCipher String @map("password_cipher") @db.VarChar(500)

  /// Optional sender alphanumeric ID (3–11 chars). Eskiz default is the
  /// caller's verified sender; null = use account default.
  senderId String? @map("sender_id") @db.VarChar(20)

  /// Cached bearer token from /api/auth/login. Refreshed lazily on 401.
  token         String?   @db.VarChar(2000)
  tokenIssuedAt DateTime? @map("token_issued_at") @db.Timestamptz()

  /// Last health-check stamp + verdict (for the settings page badge).
  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("sms_configs")
}

/// SMS delivery log + retry queue (mirrors EmailLog pattern).
///
///   pending → sent | dead
///   Sequential cron worker drains pending (every 30s, BATCH_LIMIT=20).
///   Backoff: 0 / 1m / 5m / 15m / 1h.
model SmsLog {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  senderId  String? @map("sender_id") @db.Uuid

  entity   String? @db.VarChar(50)
  entityId String? @map("entity_id") @db.Uuid

  /// Destination phone in E.164 (+998901234567).
  toPhone String @map("to_phone") @db.VarChar(20)
  body    String @db.VarChar(1600)

  /// 'pending' | 'sending' | 'sent' | 'dead' | 'failed' (legacy inline path).
  /// 'sending' = exclusive worker claim, provider call in flight; `next_retry_at`
  /// is the claim lease (Faza 28, see api `shared/outbox-claim.ts`).
  status      String @default("pending") @db.VarChar(20)
  attempt     Int    @default(1)
  maxAttempts Int    @default(4) @map("max_attempts")

  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz()
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz()
  sentAt      DateTime? @map("sent_at") @db.Timestamptz()

  /// Provider-side message id (Eskiz returns it on accept).
  providerMessageId String? @map("provider_message_id") @db.VarChar(100)
  errorMsg          String? @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sender  Employee? @relation("SmsLogSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([accountId, entity, entityId, createdAt(sort: Desc)])
  @@map("sms_logs")
}

// =========================================================================
// Sprint 27 — Soliq.uz EDO (E-Hujjat / Faktura)
// =========================================================================

/// Per-account EDO configuration. Soliq.uz is the UZ tax authority's
/// electronic-document portal; we authenticate via ECP (Electronic
/// Digital Signature) PFX file uploaded once per account.
model EdoConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// Org STIR (TIN) — must match ECP cert subject; Soliq rejects mismatches.
  stir        String @db.VarChar(20)
  /// Org name (Cyrillic short name as registered with Soliq).
  orgNameCyrl String @map("org_name_cyrl") @db.VarChar(255)

  /// 'didox' | 'edocs' | 'soliq_direct' — picks the gateway provider.
  /// Most tenants use Didox.uz which fronts Soliq's PKI.
  provider String @default("didox") @db.VarChar(20)

  /// Provider API URL (sandbox vs prod — tenant-controlled).
  apiBaseUrl     String  @map("api_base_url") @db.VarChar(255)
  /// API token issued by the provider (encrypted at rest).
  apiTokenCipher String? @map("api_token_cipher") @db.VarChar(2000)

  /// ECP PFX bytes (encrypted with EDO_PFX_KEY env). Used by SignerService
  /// to produce GOST signatures over EHF XML payloads.
  pfxCipher     Bytes?  @map("pfx_cipher")
  /// PFX unlock password (encrypted, same crypto helpers as EmailConfig).
  pfxPassCipher String? @map("pfx_pass_cipher") @db.VarChar(500)

  /// Test-mode marker — submissions go to provider sandbox endpoint.
  testMode Boolean @default(true) @map("test_mode")

  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("edo_configs")
}

/// EDO submission record — one row per outbound EHF (electronic invoice).
/// FSM: draft → signed → sent → delivered → confirmed | rejected.
/// Cancellation: cancelled (after delivered, by buyer/seller mutual ack).
model EdoSubmission {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Source document: usually FactureOut (счёт-фактура), sometimes Demand.
  sourceEntity   String @map("source_entity") @db.VarChar(50)
  sourceEntityId String @map("source_entity_id") @db.Uuid

  /// Provider-assigned EHF ID (returned on submit). Null until the
  /// provider accepts the signed payload.
  providerEhfId String? @map("provider_ehf_id") @db.VarChar(100)
  /// Provider-side numeric/QR identifier shown to the buyer.
  ehfNumber     String? @map("ehf_number") @db.VarChar(100)

  /// 'draft' | 'signed' | 'sent' | 'delivered' | 'confirmed' | 'rejected' | 'cancelled'
  status String @default("draft") @db.VarChar(20)

  /// XML body sent to the provider (signed if status >= 'signed').
  xmlBody      String? @map("xml_body")
  /// Detached signature (base64) returned by the signer.
  signatureB64 String? @map("signature_b64")

  signedAt    DateTime? @map("signed_at") @db.Timestamptz()
  sentAt      DateTime? @map("sent_at") @db.Timestamptz()
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz()
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz()

  /// Provider rejection reason or our local validation error.
  errorMsg    String? @map("error_msg")
  /// Buyer's STIR (target party); cached for indexing/reporting.
  buyerStir   String? @map("buyer_stir") @db.VarChar(20)
  /// Provider response payload (audit trail).
  providerLog Json?   @map("provider_log")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, sourceEntity, sourceEntityId])
  @@index([accountId, status, createdAt(sort: Desc)])
  @@index([providerEhfId])
  @@map("edo_submissions")
}

// =========================================================================
// Sprint 28 — ASL Belgisi (UZ markirovka)
// =========================================================================

/// Per-account ASL Belgisi config. ASL Belgisi (aslbelgisi.uz) is the
/// UZ government goods-marking system: every regulated SKU (alcohol,
/// tobacco, pharma, water, footwear, dairy) needs a unique GS1
/// DataMatrix code on its packaging. We track issued codes + their
/// lifecycle (allocated → applied → sold → retired/returned).
model MarkingConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// Org STIR — same as EDO, must match the merchant registered with
  /// ASL Belgisi.
  stir           String  @db.VarChar(20)
  /// Provider API URL — sandbox vs prod (tenant-controlled).
  apiBaseUrl     String  @map("api_base_url") @db.VarChar(255)
  /// API token (AES-encrypted).
  apiTokenCipher String? @map("api_token_cipher") @db.VarChar(2000)

  /// Test-mode marker — uses ASL Belgisi sandbox.
  testMode Boolean @default(true) @map("test_mode")

  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("marking_configs")
}

/// One marking code (DataMatrix string ~31-44 chars). Tracked through
/// its lifecycle: allocated → applied → sold | retired | returned.
model MarkingCodeRecord {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Which product this code is bound to (null until 'applied').
  productId String? @map("product_id") @db.Uuid
  /// Optional variant (modification) — for SKUs with size/color matrix.
  variantId String? @map("variant_id") @db.Uuid

  /// Raw GS1 DataMatrix string (encoded with FNC1 separators).
  /// Format: 01<GTIN-14>21<serial>91<crypto-key>92<crypto-tail>
  code   String @db.VarChar(200)
  /// Parsed GTIN (item identifier — 14 digits).
  gtin   String @db.VarChar(20)
  /// Parsed serial portion (unique within the GTIN).
  serial String @db.VarChar(40)

  /// 'allocated' | 'applied' | 'sold' | 'returned' | 'retired' | 'rejected'
  status String @default("allocated") @db.VarChar(20)

  /// Source document references (polymorphic): for 'sold' it's the
  /// RetailDemand id; for 'retired' it's the RetireOrder id; etc.
  sourceEntity   String? @map("source_entity") @db.VarChar(40)
  sourceEntityId String? @map("source_entity_id") @db.Uuid

  /// Provider response payload — kept for audit / Soliq inspection.
  providerLog Json?   @map("provider_log")
  errorMsg    String? @map("error_msg")

  allocatedAt DateTime? @map("allocated_at") @db.Timestamptz()
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz()
  soldAt      DateTime? @map("sold_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@index([accountId, productId, status])
  @@index([accountId, status, createdAt(sort: Desc)])
  @@index([gtin, serial])
  @@map("marking_codes")
}

// =========================================================================
// Sprint 33 — Telegram bot integration
// =========================================================================

/// Per-account Telegram bot config. Bot tokens are issued by
/// @BotFather; one token per bot. The bot polls / receives webhooks
/// for incoming messages and sends outbound notifications via the
/// TelegramOutbox queue.
model TelegramConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  // Sherset KEEP (telegram business) — B3
  businessConnectionId String? @map("business_connection_id") @db.VarChar(64)
  businessUserId       BigInt? @map("business_user_id")
  businessUserName     String? @map("business_user_name") @db.VarChar(128)

  /// Bot token from BotFather (AES-encrypted).
  botTokenCipher String  @map("bot_token_cipher") @db.VarChar(500)
  /// Bot username — '@MyShopBot' (without @, as Telegram returns it).
  botUsername    String? @map("bot_username") @db.VarChar(50)

  /// Webhook URL Telegram pushes incoming messages to (we self-register
  /// it via setWebhook on save). Null = polling mode (legacy).
  webhookUrl    String? @map("webhook_url") @db.VarChar(500)
  /// HMAC secret for verifying inbound webhooks (Telegram includes
  /// X-Telegram-Bot-Api-Secret-Token header).
  webhookSecret String? @map("webhook_secret") @db.VarChar(255)

  /// Default chat to send broadcast notifications (admin group, channel).
  defaultChatId String? @map("default_chat_id") @db.VarChar(40)

  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz()
  lastTestOk   Boolean?  @map("last_test_ok")
  lastTestMsg  String?   @map("last_test_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("telegram_configs")
}

/// Outbound Telegram messages — same retry queue pattern as SMS/email.
model TelegramOutbox {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Telegram chat id — numeric (-100... for channels, positive for users).
  chatId    String @map("chat_id") @db.VarChar(40)
  /// Markdown / HTML / plain. Default 'HTML' so we can use bold/links.
  parseMode String @default("HTML") @map("parse_mode") @db.VarChar(20)
  text      String @db.VarChar(4096)

  /// 'pending' | 'sending' | 'sent' | 'dead' | 'failed'
  /// 'sending' = exclusive worker claim, Telegram API call in flight;
  /// `next_retry_at` is the claim lease (Faza 28, api `shared/outbox-claim.ts`).
  status      String @default("pending") @db.VarChar(20)
  attempt     Int    @default(1)
  maxAttempts Int    @default(4) @map("max_attempts")

  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz()
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz()
  sentAt      DateTime? @map("sent_at") @db.Timestamptz()

  /// Provider response message_id (for delete / reply tracking).
  providerMessageId String? @map("provider_message_id") @db.VarChar(40)
  errorMsg          String? @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("telegram_outbox")
}

// =========================================================================
// Sprint 29 — Payment gateways (Payme + Click + Uzcard/Humo)
// =========================================================================

/// Per-account configuration for a single payment gateway. One row per
/// (provider, accountId) — most accounts use one or two gateways. Each
/// provider has its own auth model captured in `credsJson` (encrypted).
model PaymentGatewayConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'payme' | 'click' | 'uzcard' | 'humo' | 'octo' | 'multicard'
  provider String @db.VarChar(20)
  /// Display label.
  name     String @db.VarChar(100)

  /// Provider's merchant id (Payme: merchant_id; Click: service_id; ...).
  merchantId  String @map("merchant_id") @db.VarChar(100)
  /// Encrypted credentials bag (provider-specific shape; AES-GCM).
  credsCipher String @map("creds_cipher") @db.VarChar(2000)

  /// Test-mode (sandbox endpoints).
  testMode Boolean @default(true) @map("test_mode")

  /// Webhook URL Payme/Click POST callbacks to. Stored for documentation
  /// + UI display; not strictly needed at runtime.
  callbackUrl String? @map("callback_url") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider])
  @@index([accountId, enabled])
  @@map("payment_gateway_configs")
}

/// One payment-gateway transaction. Lifecycle:
///   pending → authorized → captured | refunded | cancelled | failed
/// Each provider has slightly different terminology — we map them all
/// to this canonical FSM at the adapter layer.
model PaymentGatewayTx {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  provider     String  @db.VarChar(20)
  /// Provider's transaction id (Payme: id; Click: transaction_id).
  /// Unique per (account, provider) — see `@@unique` below. NULL only for
  /// operator-initiated rows (`initiatePayment`), where Postgres treats
  /// every NULL as distinct so several may coexist.
  providerTxId String? @map("provider_tx_id") @db.VarChar(100)

  /// Faza 19 (`INT-02`): the ERP money document this capture produced.
  /// Set exactly once, when the tx first reaches `captured` — the link is
  /// what makes gateway money visible in the ledger instead of only in
  /// this table. NULL + `errorMsg` set = capture landed but the PaymentIn
  /// could not be written; the next provider retry re-attempts it.
  paymentInId String? @map("payment_in_id") @db.Uuid

  /// Source: usually a CustomerOrder or InvoiceOut id.
  sourceEntity   String @map("source_entity") @db.VarChar(40)
  sourceEntityId String @map("source_entity_id") @db.Uuid

  /// Amount in tiyin (UZS minor units — same convention as Money model).
  amountMinor BigInt @map("amount_minor")

  /// 'pending' | 'authorized' | 'captured' | 'refunded' | 'cancelled' | 'failed'
  status String @default("pending") @db.VarChar(20)

  authorizedAt DateTime? @map("authorized_at") @db.Timestamptz()
  capturedAt   DateTime? @map("captured_at") @db.Timestamptz()
  refundedAt   DateTime? @map("refunded_at") @db.Timestamptz()
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz()
  failedAt     DateTime? @map("failed_at") @db.Timestamptz()

  /// Provider response log — array of provider events for audit.
  providerLog Json?   @map("provider_log")
  errorMsg    String? @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paymentIn PaymentIn? @relation("PaymentGatewayTxPaymentIn", fields: [paymentInId], references: [id], onDelete: SetNull)

  /// Faza 19 (`INT-04`): provider retry (protokolda NORMAL holat) avval har
  /// safar yangi qator yaratardi — bir to'lov bir necha «authorized» qatorga
  /// bo'linib, COMPLETE qaysi birini yangilashi noaniq edi. Endi DB darajasida
  /// bitta: create P2002 bersa chaqiruvchi mavjud qatorni qaytaradi.
  @@unique([accountId, provider, providerTxId])
  @@index([accountId, provider, status])
  @@index([accountId, sourceEntity, sourceEntityId])
  @@index([providerTxId])
  @@map("payment_gateway_txs")
}

// =========================================================================
// Sprint 30 — Bank statement integration
// =========================================================================

/// Per-account bank API config — one row per bank connector. Most
/// accounts have 1-2 banks; large enterprises may have all 7+. UZ
/// banks differ in auth/format so each gets its own adapter that this
/// config drives.
model BankApiConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'nbu' | 'asaka' | 'anor' | 'kapital' | 'tbc' | 'trustbank' | 'hamkor'
  bankCode    String @map("bank_code") @db.VarChar(20)
  /// Org STIR (must match the bank's account holder).
  stir        String @db.VarChar(20)
  /// Bank account / IBAN equivalent (20-char UZ account number).
  bankAccount String @map("bank_account") @db.VarChar(50)
  /// Bank's MFI code (5-digit branch identifier).
  bankMfo     String @map("bank_mfo") @db.VarChar(10)

  /// API endpoint URL.
  apiBaseUrl  String @map("api_base_url") @db.VarChar(255)
  /// Encrypted credentials (each bank has its own auth — token, mTLS,
  /// HMAC; we just store the bag as encrypted JSON).
  credsCipher String @map("creds_cipher") @db.VarChar(4000)

  /// Last successful pull timestamp — drives next-pull delta queries.
  lastPullAt  DateTime? @map("last_pull_at") @db.Timestamptz()
  lastPullOk  Boolean?  @map("last_pull_ok")
  lastPullMsg String?   @map("last_pull_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, bankCode, bankAccount])
  @@index([accountId, enabled])
  @@map("bank_api_configs")
}

// =========================================================================
// Sprint 31 — 1C two-way sync
// =========================================================================

/// Per-account 1C connector config. 1C 8.3 supports CommerceML 2.x
/// XML exchange via HTTP or file drop. V1 supports HTTP-only.
model OneCSyncConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  /// 1C HTTP endpoint URL (1C web-service / extension URL).
  endpointUrl    String @map("endpoint_url") @db.VarChar(500)
  /// Basic auth username for the 1C HTTP endpoint.
  username       String @db.VarChar(100)
  /// AES-encrypted password.
  passwordCipher String @map("password_cipher") @db.VarChar(500)

  /// Push direction: 'pull-only' (1C → us) | 'push-only' (us → 1C) |
  /// 'bidirectional'.
  direction String @default("bidirectional") @db.VarChar(20)

  /// Polling interval in minutes (cron uses this).
  pollIntervalMin Int @default(60) @map("poll_interval_min")

  /// Last sync stamp + verdict.
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz()
  lastSyncOk  Boolean?  @map("last_sync_ok")
  lastSyncMsg String?   @map("last_sync_msg") @db.VarChar(500)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("one_c_sync_configs")
}

/// Per-cycle 1C sync log entry. Captures direction, counts, and any
/// errors. Operators use this to diagnose missing data.
model OneCSyncLog {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'pull' | 'push' — which direction this cycle covered.
  direction String @db.VarChar(20)
  /// 'success' | 'partial' | 'failed'
  status    String @db.VarChar(20)

  /// Per-entity counts as a JSON map: {Counterparty: 12, Product: 350, ...}.
  counts Json @default("{}")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()
  errorMsg   String?   @map("error_msg")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, startedAt(sort: Desc)])
  @@map("one_c_sync_logs")
}

// =========================================================================
// Sprint 32 — Marketplaces (Uzum / Yandex / Wildberries / Ozon)
// =========================================================================

/// Per-account marketplace seller config. One row per (marketplace, account).
model MarketplaceConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// 'uzum' | 'yandex' | 'wildberries' | 'ozon'
  marketplace String @db.VarChar(20)
  /// Seller's storefront name (display only).
  shopName    String @map("shop_name") @db.VarChar(255)
  /// Seller id assigned by the marketplace.
  sellerId    String @map("seller_id") @db.VarChar(100)

  /// API endpoint URL (each marketplace has prod/sandbox).
  apiBaseUrl  String @map("api_base_url") @db.VarChar(255)
  /// AES-encrypted API key / OAuth refresh token.
  credsCipher String @map("creds_cipher") @db.VarChar(2000)

  /// Last sync stamps — separate stamps for catalog push vs order pull.
  lastCatalogPushAt DateTime? @map("last_catalog_push_at") @db.Timestamptz()
  lastOrderPullAt   DateTime? @map("last_order_pull_at") @db.Timestamptz()

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, marketplace])
  @@map("marketplace_configs")
}

/// Inbound orders pulled from a marketplace. Each row mirrors the
/// marketplace's order id + status; downstream we materialise it into
/// our internal CustomerOrder (linked via `internalOrderId`).
model MarketplaceOrderRow {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  marketplace String @db.VarChar(20)
  /// Marketplace's order id (numeric or alphanumeric, varies).
  externalId  String @map("external_id") @db.VarChar(100)

  /// Provider-side status (raw — not mapped to our FSM at this layer).
  status String @db.VarChar(40)

  /// Total amount in tiyin (UZS), best-effort conversion if currency differs.
  totalMinor BigInt @map("total_minor")
  currency   String @default("UZS") @db.VarChar(3)

  /// Raw payload from the marketplace API — kept for audit + future
  /// re-mapping if our materialiser changes shape.
  rawJson Json @map("raw_json")

  /// Once we materialise this into a CustomerOrder, this points at it.
  /// Null while the row is unprocessed.
  internalOrderId String? @map("internal_order_id") @db.Uuid

  pulledAt DateTime @default(now()) @map("pulled_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, marketplace, externalId])
  @@index([accountId, marketplace, status])
  @@map("marketplace_orders")
}

enum TaskKind {
  CRM
  HR
}

// ============================================================================
// HR MODULE — P0 foundation (master spec § 3)
// ============================================================================
// 16 ta yangi `hr_*` table. Mavjud Employee/Task'larga additive kengaytma
// (yuqorida). Hammasi RLS bilan multi-tenant (migration.sql da policy
// qo'shiladi — Task 13).
// ============================================================================

model HrTaskTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  title              String   @db.VarChar(255)
  description        String?
  assignedEmployeeId String?  @map("assigned_employee_id") @db.Uuid
  assignedRole       String?  @map("assigned_role") @db.VarChar(50)
  department         String?  @db.VarChar(100)
  priority           String   @default("medium") @db.VarChar(20)
  triggerType        String   @map("trigger_type") @db.VarChar(20)
  scheduleConfig     Json?    @map("schedule_config")
  eventConfig        Json?    @map("event_config")
  responseType       String   @default("none") @map("response_type") @db.VarChar(20)
  deadlineMinutes    Int?     @map("deadline_minutes")
  rewardMinor        BigInt?  @map("reward_minor")
  fineMinor          BigInt?  @map("fine_minor")
  checkerId          String?  @map("checker_id") @db.Uuid
  dependsOnId        String?  @map("depends_on_id") @db.Uuid
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedEmployee Employee?        @relation("HrTemplateAssignee", fields: [assignedEmployeeId], references: [id])
  checker          Employee?        @relation("HrTemplateChecker", fields: [checkerId], references: [id])
  dependsOn        HrTaskTemplate?  @relation("HrTemplateDeps", fields: [dependsOnId], references: [id])
  dependents       HrTaskTemplate[] @relation("HrTemplateDeps")
  logs             HrTaskLog[]
  taskInstances    Task[]

  @@index([accountId, isActive])
  @@index([accountId, triggerType])
  @@map("hr_task_template")
}

model HrTaskLog {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  templateId        String    @map("template_id") @db.Uuid
  taskId            String    @unique @map("task_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  status            String    @db.VarChar(20)
  responseText      String?   @map("response_text")
  sentAt            DateTime  @map("sent_at") @db.Timestamptz()
  answeredAt        DateTime? @map("answered_at") @db.Timestamptz()
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewedById      String?   @map("reviewed_by_id") @db.Uuid
  reviewComment     String?   @map("review_comment")
  telegramMessageId String?   @map("telegram_message_id") @db.VarChar(50)
  failReason        String?   @map("fail_reason")

  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template   HrTaskTemplate   @relation(fields: [templateId], references: [id])
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee         @relation("HrTaskAssignee", fields: [employeeId], references: [id])
  reviewedBy Employee?        @relation("HrTaskChecker", fields: [reviewedById], references: [id])
  bonusFines HrBonusFineLog[]

  @@index([accountId, employeeId, status])
  @@index([accountId, templateId, sentAt(sort: Desc)])
  @@index([accountId, status, sentAt(sort: Desc)])
  @@map("hr_task_log")
}

model HrAttendance {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  checkInTime  DateTime  @map("check_in_time") @db.Timestamptz()
  checkOutTime DateTime? @map("check_out_time") @db.Timestamptz()
  editedById   String?   @map("edited_by_id") @db.Uuid
  editedAt     DateTime? @map("edited_at") @db.Timestamptz()
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // === HR GPS-davomat (auto keldi/ketdi) — all nullable/defaulted, prod-safe ===
  checkInLat      Float?  @map("check_in_lat")
  checkInLng      Float?  @map("check_in_lng")
  checkInAccuracy Int?    @map("check_in_accuracy")
  checkOutLat     Float?  @map("check_out_lat")
  checkOutLng     Float?  @map("check_out_lng")
  source          String  @default("auto_gps") @map("source") @db.VarChar(12) // 'auto_gps' | 'manual'
  lateMinutes     Int     @default(0) @map("late_minutes")
  workLocationId  String? @map("work_location_id") @db.Uuid // raw FK, no relation (mirror Employee.groupId)
  autoClosed      Boolean @default(false) @map("auto_closed") // closed by nightly cron (departure not seen)

  /// HR-13 (Faza Q7) — soft-delete. `delete()` ilgari HARD-delete qilardi:
  /// davomat tarixi izsiz yo'qolardi va undan kelib chiqqan `auto_late` jarima
  /// (`HrBonusFineLog.attendanceId` — xom FK, cascade YO'Q) yetim qolib
  /// oylikdan pul ushlab turaverardi. Endi qator qoladi, HAMMA o'quvchi
  /// `deletedAt: null` bilan filtrlaydi (klass-lock: `hr-attendance-soft-delete-class.test.ts`).
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  deletedById String?   @map("deleted_by_id") @db.Uuid // raw FK, no relation (mirror workLocationId)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee  @relation("HrAttendanceEmployee", fields: [employeeId], references: [id])
  editedBy Employee? @relation("HrAttendanceEditor", fields: [editedById], references: [id])

  @@index([accountId, employeeId, checkInTime(sort: Desc)])
  @@map("hr_attendance")
}

model HrTelegramAccount {
