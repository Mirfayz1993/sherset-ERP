/// Cash drawer in/out within an open RetailShift. Different from CashIn
/// which is a standalone cash receipt — this is "operator picked up
/// 50,000 from the till and put it in the safe" / vice versa.
model RetailDrawerCashIn {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  retailShiftId  String  @map("retail_shift_id") @db.Uuid
  agentId        String? @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor BigInt @default(0) @map("sum_minor")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  /// Pul yashiqqa NEGA kirdi (A1, 2026-08-25). 'topup' — «Внесение» (kassirning
  /// o'z kirimi, kontragentsiz), 'customer_prepay' — MIJOZ AVANSI (oldindan
  /// to'lov: `agentId` MAJBURIY va o'sha tranzaksiyada kontragent balansiga
  /// `−sumMinor` yoziladi), 'other' — tasniflanmagan (eski yozuvlar).
  ///
  /// NEGA alohida jadval EMAS — `RetailDrawerCashOut.kind` bilan AYNI sabab:
  /// smena yakunidagi «kutilgan naqd» (§8.4) AYNAN shu jadvalni yig'adi
  /// (`collectCashInputs.drawerInMinor`). Avans uchun yangi jadval ochilsa,
  /// uni formulaga qo'shishni UNUTISH mumkin edi — §100 bug'i («drawer in/out
  /// kutilgan naqddan tushib qolgan edi») aynan shu sinfdan. Bitta pul yo'li —
  /// tasniflangan; Z-hisobot ajratishni `kind` orqali oladi.
  kind String @default("other") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?      @relation("RetailDrawerInOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?         @relation("RetailDrawerInGroup", fields: [groupId], references: [id], onDelete: SetNull)
  retailShift  CashierSession @relation("RetailDrawerInShift", fields: [retailShiftId], references: [id], onDelete: Restrict)
  agent        Counterparty?  @relation("RetailDrawerInAgent", fields: [agentId], references: [id], onDelete: SetNull)
  organization Organization   @relation("RetailDrawerInOrg", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@index([accountId, retailShiftId])
  // Z-hisobot va `recompute` manbasi: smenadagi avans kesimi (A1).
  @@index([accountId, retailShiftId, kind])
  // A1 — `recompute-counterparty-balances` ning `customer-prepays` manbasi:
  // mijoz kesimida avans yig'indisi (`groupBy accountId,agentId,currency`).
  @@index([accountId, agentId, kind])
  @@map("retail_drawer_cash_in")
}

model RetailDrawerCashOut {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid
  groupId   String? @map("group_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String? @db.VarChar(50)
  externalCode String? @map("external_code") @db.VarChar(50)
  syncId       String? @map("sync_id") @db.Uuid

  retailShiftId  String  @map("retail_shift_id") @db.Uuid
  agentId        String? @map("agent_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid

  moment     DateTime  @default(now()) @db.Timestamptz()
  applicable Boolean   @default(false)
  state      String    @default("draft") @db.VarChar(30)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz()

  sumMinor BigInt @default(0) @map("sum_minor")

  currency  String @default("UZS") @db.VarChar(3)
  rateValue BigInt @default(100000000) @map("rate_value")

  description String?
  shared      Boolean @default(false)
  printed     Boolean @default(false)
  published   Boolean @default(false)
  attributes  Json?   @default("{}")

  /// Pul yashiqdan NEGA chiqdi (kassa TZ §8.2/§8.3): 'expense' — xarajat (RKO),
  /// 'collection' — inkassatsiya, 'other' — tasniflanmagan (eski yozuvlar).
  ///
  /// NEGA alohida jadval EMAS: smena yakunidagi «kutilgan naqd» AYNAN shu
  /// jadvalni yig'adi. Har yangi pul-chiqishi turi uchun yangi jadval ochilsa,
  /// uni formulaga qo'shishni UNUTISH mumkin — bu ayni §100 bug'i («drawer
  /// in/out kutilgan naqddan tushib qolgan edi») qaytadan ochilishi bo'lardi.
  /// Bitta pul yo'li — tasniflangan. Z-hisobot ajratishni `kind` orqali oladi.
  kind String @default("other") @db.VarChar(20)

  /// Xarajat moddasi (`kind='expense'` da MAJBURIY — servis tekshiradi).
  /// Sxema darajasida nullable: bitta jadval uch xil hujjatni saqlaydi.
  expenseItemId String? @map("expense_item_id") @db.Uuid

  /// Inkassatsiyani QABUL QILGAN xodim (`kind='collection'` da majburiy).
  /// «Pulni kimga topshirdim» — javobgarlik shu yerdan boshlanadi.
  recipientId String? @map("recipient_id") @db.Uuid

  /// G1 (`kind='return_payout'` da majburiy) — QAYSI vozvrat uchun pul
  /// qaytarildi. Cap (`SalesReturn.payedSumMinor ≤ sumMinor`) shu bog' orqali
  /// tekshiriladi; hujjat pul izining o'zi, shuning uchun Restrict —
  /// to'langan vozvratni o'chirish pul dalilini yetim qoldirardi.
  salesReturnId String? @map("sales_return_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        Employee?      @relation("RetailDrawerOutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  group        Group?         @relation("RetailDrawerOutGroup", fields: [groupId], references: [id], onDelete: SetNull)
  retailShift  CashierSession @relation("RetailDrawerOutShift", fields: [retailShiftId], references: [id], onDelete: Restrict)
  agent        Counterparty?  @relation("RetailDrawerOutAgent", fields: [agentId], references: [id], onDelete: SetNull)
  organization Organization   @relation("RetailDrawerOutOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  // Restrict: ishlatilgan xarajat moddasi o'chirilsa hujjat «moddasiz» qolardi
  // va Z-hisobotdagi moddalar kesimi jimgina buzilardi.
  expenseItem  ExpenseItem?   @relation("RetailDrawerOutExpenseItem", fields: [expenseItemId], references: [id], onDelete: Restrict)
  recipient    Employee?      @relation("RetailDrawerOutRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  salesReturn  SalesReturn?   @relation("RetailDrawerOutSalesReturn", fields: [salesReturnId], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@index([accountId, retailShiftId])
  // Z-hisobot: smenadagi xarajat/inkassatsiya kesimi.
  @@index([accountId, retailShiftId, kind])
  // G1: bitta vozvratning to'lov hujjatlari (cap va tarix).
  @@index([accountId, salesReturnId])
  @@map("retail_drawer_cash_out")
}

