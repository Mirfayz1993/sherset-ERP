// ===========================================================================
// Menejer — kunlik xodim KPI (4-bo'lim kengaytmasi, 4M.1)
// docs/superpowers/specs/2026-08-02-menejer-kunlik-kpi-tz-design.md
//
// Nega yuqoridagi `HrKpiDailyLog` ni kengaytirmaymiz: u uchta QAT'IY ustundan
// iborat (sotuv / target / bajarish %) va har yangi o'lchov migratsiya talab
// qiladi. Egasi kassa, davomat, vazifa va ombor ko'rsatkichlarini ham so'radi —
// ular ustun sifatida sig'maydi.
//
// Eski jadval DARHOL o'chirilmaydi: HR oylik dvigateli undan o'qiydi. Tartib —
// (1) ikkalasi parallel to'ldiriladi, (2) HR yangi ombordan o'qishga o'tadi,
// (3) eskisi faqat-o'qish, (4) olib tashlanadi. Har qadam qaytariladigan.
// ===========================================================================

/// KpiMetricDef — ko'rsatkich katalogi. Kod tomonidagi manba:
/// `apps/api/src/modules/manager/kpi/kpi-metrics.ts` (sof modul, testlangan);
/// bu jadval uni hisob bo'yicha SOZLASH uchun (nomi, ko'rsatilishi, o'chirish).
model KpiMetricDef {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  /// `cash_revenue`, `gross_profit`, `late_minutes` … — kod katalogidagi kalit.
  key       String  @db.VarChar(50)
  labelUz   String  @map("label_uz") @db.VarChar(120)
  labelRu   String  @map("label_ru") @db.VarChar(120)
  /// `money` | `count` | `percent` | `minutes`
  unit      String  @db.VarChar(10)
  /// `higher_better` | `lower_better` | `neutral` — rang va reyting shundan.
  direction String  @db.VarChar(15)
  /// `cashier` | `sales` | `attendance` | `task` | `warehouse` — drill-down manzili.
  source    String  @db.VarChar(20)
  /// Soatga normallashtiriladimi (adolat: yarim kun ishlagan xodim uchun).
  perHour   Boolean @default(false) @map("per_hour")
  archived  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profileMetrics KpiProfileMetric[]

  @@unique([accountId, key])
  @@index([accountId, archived])
  @@map("kpi_metric_defs")
}

/// KpiProfile — lavozim bo'yicha KPI to'plami. Kassirni va omborchini bir xil
/// o'lchash ma'nosiz, shuning uchun har lavozimning o'z ko'rsatkichlari bor.
model KpiProfile {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  name       String  @db.VarChar(120)
  /// Qaysi lavozimga tegishli. NULL = hisob bo'yicha sukut profil.
  positionId String? @map("position_id") @db.Uuid
  /// Bitta xodimga individual biriktirilgan profil (TZ 4M.2 — «har xodim uchun
  /// alohida»). Kunlik hisob profilni XODIM → LAVOZIM → sukut tartibida tanlaydi,
  /// shuning uchun bu to'ldirilgan bo'lsa lavozim profilidan ustun turadi.
  employeeId String? @map("employee_id") @db.Uuid
  archived   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account  Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  position HrPosition?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employee Employee?           @relation("KpiProfileEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  versions KpiProfileVersion[]

  @@index([accountId, archived])
  @@index([accountId, positionId])
  @@index([accountId, employeeId])
  @@map("kpi_profiles")
}

/// KpiProfileVersion — 🔴 PROFIL VERSIYALANADI (TZ §2.3).
///
/// Og'irlik yoki ko'rsatkichlar to'plami o'zgarsa YANGI versiya yaratiladi;
/// eski kunlar o'z versiyasiga havola qilib turadi.
///
/// Nega: aks holda bugun og'irlikni o'zgartirganingizda O'TGAN OYNING raqamlari
/// o'zgaradi va allaqachon to'langan oylik bilan hisobot bir-biriga mos
/// kelmay qoladi. Bu — tan narx muzlatish bilan aynan bir xil klass
/// (`RetailSalePosition.costMinor`): hisobot tarixni qayta yozmasligi kerak.
model KpiProfileVersion {
  id            String   @id @default(uuid()) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  /// 1 dan boshlab o'sadi.
  version       Int
  /// Shu versiya qaysi kundan boshlab amal qiladi (kunlik hisob shunga qaraydi).
  effectiveFrom DateTime @map("effective_from") @db.Date
  note          String?  @db.VarChar(300)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdById String?  @map("created_by_id") @db.Uuid

  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile   KpiProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  metrics   KpiProfileMetric[]
  dailyKpis EmployeeDailyKpi[]

  @@unique([profileId, version])
  @@index([accountId, profileId, effectiveFrom(sort: Desc)])
  @@map("kpi_profile_versions")
}

/// KpiProfileMetric — versiya ichidagi bitta ko'rsatkich va uning og'irligi.
model KpiProfileMetric {
  id               String  @id @default(uuid()) @db.Uuid
  accountId        String  @map("account_id") @db.Uuid
  profileVersionId String  @map("profile_version_id") @db.Uuid
  metricDefId      String  @map("metric_def_id") @db.Uuid
  /// Kompozit balldagi og'irligi (M10 da ishlatiladi). 0 = faqat ko'rsatiladi.
  weight           Decimal @default(0) @db.Decimal(5, 2)
  /// Kunlik maqsad-raqam (reja) — ko'rsatkichning O'Z birligida, butun songa
  /// (pul = tiyin, dona = dona, daqiqa = daqiqa). NULL = maqsadsiz (faqat fakt
  /// ko'rsatiladi). Bajarish % = fakt ÷ maqsad (`direction` yo'nalishiga qarab).
  target           BigInt? @map("target")

  account        Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profileVersion KpiProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  metricDef      KpiMetricDef      @relation(fields: [metricDefId], references: [id], onDelete: Restrict)

  @@unique([profileVersionId, metricDefId])
  @@index([accountId, profileVersionId])
  @@map("kpi_profile_metrics")
}

/// EmployeeDailyKpi — kun × xodim. Menejer aynan shu yozuvni QABUL QILADI.
///
/// `state` VarChar (sxema konventsiyasi: `RetailSale.state`, `RestockTask.status`)
/// — 4M.2 da qabul qilish FSM'i qo'shilganda yangi holatlar migratsiyasiz keladi.
/// 4M.1 da faqat `computed` yoziladi.
/// Xodimni bo'shatish jarayoni (menejer TZ 4M.4 — «hayot sikli»).
///
/// Bo'shatish bir bosishlik `archived: true` bayrog'i EMAS: ro'yxat tugamaguncha
/// xodim arxivlanmaydi. Sabab — arxivlash o'zi login/refresh'ni yopadi, lekin
/// Telegram bog'lami, ochiq kassa smenasi, qabul qilinmagan KPI kunlari va
/// topshirilmagan jihoz OCHIQ qolaveradi.
///
/// Faqat QO'LDA tasdiqlanadigan bandlar saqlanadi (`items`): «Telegram uzildimi»
/// kabi tizim biladigan bandlar HAR SO'ROVDA qayta tekshiriladi va bu yerga
/// yozilmaydi — bir marta «bajarildi» deb muzlatib qo'yish keyin ochilib qolgan
/// smenani ko'rinmas qilardi.
/// Suhbat va ogohlantirish jurnali (menejer TZ 4M.4 — xodim kartasi 360°).
///
/// APPEND-ONLY: yozuv tahrirlanmaydi va o'chirilmaydi. O'chirib bo'ladigan
/// ogohlantirish — ogohlantirish emas: noqulay yozuvni keyin yo'qotish imkoni
/// bo'lsa, jurnalning butun ma'nosi yo'qoladi. Xato yozuv `voidedAt` bilan
/// bekor qilinadi — u tarixda KO'RINADI, lekin hisobga kirmaydi.
model EmployeeNote {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// 'talk' | 'warning' | 'praise' — jurnal faqat salbiydan iborat bo'lmasin.
  kind String @db.VarChar(20)
  text String

  authorId String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Bekor qilingan payt. Yozuv o'chirilmaydi — ko'rinadi, lekin sanalmaydi.
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz()
  voidedById   String?   @map("voided_by_id") @db.Uuid
  voidReason   String?   @map("void_reason")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee  @relation("EmployeeNoteEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  author   Employee? @relation("EmployeeNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  voidedBy Employee? @relation("EmployeeNoteVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  /// Xodim kartasi: eng yangi yozuvlar birinchi.
  @@index([accountId, employeeId, createdAt(sort: Desc)])
  /// «Kimda ogohlantirish naqshi bor» — menejer kesimi.
  @@index([accountId, kind, createdAt(sort: Desc)])
  @@map("employee_notes")
}

model EmployeeOffboarding {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Oxirgi ish kuni — hisobot va davomat uchun.
  lastWorkingDay DateTime? @map("last_working_day") @db.Date
  /// Ketish sababi (erkin matn; yopiq ro'yxat hozircha talab qilinmagan).
  reason         String?

  /// Qo'lda tasdiqlangan bandlar: `{ [key]: { doneAt, byId } }`.
  items Json @default("{}")

  startedById String?   @map("started_by_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  /// Ro'yxat to'liq bajarilib, xodim ARXIVLANGAN payt. NULL = jarayon davom etmoqda.
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee    Employee  @relation("EmployeeOffboardingEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  startedBy   Employee? @relation("EmployeeOffboardingActor", fields: [startedById], references: [id], onDelete: SetNull)

  /// Bir xodimda bir vaqtda bitta faol jarayon.
  @@unique([employeeId])
  /// Menejer ekrani: «tugallanmagan bo'shatishlar».
  @@index([accountId, completedAt])
  @@map("employee_offboardings")
}

/// Ishga qabul tomoni — sinov muddati (menejer TZ 4M.4 / §6.3 «hayot sikli»).
///
/// `EmployeeOffboarding` ning ko'zgusi: u yerda ro'yxat tugamaguncha xodim
/// ARXIVLANMAYDI, bu yerda ro'yxat tugamaguncha sinov «O'TDI» deb yopilmaydi.
/// Ikkalasida ham `auto` bandni qo'lda belgilab bo'lmaydi.
model EmployeeOnboarding {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Sinov muddatining boshlanishi (= ishga qabul sanasi).
  /// `Employee.createdAt` EMAS: qator tizimga kiritilgan payt ishga olingan
  /// kun bilan mos kelmaydi (eski xodimlar bir kunda import qilingan).
  probationStartsOn DateTime? @map("probation_starts_on") @db.Date
  /// Sinov muddatining tugashi.
  probationEndsOn   DateTime? @map("probation_ends_on") @db.Date
  /// Baholash sanasi. NULL bo'lsa `probationEndsOn` ishlatiladi (TZ §6.3 —
  /// «o'sha kuni menejer navbatiga element tushadi»).
  evaluationOn      DateTime? @map("evaluation_on") @db.Date

  /// Sinov natijasi: 'passed' | 'failed'. NULL = hali SINOVDA.
  /// «O'tdi» faqat bloklovchi bandlar yopilganda yoziladi; «o'tmadi» esa
  /// har doim mumkin — aks holda ro'yxat odamni ishdan bo'shata olmaslikka
  /// olib kelardi.
  outcome     String?   @db.VarChar(10)
  outcomeAt   DateTime? @map("outcome_at") @db.Timestamptz()
  outcomeById String?   @map("outcome_by_id") @db.Uuid
  outcomeNote String?   @map("outcome_note")

  /// Qo'lda tasdiqlangan bandlar: `{ [key]: { doneAt, byId } }` (offboarding bilan bir xil shakl).
  items Json @default("{}")

  startedById String?  @map("started_by_id") @db.Uuid
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz()

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("EmployeeOnboardingEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  startedBy Employee? @relation("EmployeeOnboardingActor", fields: [startedById], references: [id], onDelete: SetNull)
  decidedBy Employee? @relation("EmployeeOnboardingDecider", fields: [outcomeById], references: [id], onDelete: SetNull)

  /// Bir xodimda bir vaqtda bitta sinov jarayoni.
  @@unique([employeeId])
  /// Menejer ekrani: «sinovda turganlar» + baholash sanasi bo'yicha tartib.
  /// `outcome` birinchi — hali yopilmagan qatorlar tanlanadi, keyin sana.
  @@index([accountId, outcome, evaluationOn])
  @@map("employee_onboardings")
}

/// Jihoz reyestri (menejer TZ 4M §6.4 «kimda nima turibdi», MK05).
///
/// Ilgari tizim jihoz haqida HECH NARSA bilmasdi: javobgarlik taxtasida
/// jihoz bloki ataylab tashlangan, bo'shatish ro'yxatidagi bandi esa qo'lda
/// tasdiq edi. Reyestr shu ikki teshikni yopadi.
///
/// «Kimda» ustuni YO'Q — u `EquipmentAssignment` dagi ochiq qatordan
/// chiqadi. Ikkinchi manba bo'lsa, ular jimgina bir-biridan uzoqlashardi.
model Equipment {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  name String
  /// Inventar raqami. NULL — raqamsiz jihoz (Postgres NULLlarni takroriy
  /// deb sanamaydi, ya'ni raqamsizlar bir-biriga xalaqit bermaydi).
  inventoryNo String? @map("inventory_no")
  /// Erkin toifa: telefon · skaner · kalit · … (yopiq ro'yxat talab qilinmagan).
  category    String? @db.VarChar(32)

  /// `in_stock` | `assigned` | `repair` | `written_off` | `lost`.
  /// `assigned` QO'LDA tanlanmaydi — biriktirishdan kelib chiqadi.
  status String  @default("in_stock") @db.VarChar(16)
  note   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account     Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignments EquipmentAssignment[]

  /// Inventar raqami akkaunt ichida takrorlanmaydi.
  @@unique([accountId, inventoryNo])
  /// Reyestr ro'yxati: holat bo'yicha filtr + nom bo'yicha tartib.
  @@index([accountId, status, name])
  @@map("equipment")
}

/// Jihozning xodimga biriktirilishi — APPEND-ONLY tarix.
///
/// Qaytarish qatorni O'CHIRMAYDI, `returnedAt` ni yozadi: kim, qachon,
/// qanday holatda topshirgani izsiz ketmasin. Qayta berilsa — YANGI qator.
///
/// ⚠️ Bitta jihozda bir vaqtda BITTA ochiq qator bo'lishi migratsiyadagi
/// **qisman unique indeks** bilan qulflangan (`WHERE returned_at IS NULL`) —
/// Prisma sxemasi qisman indeksni ifodalay olmaydi, shuning uchun bu yerda
/// faqat izoh; SQL migratsiyada bor.
model EquipmentAssignment {
  id          String @id @default(uuid()) @db.Uuid
  accountId   String @map("account_id") @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid

  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz()
  issuedById String?  @map("issued_by_id") @db.Uuid
  issueNote  String?  @map("issue_note")

  /// NULL = jihoz hamon xodimda (ochiq qator).
  returnedAt      DateTime? @map("returned_at") @db.Timestamptz()
  returnedById    String?   @map("returned_by_id") @db.Uuid
  /// `ok` | `damaged` | `lost` — jihozning YANGI holatini shu belgilaydi.
  returnCondition String?   @map("return_condition") @db.VarChar(16)
  returnNote      String?   @map("return_note")

  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("EquipmentAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy   Employee? @relation("EquipmentAssignmentIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  receivedBy Employee? @relation("EquipmentAssignmentReceiver", fields: [returnedById], references: [id], onDelete: SetNull)

  /// «Kimda nima qolgan» (javobgarlik taxtasi + bo'shatish ro'yxati):
  /// xodim bo'yicha ochiq qatorlar.
  @@index([accountId, employeeId, returnedAt])
  /// Jihoz kartasidagi tarix — eng yangisi birinchi.
  @@index([equipmentId, issuedAt(sort: Desc)])
  @@map("equipment_assignments")
}

model EmployeeDailyKpi {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date

  /// Qaysi profil VERSIYASI bilan hisoblangan — tarixni muzlatadi (§2.3).
  /// NULL = xodimga profil biriktirilmagan (ma'lumot sifati panelida ko'rinadi).
  profileVersionId String? @map("profile_version_id") @db.Uuid

  /// `computed` → (4M.2) `pending` | `accepted` | `rejected` | `stale` | `escalated`
  state String @default("computed") @db.VarChar(20)

  /// Kun ko'rsatkichlarining HAMMASI to'liq manbadan hisoblanganmi.
  /// `false` — masalan ba'zi qatorlarda tan narx muzlatilmagan: foyda kam
  /// ko'rsatilgan bo'lishi mumkin. Menejer buni ekranda ko'radi va shu
  /// bilimda qabul qiladi (NULL ≠ 0 shartnomasi, 1.1/1.2).
  dataComplete Boolean @default(true) @map("data_complete")

  /// Normalizatsiya asosi — soatga bo'lish shundan (§2.5). NULL = davomat yo'q.
  workedMinutes Int? @map("worked_minutes")

  /// Qabul qilingandan KEYIN manba hujjat o'zgargan bo'lsa — eskirish vaqti
  /// (TZ §3.4). Kun navbatga qaytadi va oylikka tuzatuvchi qator yoziladi;
  /// eski raqam jimgina qayta yozilmaydi.
  staleAt DateTime? @map("stale_at") @db.Timestamptz()

  /// Kim va qachon qabul qilgan (TZ §9). Oylik hisobi (§4) va egaga haftalik
  /// xulosa (M-Q7) shu ikkisiga tayanadi. FK YO'Q — `actorId` naqshi
  /// (`SupplyApprovalEvent`), aktyor tizim ham bo'lishi mumkin.
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz()

  /// Holat OXIRGI MARTA qachon o'zgardi — eskalatsiya soati shundan sanaydi.
  /// `updatedAt` bu ish uchun YARAMAYDI: u tungi qayta hisoblashda ham
  /// yangilanadi, ya'ni javobsiz turgan kun har kecha «yangi» bo'lib
  /// ko'rinardi va hech qachon egaga chiqmasdi.
  stateChangedAt DateTime? @map("state_changed_at") @db.Timestamptz()

  /// Qabul paytidagi kompozit ball (og'irlik × bajarish %), foizda.
  ///
  /// 🔴 MUZLATILADI: profil versiyasi kabi, ball ham qabul lahzasida yoziladi.
  /// Aks holda keyin og'irlik o'zgartirilsa yoki katalog kengaysa, allaqachon
  /// to'langan oylik ortidagi raqam qayta hisoblanib boshqacha chiqardi
  /// (tan narx muzlatish bilan bir klass).
  scorePercent Decimal? @map("score_percent") @db.Decimal(7, 2)

  /// Ball kunning qanchasini qamragan (0…1): og'irliklarning necha qismi
  /// haqiqatan ballangan. Chala qamrov YASHIRILMAYDI — menejer ballga qanchalik
  /// ishonish kerakligini ko'rib turadi.
  scoreCoverage Decimal? @map("score_coverage") @db.Decimal(5, 4)

  /// Qabul lahzasida MUZLATILGAN oylik-fakti (tiyin) — TZ §3.4.
  ///
  /// NEGA: kun qabul qilinadi → oylikka kiradi → TO'LANADI. Keyin manba
  /// hujjat o'zgarsa kun eskiradi va qayta qabul qilinadi. Agar oylik har
  /// safar joriy raqamni qayta yig'sa, allaqachon to'langan oyning summasi
  /// JIMGINA o'zgarardi va buni buxgalter tushuntira olmasdi.
  /// Shu ustun «o'sha paytda nima to'langan» savoliga javob beradi; farq esa
  /// `EmployeeKpiCorrection` da alohida qator bo'lib yoziladi.
  ///
  /// NULL = kun hech qachon qabul qilinmagan (0 EMAS: nol fakt ham haqiqiy
  /// qiymat va u bilan «qabul qilinmagan» ni aralashtirib bo'lmaydi).
  acceptedFactMinor BigInt? @map("accepted_fact_minor")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account        Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee       Employee                 @relation("EmployeeDailyKpiEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  profileVersion KpiProfileVersion?       @relation(fields: [profileVersionId], references: [id], onDelete: SetNull)
  metrics        EmployeeDailyKpiMetric[]
  events         EmployeeDailyKpiEvent[]
  corrections    EmployeeKpiCorrection[]
  /// Qabuldan chiqqan bonus/jarima yozuvlari (4M.3 / MK01, QAROR-B1).
  bonusFineLogs  HrBonusFineLog[]

  @@unique([accountId, employeeId, date])
  // Menejerning kunlik ro'yxati: «shu kun, qabul kutayotganlar».
  @@index([accountId, date(sort: Desc), state])
  // Xodim kartasidagi trend.
  @@index([accountId, employeeId, date(sort: Desc)])
  // Eskalatsiya skani: «qaysi kunlar N kundan beri javobsiz turibdi».
  @@index([accountId, state, stateChangedAt])
  @@map("employee_daily_kpi")
}

/// EmployeeDailyKpiMetric — kun × xodim × ko'rsatkich.
///
/// `autoValue` va `adjustValue` YONMA-YON turadi: menejer tuzatmasi avtomat
/// raqamni USTIGA YOZMAYDI (TZ §3.2). Sabab — 1.1 sabog'i: haqiqatni
/// yo'qotmaslik. «Menejer qancha va nega tuzatdi» degan savolga javob shu
/// ikkitasining farqidan chiqadi (egaga haftalik xulosa, M-Q7).
model EmployeeDailyKpiMetric {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  dailyKpiId String @map("daily_kpi_id") @db.Uuid
  metricKey  String @map("metric_key") @db.VarChar(50)

  /// Tizim hisoblagani. NULL = O'LCHANMAGAN (0 EMAS).
  autoValue   BigInt? @map("auto_value")
  /// Menejer tuzatmasi (4M.2). NULL = tuzatilmagan.
  adjustValue BigInt? @map("adjust_value")
  /// Tuzatma sababi — 4M.2 da MAJBURIY bo'ladi.
  reasonCode  String? @map("reason_code") @db.VarChar(40)

  /// Shu ko'rsatkich to'liq manbadan hisoblanganmi.
  complete Boolean @default(true)

  /// 🔴 KPI-03 — O'SHA KUN uchun hal qilingan maqsad, QATOR ICHIDA MUHRLANGAN.
  /// Ko'rsatkichning o'z birligida (pul = tiyin). NULL = maqsad yo'q (0 EMAS).
  ///
  /// Nega muhr: `EmployeeKpiTarget` qatlami VERSIYALANMAYDI, ya'ni «o'tgan oy
  /// qayta yozilmasin» kafolati (§2.3) aynan shu ustunda yashaydi. Maqsad
  /// tahrir qilinsa faqat KELAJAK kunlar o'zgaradi — muhrlangan kun o'z
  /// raqamini saqlaydi (tan-narx muzlatish klassi).
  targetValue BigInt? @map("target_value")
  /// Maqsad qaysi pog'onadan kelgani: `employee_target` | `target_override` |
  /// `profile` | `none` (`kpi-target.ts` `TargetSource`).
  ///
  /// **NULL = MUHR YO'Q** — migratsiyadan oldin hisoblangan qator. O'quvchi
  /// bunday qatorda avvalgidek profil versiyasidagi maqsadga tushadi. Bu ustun
  /// bo'lmasa «muhrlangan maqsadsizlik» (`none`) va «umuman muhrlanmagan»
  /// holatlari farqlanmasdi va eski kunlar ballari nolga tushib ketardi.
  targetSource String? @map("target_source") @db.VarChar(20)

  /// 🔴 KPI-05 — O'SHA KUNGA qo'llangan OG'IRLIK, qator ichida MUHRLANGAN.
  /// **NULL = og'irlik qo'yilmagan** (ballanmaydi, faqat kuzatiladi), 0 EMAS.
  ///
  /// Nega muhr: og'irlik endi `EmployeeKpiTarget.weight` dan ham keladi, u
  /// qatlam esa versiyalanmaydi. Muhrsiz o'qilsa bugungi og'irlik tahriri
  /// o'tgan kunlarning ballini qayta yozardi — `kpi_profile_versions` aynan
  /// shuni to'sish uchun bor edi (maqsad tomonida bu `targetValue` muhri).
  weightApplied Decimal? @map("weight_applied") @db.Decimal(5, 2)
  /// Og'irlik qaysi pog'onadan kelgani: `employee_target` | `profile` | `none`
  /// (`kpi-target.ts` `WeightSource`).
  ///
  /// **NULL = MUHR YO'Q** — migratsiyadan oldin hisoblangan qator; o'quvchi
  /// unda avvalgidek profil versiyasidagi og'irlikka tushadi. Bu ustunsiz
  /// «muhrlangan og'irliksizlik» va «umuman muhrlanmagan» farqlanmasdi.
  weightSource String? @map("weight_source") @db.VarChar(20)

  account  Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dailyKpi EmployeeDailyKpi @relation(fields: [dailyKpiId], references: [id], onDelete: Cascade)

  @@unique([dailyKpiId, metricKey])
  @@index([accountId, metricKey])
  @@map("employee_daily_kpi_metrics")
}

/// EmployeeDailyKpiEvent — kunlik KPI qabul qilish jurnali (TZ §3, 4M.2).
///
/// APPEND-ONLY. Hech qachon UPDATE/DELETE qilinmaydi — nizo bo'lganda yozma iz
/// shu yerda qoladi va u ham xodimni, ham menejerni himoya qiladi (§3.3).
/// Naqsh `SupplyApprovalEvent` dan olingan (bir xil maydon nomlari ataylab):
/// shu sababli erkin matn `comment`, tafsilot esa `detail` deb ataladi.
///
/// Egaga haftalik nazorat xulosasi (M-Q7) AYNAN shu jadvaldan chiqadi: nechta
/// tuzatma, qancha summaga, kim ko'p tuzatgan.
/// Oylikning TUZATUVCHI QATORI (menejer KPI TZ §3.4).
///
/// Eskirgan kun qayta qabul qilinganda to'langan raqam QAYTA YOZILMAYDI —
/// farq shu yerda alohida yozuv bo'lib qoladi va **tuzatma sanasi** tushgan
/// oyga kiradi (iyul kunining avgustdagi xatosi → avgust oyligi).
///
/// Append-only: yozuv hech qachon o'chirilmaydi/tahrirlanmaydi. Bir kun bir
/// necha marta eskirsa — bir necha tuzatma qatori bo'ladi, har biri o'z
/// oyiga tushadi.
model EmployeeKpiCorrection {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  dailyKpiId String @map("daily_kpi_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Tuzatilgan KUN (oylik davri emas) — «qaysi kun uchun» savoliga javob.
  kpiDate DateTime @map("kpi_date") @db.Date

  /// Tuzatma QAYSI oylikka kiradi: `YYYY-MM`, tuzatma sanasidan.
  period String @db.VarChar(7)

  /// Oldingi qabulda muzlatilgan fakt.
  previousMinor BigInt @map("previous_minor")
  /// Yangi qabuldagi fakt.
  nextMinor     BigInt @map("next_minor")
  /// `next − previous`. Manfiy = xodimga ortiqcha to'langan (ushlanma).
  diffMinor     BigInt @map("diff_minor")
  /// 'increase' | 'decrease' — hisobot filtri (indekssiz skanerdan qochish).
  direction     String @db.VarChar(20)

  /// Kim qayta qabul qilgan.
  acceptedById String?  @map("accepted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dailyKpi   EmployeeDailyKpi  @relation(fields: [dailyKpiId], references: [id], onDelete: Cascade)
  employee   Employee          @relation("EmployeeKpiCorrectionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  acceptedBy Employee?         @relation("EmployeeKpiCorrectionActor", fields: [acceptedById], references: [id], onDelete: SetNull)

  /// Oylik hisoblash so'rovi: xodim × davr.
  @@index([accountId, employeeId, period])
  /// «Bu oyda qancha tuzatma bo'ldi» — egaga haftalik/oylik xulosa.
  @@index([accountId, period, createdAt(sort: Desc)])
  @@map("employee_kpi_corrections")
}

model EmployeeDailyKpiEvent {
  id         String           @id @default(uuid()) @db.Uuid
  accountId  String           @map("account_id") @db.Uuid
  dailyKpiId String           @map("daily_kpi_id") @db.Uuid
  dailyKpi   EmployeeDailyKpi @relation(fields: [dailyKpiId], references: [id], onDelete: Cascade)
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Tuzatmada (`adjust`) holat o'zgarmaydi — `fromState` va `toState` teng
  /// bo'ladi. Nullable qilinmadi: bo'sh ustun so'rovlarni murakkablashtiradi.
  fromState String @map("from_state") @db.VarChar(20)
  toState   String @map("to_state") @db.VarChar(20)

  /// `daily-kpi-fsm.ts` dagi DAILY_KPI_ACTION qiymati.
  action String @db.VarChar(30)

  /// system | manager | employee | owner (FSM'dagi ACTOR).
  actorType String  @map("actor_type") @db.VarChar(20)
  actorId   String? @map("actor_id") @db.Uuid

  /// Yopiq ro'yxatdan (FSM REASON_CODES). `other` bo'lsa izoh MAJBURIY.
  reasonCode String? @map("reason_code") @db.VarChar(40)
  comment    String? @db.Text

  /// Tuzatma tafsiloti: `{ metricKey, was, now }` — «nima o'zgardi» shundan.
  detail Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Shu o'tish keltirib chiqargan pul yozuvi (MK01) — hodisadan pulga izchil
  /// iz. Bo'sh bo'lishi normal: har o'tish pul yozmaydi.
  bonusFineLogs HrBonusFineLog[]

  // Kun kartochkasidagi tarix.
  @@index([accountId, dailyKpiId, createdAt])
  // Egaga haftalik xulosa: «shu haftada nima bo'ldi».
  @@index([accountId, createdAt(sort: Desc)])
  // «Kim ko'p tuzatgan» va sabab-kodi statistikasi.
  @@index([accountId, action, createdAt(sort: Desc)])
  @@map("employee_daily_kpi_events")
}

/// EmployeeKpiTarget — 🆕 KPI-01: XODIMGA BIRIKTIRILGAN maqsad («todo» qatlami).
///
/// ## Nega yangi jadval
/// Bugun bitta xodimga bitta KPI biriktirish TO'RT jadval talab qiladi:
/// `KpiMetricDef` → `KpiProfile` → `KpiProfileVersion` → `KpiProfileMetric`,
/// ustiga og'irliklar 100% ga yig'ilishi kerak (bitta KPI qo'shish = qolganini
/// qayta muvozanatlash) va saqlash YANGI VERSIYA yozadi. Bu — «todo»ning aksi.
/// Shu jadval mustaqil QATOR beradi: xodim × metrika × davr → maqsad.
///
/// ## 🔴 VERSIYALANMAYDI — tarixni per-kun snapshot muzlatadi
/// `KpiProfileVersion` ning maqsadi «o'tgan oyning raqami o'zgarmasin» edi.
/// O'sha kafolatni bu qatlam versiyasiz oladi: `EmployeeDailyKpiMetric`
/// o'sha kungi maqsad+faktni allaqachon MUHRLAB saqlaydi (tan-narx muzlatish
/// klassi). Shuning uchun bu yerdagi tahrir faqat **kelajak** kunlarga ta'sir
/// qiladi; o'tgan kunlar o'z muhridan o'qiydi. (Muhrlash ko'prigi — KPI-03.)
///
/// ## Og'irlik IXTIYORIY — «todo» ning yagona manbai
/// `weight = NULL` → KPI o'lchanadi/kuzatiladi, lekin oylik ballga KIRMAYDI.
/// Og'irlik qo'yilsa — formal ballash yo'li (payroll) buzilmagan holda ishlaydi
/// (normalizatsiya — KPI-05).
model EmployeeKpiTarget {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// `kpi_metric_defs.key` ga ishora — built-in katalog kaliti YOKI menejer
  /// qo'lda kiritgan (custom) kalit. FK ATAYLAB YO'Q: built-in metrikaning
  /// hisob bo'yicha `kpi_metric_defs` qatori bo'lmasligi mumkin (katalogning
  /// asl manbai — kod, `kpi-metrics.ts`), FK esa ularni bloklardi.
  metricKey String @map("metric_key") @db.VarChar(50)

  /// 🔴 `money` | `count` | `percent` | `minutes` — metrikaning birligi QATORDA
  /// DENORMALLASHTIRILGAN. Nega: `currency` ni birlik bilan bog'lovchi CHECK
  /// boshqa jadvalni (`kpi_metric_defs.unit`) KO'RA OLMAYDI, ya'ni birliksiz
  /// CHECK yozib bo'lmaydi. Naqsh `sales_plans.plan_type` bilan bir xil.
  /// Yozuvchi (KPI-02 servisi) buni katalogdan oladi — qo'lda kiritilmaydi.
  unit String @db.VarChar(10)

  /// Maqsad — metrikaning O'Z birligida, butun son (pul = tiyin, dona = dona).
  /// NULL = RAQAMSIZ maqsad («todo»: faqat bajarildi/bajarilmadi). 0 EMAS —
  /// «maqsad 0» har qanday faktni «bajarildi» qilib ko'rsatardi.
  targetValue BigInt? @map("target_value")

  /// `daily` | `weekly` | `monthly` (TZ §2.5 lug'ati). Haftalik/oylik qator
  /// kunlik ballga JIMGINA bo'linmaydi — u faqat o'z davri so'rovida qaytadi.
  period String @db.VarChar(10)

  /// Kompozit oylik balldagi og'irlik. NULL = **ballash yo'lidan tashqarida**
  /// (faqat kuzatiladi). 0 dan farqi bor: 0 «ballandi va nolga arziydi» degani.
  weight Decimal? @db.Decimal(5, 2)

  /// FAQAT `unit = 'money'` da to'ldiriladi va o'shanda MAJBURIY (CHECK).
  /// Sanoq/vaqt turida NULL bo'lishi SHART — aks holda «5 ta mijoz UZS da»
  /// yozuvi paydo bo'lib, kimdir uni konvertatsiya qilishga urinardi.
  currency String? @db.VarChar(3)

  /// Dvigatel HISOBLAY OLMAYDIGAN (qo'lda/custom) metrika uchun menejerning
  /// «bajarildi» belgisi. O'lchanadigan metrikada E'TIBORSIZ qoldiriladi —
  /// fakt har doim dvigateldan keladi (ikki manba = ikki haqiqat).
  manualDoneAt DateTime? @map("manual_done_at") @db.Timestamptz()

  /// `false` = arxiv: qator tarixda qoladi, yangi kunlarga ta'sir qilmaydi.
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("EmployeeKpiTargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy Employee? @relation("EmployeeKpiTargetActor", fields: [createdById], references: [id], onDelete: SetNull)

  events EmployeeKpiTargetEvent[]

  /// Takror maqsad yo'q — tahrir o'rniga in-place update (upsert kaliti).
  @@unique([employeeId, metricKey, period])
  /// Xodim kartasi: «shu xodimning faol KPI'lari».
  @@index([accountId, employeeId, active])
  /// Menejer ekrani: «shu metrika bo'yicha kimga qo'yilgan».
  @@index([accountId, metricKey])
  @@map("employee_kpi_targets")
}

/// EmployeeKpiTargetEvent — biriktirilgan KPI jurnali. APPEND-ONLY.
///
/// Nega kerak: ommaviy/bir martalik tahrir audit yozmasa «kim qachon maqsadni
/// pasaytirdi» savoliga javob qolmaydi (bu repoda bir marta bo'lgan hodisa).
///
/// `targetId` NULLABLE va `onDelete: SetNull` — maqsad qatori O'CHIRILSA event
/// QOLADI. Shu sababli payload HAVOLA emas, o'sha ondagi qiymatlar MATNI:
/// qator ketgach ham «nima edi» savoliga javob shu ustundan chiqadi.
model EmployeeKpiTargetEvent {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  targetId  String? @map("target_id") @db.Uuid
  /// Maqsad o'chsa ham «kimning KPI'si edi» ma'lum qolishi uchun ALOHIDA ustun.
  employeeId String @map("employee_id") @db.Uuid

  /// `created` | `updated` | `deleted` | `marked_done` | `reopened`.
  action String @db.VarChar(20)

  /// O'sha ondagi qiymatlar (metricKey, targetValue, period, weight, …).
  payloadJson Json    @map("payload_json")
  actorId     String? @map("actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  target   EmployeeKpiTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  employee Employee           @relation("EmployeeKpiTargetEventEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  actor    Employee?          @relation("EmployeeKpiTargetEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Xodim kartasidagi «KPI tarixi».
  @@index([accountId, employeeId, createdAt(sort: Desc)])
  /// Bitta maqsad qatorining tarixi.
  @@index([accountId, targetId, createdAt(sort: Desc)])
  @@map("employee_kpi_target_events")
}

model HrKpiMonthlyScore {
  id                 String  @id @default(uuid()) @db.Uuid
  accountId          String  @map("account_id") @db.Uuid
  employeeId         String  @map("employee_id") @db.Uuid
  yearMonth          String  @map("year_month") @db.VarChar(7)
  totalSalesMinor    BigInt  @map("total_sales_minor")
  targetMinor        BigInt  @map("target_minor")
  achievementPercent Decimal @map("achievement_percent") @db.Decimal(6, 2)
  tierPayoutPercent  Decimal @map("tier_payout_percent") @db.Decimal(6, 2)
  kpiEarnedMinor     BigInt  @map("kpi_earned_minor")
  fixComponentMinor  BigInt  @map("fix_component_minor")
  bonusSumMinor      BigInt  @map("bonus_sum_minor")
  fineSumMinor       BigInt  @map("fine_sum_minor")
  commissionMinor    BigInt  @map("commission_minor")
  finalSalaryMinor   BigInt  @map("final_salary_minor")

  /// Oylikka KIRGAN kunlar soni — menejer qabul qilganlari (4M.3, M-Q8).
  acceptedDays Int @default(0) @map("accepted_days")

  /// Qabul KUTAYOTGAN kunlar soni. Oylik hujjatida ko'rsatiladi — buxgalter
  /// ko'r-ko'rona to'lamasin (TZ §4.4). 0 dan katta bo'lsa hisob CHALA.
  pendingDays Int @default(0) @map("pending_days")

  /// Qabul qilinmagani uchun hisobga KIRMAGAN sotuv summasi.
  /// Yashirilmaydi: «nega oylik kam» degan savolga javob shu ustunda,
  /// aks holda blok sabab-noma'lum kamayish bo'lib ko'rinardi.
  blockedSalesMinor BigInt @default(0) @map("blocked_sales_minor")

  /// TZ §3.4 — eskirgan kunlar tuzatmasi. Qo'shimcha to'lov va ushlanma
  /// ALOHIDA: buxgalter hujjatda ikkalasini alohida qator qilib ko'rsatadi,
  /// «sof −50 000» bitta raqami unga yetarli emas.
  correctionIncreaseMinor BigInt @default(0) @map("correction_increase_minor")
  /// Ushlanma MUSBAT son sifatida saqlanadi («ushlandi: 50 000»).
  correctionDecreaseMinor BigInt @default(0) @map("correction_decrease_minor")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz()

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee @relation("HrKpiMonthlyEmployee", fields: [employeeId], references: [id])

  @@unique([accountId, employeeId, yearMonth])
  @@index([accountId, yearMonth])
  @@map("hr_kpi_monthly_score")
}

model HrEmployeePermission {
  id          String  @id @default(uuid()) @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  pageKey     String  @map("page_key") @db.VarChar(50)
  section     String? @db.VarChar(50)
  accessLevel String  @default("read") @map("access_level") @db.VarChar(20)

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee @relation("HrPermEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([accountId, employeeId, pageKey, section])
  @@map("hr_employee_permission")
}

model HrRole {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  value     String  @db.VarChar(50)
  label     String  @db.VarChar(100)
  isDefault Boolean @default(false) @map("is_default")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, value])
  @@map("hr_role")
}

// === HR GPS-davomat (avtomatik keldi/ketdi) ===
// TZ: docs/superpowers/specs/2026-07-23-hr-gps-attendance-design.md

/// A work-location geofence (filial). Employees are assigned to one; their
/// browser PWA pings GPS and the backend auto-marks keldi/ketdi within radius.
model HrWorkLocation {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  name         String   @db.VarChar(150)
  lat          Float
  lng          Float
  radiusMeters Int      @default(150) @map("radius_meters")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account         Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employees       Employee[]         @relation("EmployeeWorkLocation")
  branchEmployees HrEmployeeBranch[] @relation("BranchEmployees")

  @@index([accountId, archived])
  @@map("hr_work_locations")
}

/// Per-employee weekly work schedule (one row per weekday).
/// weekday: 0=Sunday … 6=Saturday (JS getDay convention — LOCKED).
model EmployeeWorkSchedule {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  weekday    Int
  startTime  String  @map("start_time") @db.VarChar(5) // "09:00"
  endTime    String  @map("end_time") @db.VarChar(5) // "18:00"
  isDayOff   Boolean @default(false) @map("is_day_off")

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee @relation("EmployeeSchedule", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday])
  @@index([accountId, employeeId])
  @@map("employee_work_schedules")
}

/// GPS ping stream — audit + state-machine source. Retained 7 days, then a
/// cron deletes them; only HrAttendance (keldi/ketdi) is permanent.
model HrLocationPing {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  lat        Float
  lng        Float
  accuracy   Int
  inside     Boolean
  /// Instantaneous GPS speed (m/s) — nullable (older/geofence pings omit it).
  /// Used by FIELD-mode stop-detection (TZ 2026-07-28 §7) alongside displacement.
  speed      Float?
  /// GPS heading 0–360° — nullable. Drives the live-map marker direction.
  heading    Float?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, employeeId, createdAt(sort: Desc)])
  @@map("hr_location_pings")
}

// === HR haydovchi jonli-tracking (TZ 2026-07-28-hr-driver-tracking-design.md) ===

/// Bitta yetkazma: haydovchi ↔ manzil. ETA shu trip destatsiyasiga hisoblanadi.
/// `accountId` — plain scalar (Account back-relation'siz; ko'p-ijara filtri +index
/// orqali), asosiy referensial butunlik `driver` FK'da. Cascade migration SQL'da.
model DriverTrip {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  driverId       String    @map("driver_id") @db.Uuid
  // Manba hujjat (ixtiyoriy — qo'lda ham yaratiladi)
  orderType      String?   @map("order_type") @db.VarChar(20) // 'demand' | 'retail_sale' | 'manual'
  orderId        String?   @map("order_id") @db.Uuid
  // Manzil (gibrid: avto-geocode + qo'lda tuzatilishi mumkin)
  destLat        Float     @map("dest_lat")
  destLng        Float     @map("dest_lng")
  destAddress    String?   @map("dest_address")
  geocodeSource  String    @default("manual") @map("geocode_source") @db.VarChar(10) // 'auto' | 'manual'
  // Holat-mashina: assigned → enroute → arrived → completed | cancelled
  status         String    @default("assigned") @map("status") @db.VarChar(12)
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz()
  startedAt      DateTime? @map("started_at") @db.Timestamptz()
  arrivedAt      DateTime? @map("arrived_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  // Oxirgi hisoblangan ETA (SSE push manbai)
  distanceMeters Int?      @map("distance_meters")
  etaSeconds     Int?      @map("eta_seconds")
  etaComputedAt  DateTime? @map("eta_computed_at") @db.Timestamptz()

  driver Employee @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([accountId, driverId, status])
  @@index([accountId, status])
  @@map("driver_trips")
}

/// Haydovchi ish-smenasi — grafiksiz ish o'lchovi (jadval-kechikish EMAS).
/// Yig'ma (km/active/stop/deliveries) ping-oqimidan hisoblanadi.
model DriverShift {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  startedAt       DateTime  @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  distanceMeters  Int       @default(0) @map("distance_meters")
  activeSeconds   Int       @default(0) @map("active_seconds")
  stopSeconds     Int       @default(0) @map("stop_seconds")
  deliveriesCount Int       @default(0) @map("deliveries_count")
  autoClosed      Boolean   @default(false) @map("auto_closed")

  driver Employee @relation("DriverShifts", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([accountId, driverId, startedAt(sort: Desc)])
  // PARTIAL UNIQUE (xom-SQL migratsiyada, Prisma modellay olmaydi — Employee username
  // partial index kabi): `driver_shifts_one_open_per_driver ON (account_id, driver_id)
  // WHERE ended_at IS NULL` — har haydovchida bir vaqtda bitta ochiq smena.
  // `migrate dev` bu indexni diff'да ko'rsatadi (DROP taklif qiladi) — QO'LLAMA.
  @@map("driver_shifts")
}

/// Haydovchi mijozdan olgan NAQD pulning kassaga topshirilishi (HR TZ §7.2).
///
/// Nega alohida jadval: haydovchi pulni OLGAN payt bilan kassaga TOPSHIRGAN
/// payt orasida vaqt bor va shu oraliqda pul «haydovchining qo'lida» turadi.
/// Buni hech qayerda yozmasak, kassa qoldig'i bilan real pul o'rtasidagi farq
/// ko'rinmaydi va «kim qancha ushlab turibdi» degan savolga javob bo'lmaydi.
///
/// Pul HARAKATI bu jadvalda EMAS: topshirish qabul qilinganda mavjud auditlangan
/// `CashIn` (ПКО) hujjati yaratilib post qilinadi va `cashInId` shu yerga
/// bog'lanadi. Ya'ni bu jadval — kassa kirimining SABABI va kutish holati,
/// pul reyestrining dublikati emas (aks holda bir summa ikki marta sanalardi).
model DriverCashHandover {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  driverId String  @map("driver_id") @db.Uuid
  /// Qaysi smenada olingan (yig'ma hisobot uchun). Smena yopilib ketsa ham
  /// yozuv qoladi — shuning uchun SetNull, Cascade EMAS.
  shiftId  String? @map("shift_id") @db.Uuid
  /// Qaysi yetkazmadan (ixtiyoriy — telefon buyurtmasi bo'lishi mumkin).
  tripId   String? @map("trip_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")
  currency    String @default("UZS") @db.VarChar(3)

  /// 'pending' = haydovchining qo'lida · 'handed' = kassaga topshirilgan ·
  /// 'cancelled' = xato yozuv (pul aslida olinmagan).
  status String @default("pending") @db.VarChar(12)

  collectedAt DateTime  @default(now()) @map("collected_at") @db.Timestamptz()
  handedAt    DateTime? @map("handed_at") @db.Timestamptz()

  /// Pulni qabul qilgan kassir.
  acceptedById String? @map("accepted_by_id") @db.Uuid
  /// Yaratilgan ПКО — pul harakatining YAGONA manbai.
  cashInId     String? @map("cash_in_id") @db.Uuid

  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Optimistik qulf — ikki kassir bir vaqtda qabul qilib ikki ПКО yaratmasin.
  version   Int      @default(1)

  driver     Employee  @relation("DriverCashCollected", fields: [driverId], references: [id], onDelete: Cascade)
  acceptedBy Employee? @relation("DriverCashAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([accountId, driverId, status])
  @@index([accountId, status, collectedAt(sort: Desc)])
  @@map("driver_cash_handovers")
}

model HrNotificationTemplate {
  id                    String  @id @default(uuid()) @db.Uuid
  accountId             String  @map("account_id") @db.Uuid
  docType               String  @map("doc_type") @db.VarChar(50)
  eventType             String  @map("event_type") @db.VarChar(50)
  templateText          String  @map("template_text")
  isActive              Boolean @default(true) @map("is_active")
  largeSaleMinThreshold BigInt? @map("large_sale_min_threshold")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, docType, eventType])
  @@map("hr_notification_template")
}

model HrActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actor   Employee? @relation("HrActivityActor", fields: [actorId], references: [id])

  @@index([accountId, createdAt(sort: Desc)])
  @@index([accountId, entityType, entityId, createdAt(sort: Desc)])
  @@map("hr_activity_log")
}

// === HR TimePay davomat yadrosi (Bo'lim / Lavozim / Jadval / multi-branch) ===
// TZ: docs/superpowers/specs/2026-07-24-hr-timepay-attendance-core-design.md §4.
// Additive-only, account-scoped, soft-delete via `archived` (mirror HrWorkLocation).

/// Bo'lim (TimePay "Bo'lim"). Name only; assigned 1:many to employees.
model HrDepartment {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(150)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employees Employee[] @relation("EmployeeDepartment")

  @@index([accountId, archived])
  @@map("hr_departments")
}

/// Lavozim (TimePay "Lavozim"). Name only; assigned 1:many to employees.
/// Distinct from the legacy free-text Employee.position VarChar (kept for back-compat).
model HrPosition {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String   @db.VarChar(150)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employees   Employee[]   @relation("EmployeePosition")
  kpiProfiles KpiProfile[]

  @@index([accountId, archived])
  @@map("hr_positions")
}

/// Ish jadvali (TimePay "Ish jadvali"). Cycle-based schedule template.
/// type: 'flexible' (Moslashuvchan) | 'free' (Erkin) — VarChar+comment,
/// mirrors HrAttendance.source VarChar(12) 'auto_gps'|'manual'.
model HrSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  name            String   @db.VarChar(150)
  type            String   @default("flexible") @db.VarChar(12) // 'flexible' | 'free'
  startDate       DateTime @map("start_date") @db.Date // cycle anchor, Asia/Tashkent calendar date (DATE not Timestamptz)
  cycleDays       Int      @map("cycle_days") // Sikl (1..N)
  calcOvertime    Boolean  @default(false) @map("calc_overtime") // "Qo'shimcha ish vaqtini hisoblash"
  extendedWorkMin Int      @default(0) @map("extended_work_min") // "Uzaytirilgan ish vaqti", minutes
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  days      HrScheduleDay[]
  employees Employee[]      @relation("EmployeeSchedule2")

  @@index([accountId, archived])
  @@map("hr_schedules")
}

/// One row per cycle day (TimePay "Kun N" grid). dayIndex 1..cycleDays.
/// Times as "HH:mm" VarChar(5), mirroring EmployeeWorkSchedule.
/// break/times nullable so a day-off (isWorkday=false) can omit them.
model HrScheduleDay {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  scheduleId String  @map("schedule_id") @db.Uuid
  dayIndex   Int     @map("day_index") // 1..cycleDays
  isWorkday  Boolean @default(true) @map("is_workday") // "Ish kuni"
  startTime  String? @map("start_time") @db.VarChar(5) // "09:00"
  endTime    String? @map("end_time") @db.VarChar(5) // "18:00"
  breakStart String? @map("break_start") @db.VarChar(5) // "13:00"
  breakEnd   String? @map("break_end") @db.VarChar(5) // "14:00"

  account  Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schedule HrSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayIndex])
  @@index([accountId, scheduleId])
  @@map("hr_schedule_days")
}

/// Employee ↔ Branch (HrWorkLocation) many-to-many join. Composite PK.
/// Employee.workLocationId stays as the primary/default branch (back-compat);
/// this join holds the full assigned set (TimePay multi-branch).
model HrEmployeeBranch {
  accountId      String   @map("account_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  workLocationId String   @map("work_location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee     Employee       @relation("EmployeeBranches", fields: [employeeId], references: [id], onDelete: Cascade)
  workLocation HrWorkLocation @relation("BranchEmployees", fields: [workLocationId], references: [id], onDelete: Cascade)

  @@id([employeeId, workLocationId])
  @@index([accountId, workLocationId])
  @@map("hr_employee_branches")
}

// =====================================================================
// Analitika module — bolt-on analytics/inventory-counting domain.
// Additive-only: plain scalar UUID columns (no @relation to core tables)
// so migrations never ALTER existing tables. Referential integrity is
// enforced at the application layer. "expectedQty" snapshots Stock at
// count time ("REGOS qoldig'i" in the spec = local stock).
// =====================================================================

model AnalitikaCount {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  expectedQty    Decimal   @map("expected_qty") @db.Decimal(20, 6)
  kamQty         Decimal   @default(0) @map("kam_qty") @db.Decimal(20, 6)
  kopQty         Decimal   @default(0) @map("kop_qty") @db.Decimal(20, 6)
  netQty         Decimal   @map("net_qty") @db.Decimal(20, 6)
  salePriceMinor BigInt    @map("sale_price_minor")
  status         String    @db.VarChar(10) // green | yellow | red
  decision       String?   @db.VarChar(12) // accepted | rejected | null
  counterId      String    @map("counter_id") @db.Uuid
  countedAt      DateTime  @default(now()) @map("counted_at") @db.Timestamptz()
  reviewerId     String?   @map("reviewer_id") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz()
  reasonCodeId   String?   @map("reason_code_id") @db.Uuid
  note           String?

  @@unique([accountId, productId, storeId])
  @@index([accountId, status, countedAt(sort: Desc)])
  @@index([accountId, counterId])
  @@map("analitika_counts")
}

model AnalitikaReasonCode {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  label     String  @db.VarChar(100)
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([accountId, label])
  @@index([accountId, active])
  @@map("analitika_reason_codes")
}

model AnalitikaVarianceConfig {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @unique @map("account_id") @db.Uuid
  greenMaxPct  Decimal @default(5) @map("green_max_pct") @db.Decimal(6, 2)
  yellowMaxPct Decimal @default(15) @map("yellow_max_pct") @db.Decimal(6, 2)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("analitika_variance_configs")
}

model AnalitikaOrder {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  number         String   @db.VarChar(40)
  counterpartyId String?  @map("counterparty_id") @db.Uuid
  state          String   @default("formed") @db.VarChar(20) // draft | formed | done
  totalMinor     BigInt   @default(0) @map("total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lines AnalitikaOrderLine[]

  @@unique([accountId, number])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("analitika_orders")
}

model AnalitikaOrderLine {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  qty        Decimal @db.Decimal(20, 6)
  priceMinor BigInt  @map("price_minor")
  sumMinor   BigInt  @map("sum_minor")

  order AnalitikaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([accountId, productId])
  @@map("analitika_order_lines")
}

/// moysklad «Привязать документ» — a MANUAL association between two documents,
/// shown in the «Связанные документы» tab (the auto-linked FK chain is computed
/// separately per doc). Polymorphic: {source,target}Type is the PascalCase model
/// name. Each row also snapshots both endpoints' display fields (name/date/sum/
/// state) captured at link time, so the related panel renders each linked card
/// without a cross-model resolution map. A link is bidirectional: querying by
/// either endpoint returns the OTHER endpoint's snapshot.
model DocumentLink {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  sourceType String @map("source_type") @db.VarChar(64)
  sourceId   String @map("source_id") @db.Uuid
  targetType String @map("target_type") @db.VarChar(64)
  targetId   String @map("target_id") @db.Uuid

  sourceName     String   @map("source_name") @db.VarChar(255)
  sourceMoment   DateTime @map("source_moment") @db.Timestamptz()
  sourceSumMinor BigInt   @map("source_sum_minor")
  sourceState    String   @default("draft") @map("source_state") @db.VarChar(32)
  targetName     String   @map("target_name") @db.VarChar(255)
  targetMoment   DateTime @map("target_moment") @db.Timestamptz()
  targetSumMinor BigInt   @map("target_sum_minor")
  targetState    String   @default("draft") @map("target_state") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([accountId, sourceType, sourceId, targetType, targetId], name: "document_links_unique")
  @@index([accountId, sourceType, sourceId])
  @@index([accountId, targetType, targetId])
  @@map("document_links")
}

// ===== Sherset KEEP: Debt models (climart sxemasida yo'q — qo'shildi B2) =====
/// Mijozga berilgan qarz. `paidMinor` — barcha to'lovlar yig'indisi
/// (denormalizatsiya: ro'yxat/saralash tez ishlashi uchun; yagona haqiqat
/// manbai `debt_payments` — DebtService har yozuvdan keyin qayta hisoblaydi).
model Debt {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  counterpartyId String @map("counterparty_id") @db.Uuid

  /// Avto-raqam: QRZ-YYYY-NNNNN (document_sequences orqali, race-safe).
  name String @db.VarChar(50)

  /// Umumiy qarz summasi (tiyin).
  totalMinor BigInt @map("total_minor")
  /// To'langan summa (tiyin) — payments yig'indisi.
  paidMinor  BigInt @default(0) @map("paid_minor")
  currency   String @default("UZS") @db.VarChar(3)

  /// TZ §4: 'unpaid' | 'partial' | 'paid'. `paid` ⇒ qarzdorlar ro'yxatidan chiqadi.
  status String @default("unpaid") @db.VarChar(20)

  /// TZ §3.3 — qarz berishda MAJBURIY: keyingi qo'ng'iroq/to'lov vaqti.
  /// Qarz to'liq yopilganda (§3.6) endi kerak emas ⇒ null'ga tushadi.
  nextContactAt DateTime? @map("next_contact_at") @db.Timestamptz()

  /// Oxirgi qo'ng'iroq belgisi (2026-07-12 talab): operator «qo'ng'iroq qilindi»
  /// deb saqlaganda to'ladi. Outcome — suhbat natijasi:
  /// 'paid_full' | 'paid_partial' | 'not_paid' | 'callback'.
  /// «Qo'ng'iroq qilinganlar» bo'limi shu maydonlardan filtrlanadi.
  lastCallAt      DateTime? @map("last_call_at") @db.Timestamptz()
  lastCallOutcome String?   @map("last_call_outcome") @db.VarChar(20)
  /// Eslatma-cron dedup belgisi: nextContactAt uchun bildirishnoma yuborilgan
  /// payt. Yangi nextContactAt qo'yilganda NULL'ga tushadi — keyingi muddat
  /// uchun eslatma qayta ishlaydi.
  callRemindedAt  DateTime? @map("call_reminded_at") @db.Timestamptz()

  /// 15-KUNLIK MIJOZGA TAKROR TELEGRAM ESLATMASI (2026-07-16 talab) dedup belgisi:
  /// mijozning O'ZIGA «qarzingiz bor» avtomatik eslatmasi oxirgi yuborilgan payt.
  /// Operatorning qo'ng'iroq jadvalidan (nextContactAt/callRemindedAt) ALOHIDA —
  /// bunga tegmaydi. null ⇒ hali yuborilmagan (birinchi eslatma createdAt'dan
  /// N kun o'tgach ketadi). Cron: har kuni, qarz qolgan bo'lsa har N kunda takror.
  lastTgReminderAt DateTime? @map("last_tg_reminder_at") @db.Timestamptz()

  /// MUAMMOLI MIJOZ (2026-07-14 talab). Operator qo'ng'iroq natijasini
  /// belgilaganda mijozni «muammoli» deb ajratib qo'yishi mumkin: telefonni
  /// ko'tarmaydi, va'da berib bermaydi, janjal qiladi va h.k.
  ///
  /// Bu `lastCallOutcome` dan ALOHIDA o'q: mijoz «qisman to'ladi» bo'lib ham,
  /// ayni paytda muammoli bo'lishi mumkin. Shuning uchun alohida bayroq.
  ///   problem       — «Muammoli qarzdorlar» bo'limi shundan filtrlanadi
  ///   problemReason — NIMA muammo (majburiy: sababsiz belgi foydasiz)
  ///   problemAt / problemById — qachon va kim belgilagan
  /// Muammo hal bo'lsa `problem=false` bo'ladi, lekin sabab MULOQOT TARIXIDA
  /// qoladi — kim, qachon, nega degani yo'qolmasin.
  problem       Boolean   @default(false)
  problemReason String?   @map("problem_reason")
  problemAt     DateTime? @map("problem_at") @db.Timestamptz()
  problemById   String?   @map("problem_by_id") @db.Uuid

  /// 🔴 BALANSDAN ADOPSIYA QILINGAN QATOR (P1, 2026-08-11).
  ///
  /// `true` ⇒ bu qator mijozning `CounterpartyBalance` dagi ALLAQACHON MAVJUD
  /// qarzini reyestrga olib kirish uchun to'lov paytida ochilgan
  /// (`pos-debt-payment.service.ts#adoptBalanceDebt`). Odatdagi `Debt.create`
  /// balansga `+totalMinor` yozadi (§7.3 simmetriyasi) — adopsiya qatori esa
  /// YOZMAYDI: qarz balansda bor, qo'shsak IKKI KARRA sanalardi.
  ///
  /// ⚠️ SIMMETRIYA MAJBURIY: `remove()` ham bunday qatorga `−totalMinor`
  /// yozmasligi shart, aks holda o'chirish mijozning qarzini yo'q qilardi.
  ///
  /// 🔴 YOZUVCHILAR ENDI UCHTA (Q2/Q5, 2026-08-25) — «faqat to'lov paytida»
  /// degan yuqoridagi jumla ESKIRGAN:
  ///   1. `pos-debt-payment.service.ts#adoptBalanceDebt` — to'lov paytida (P1);
  ///   2. `retail-sale.service.ts#writeSaleDebtRegistryRow` — chek POST
  ///      qilinganda (Q2), summasi §2.2 kesishuv qoidasi bo'yicha;
  ///   3. `scripts/ops-q5-backfill-sale-debts.ts` — tarixiy cheklar uchun
  ///      ommaviy backfill (Q5), `DebtNote` da `[Q5-BACKFILL run=…]` belgisi.
  /// Uchalasi ham `applyDelta` ni CHAQIRMAYDI va `recompute-counterparty-balances.ts`
  /// ning `debt.groupBy` bloki ularni `balanceAdopted: false` filtri bilan
  /// hujjat-hisobidan CHIQARADI. Reja:
  /// `docs/plans/2026-08-25-kassa-qarzi-undirish-reyestri.md`.
  balanceAdopted Boolean @default(false) @map("balance_adopted")

  /// 🔴 HUJJAT-MANBA BOG'LAMI (Q1, 2026-08-25 — kassa qarzini undirish reyestriga ulash).
  ///
  /// Qator qaysi hujjatdan tug'ilgani. Hozircha yagona qiymat — `'retailsale'`
  /// (POS cheki, Q2 yozuvchisi); `null` = qo'lda ochilgan yoki P1 adopsiya qatori.
  ///
  /// NEGA KERAK (uchta ish bitta bog'lamda):
  ///   1. **IDEMPOTENTLIK** — `@@unique([accountId, sourceDocType, sourceDocId])`
  ///      bitta chekdan ikkinchi qator tug'ilishiga yo'l qo'ymaydi (post
  ///      takrorlansa chaqiruvchi `P2002` ni tutadi);
  ///   2. **SIMMETRIYA MANZILI** — `refund()`/`edit()` (Q3) qatorni AYNAN
  ///      `sourceDocId = sale.id` bo'yicha topib, balans deltasiga teng
  ///      harakatlantiradi (invariant 2);
  ///   3. **MANBA KO'RSATISH** — undirish ekranida «bu qarz qayerdan keldi» (Q4)
  ///      va Q5 backfill'ining «allaqachon qatori bor» filtri.
  ///
  /// `balanceAdopted` BILAN MUNOSABATI: chekdan tug'ilgan qator HAR DOIM
  /// `balanceAdopted = true` bo'ladi — qarz mijoz balansiga `post()` da
  /// allaqachon yozilgan (`applyDelta(+debtAmount)`), reyestr qatori esa uni
  /// FAQAT KO'RINADIGAN qiladi. Ikkisi bir-birining o'rnini bosmaydi:
  /// `balanceAdopted` — «balansga yozamizmi?» degan PUL savoliga javob,
  /// `sourceDocType/sourceDocId` — «qaysi hujjatdan?» degan MANBA savoliga.
  ///
  /// ⚠️ Postgres'da nullable ustunlar bo'yicha unique indeks NULL larni
  /// TAKRORLANUVCHI sanamaydi (`NULL != NULL`), shuning uchun mavjud qatorlar
  /// (`NULL, NULL`) va kelajakda qo'lda ochiladigan qarzlar bir-biriga
  /// to'sqinlik qilmaydi — backfill kerak emas.
  sourceDocType String? @map("source_doc_type") @db.VarChar(32)
  sourceDocId   String? @map("source_doc_id") @db.Uuid

  /// Mas'ul xodim (call-markaz operatori) — ro'yxat filtri.
  ownerId    String? @map("owner_id") @db.Uuid
  /// Qarzni bergan kassir — §3.9 kunlik kassir hisoboti shu ustundan yig'iladi.
  issuedById String? @map("issued_by_id") @db.Uuid

  comment String?

  closedAt  DateTime? @map("closed_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  /// Soft-delete — korzina parity (hech qachon jismonan o'chmaydi).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty  @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  owner        Employee?     @relation("DebtOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  issuedBy     Employee?     @relation("DebtIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  payments     DebtPayment[]
  notes        DebtNote[]

  @@unique([accountId, name])
  /// Q1 (2026-08-25) — bitta hujjatdan ko'pi bilan BITTA reyestr qatori.
  /// NULL lar takrorlanuvchi sanalmaydi ⇒ qo'lda ochilgan qarzlar cheklanmaydi.
  @@unique([accountId, sourceDocType, sourceDocId])
  /// «Qarzdorlar ro'yxati» (§3.1) — status bo'yicha faol qarzlar.
  @@index([accountId, status, nextContactAt])
  /// «Bugungi qo'ng'iroqlar» (§3.5) — sana bo'yicha tanlash.
  @@index([accountId, nextContactAt])
  /// «Qo'ng'iroq qilinganlar» — kun kesimida tez tanlash.
  @@index([accountId, lastCallAt])
  @@index([accountId, counterpartyId])
  @@index([accountId, ownerId])
  @@index([accountId, issuedById, createdAt])
  // DB-08 (faza 25) — «Muammoli qarzdorlar» scope filters exactly on
  // (accountId, problem, status) (debt.service.ts scope==='problem').
  // A `WHERE problem` partial index would be smaller, but Prisma cannot declare
  // one — it would then be dropped by the next `migrate dev` diff — so the
  // drift-safe composite is used instead.
  @@index([accountId, problem, status])
  @@map("debts")
}

/// Qarz bo'yicha to'lov. Uch kanal (TZ §3.6 + §3.7):
///   'cash'            — kassada naqd            (kassir)
///   'terminal'        — kassada terminal/karta  (kassir)
///   'card_screenshot' — mijoz kartadan o'tkazdi, chek rasmi (operator)
/// §3.9: kassir hisobotiga faqat cash+terminal kiradi; card_screenshot
/// operator hisobotida ko'rinadi — shuning uchun `method` ustuni ajratuvchi.
model DebtPayment {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  debtId    String @map("debt_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")
  method      String @db.VarChar(20)

  /// §3.8 — «qayerdan qabul qilingani»: kassa nomi yoki «Karta — screenshot».
  sourceName String? @map("source_name") @db.VarChar(120)
  cashDeskId String? @map("cash_desk_id") @db.Uuid

  /// Qaysi kassa SMENASIDA qabul qilingani (kassa TZ §7.2/6-qadam).
  ///
  /// Busiz naqd qarz to'lovi smena yakunidagi «kutilgan naqd» hisobiga
  /// KIRMASDI va kassir har safar shu summaga ortiqcha chiqardi (soxta
  /// излишек). `cashDeskId` yetarli emas: bitta kassada kun davomida bir
  /// necha smena bo'ladi. NULL = POS'dan tashqarida qabul qilingan.
  retailShiftId String? @map("retail_shift_id") @db.Uuid

  /// Bitta POS to'lovining BARCHA qatorlarini bog'lovchi id (kassa TZ §7.2/5-qadam).
  ///
  /// Mijoz bitta summa beradi, u FIFO bo'yicha bir necha qarzga bo'linadi —
  /// ya'ni bitta jismoniy to'lov = N ta qator. PKO cheki esa BITTA hujjat.
  /// Busiz chekni qayta chop etish uchun qatorlarni (mijoz + vaqt + kassir)
  /// bo'yicha taxminan yig'ishga to'g'ri kelardi — moliyaviy hujjatda
  /// taxmin qabul qilinmaydi. NULL = eski (POS'dan tashqari) to'lovlar.
  batchId String? @map("batch_id") @db.Uuid

  /// §3.7 — chek rasmi. `attachments.id` (entity='debtpayment'). FK EMAS:
  /// attachment polimorf jadval, Prisma relation'i yo'q — id sifatida saqlanadi.
  attachmentId String? @map("attachment_id") @db.Uuid

  /// To'lov VALYUTASI (2026-07-13): mijoz naqdni so'mda ham, dollarda ham
  /// berishi mumkin. `amountMinor` HAR DOIM qarz valyutasida (so'm/tiyin) —
  /// qarz hisobi shundan yuritiladi. Quyidagi uchlik esa ASL to'lovni saqlaydi:
  ///   currency            — 'UZS' | 'USD'
  ///   amountOriginalMinor — asl valyutadagi summa (USD → sent)
  ///   exchangeRate        — kurs KANONIK ×10^8 (DB-01, Faza 16; rateValue
  ///                         bilan bir xil masshtab): 12 800,50 → 1280050000000.
  ///                         (2026-08-08 gacha ×10^4 edi — migratsiya o'tkazdi.)
  /// UZS to'lovda: currency='UZS', original=amountMinor, rate=null.
  currency            String  @default("UZS") @db.VarChar(3)
  amountOriginalMinor BigInt? @map("amount_original_minor")
  exchangeRate        BigInt? @map("exchange_rate")

  comment String?

  receivedById   String? @map("received_by_id") @db.Uuid
  /// 'cashier' | 'operator' — kim kiritgani (hisobotlarni ajratish uchun).
  receivedByRole String  @default("cashier") @map("received_by_role") @db.VarChar(20)

  /// TO'LOVNI QAYTARISH — storno (2026-07-16). Xato kiritilgan to'lov
  /// JISMONAN O'CHIRILMAYDI (tarix — dalil): reversed_at belgilanadi.
  /// reversed_at != NULL bo'lgan to'lov paidMinor yig'indisiga, kontragent
  /// balansiga va hisobotlarga KIRMAYDI, lekin ro'yxatlarda «qaytarilgan»
  /// belgisi bilan ko'rinadi — kim, qachon, nega qaytargani bilan.
  reversedAt    DateTime? @map("reversed_at") @db.Timestamptz()
  reversedById  String?   @map("reversed_by_id") @db.Uuid
  reverseReason String?   @map("reverse_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debt       Debt       @relation(fields: [debtId], references: [id], onDelete: Cascade)
  cashDesk   CashDesk?  @relation(fields: [cashDeskId], references: [id], onDelete: SetNull)
  receivedBy Employee?  @relation("DebtPaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  reversedBy Employee?  @relation("DebtPaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  /// Shu to'lovni yaratgan qo'ng'iroq-yozuv(lar)i (2026-07-16 — natija↔to'lov bog'lami).
  notes      DebtNote[] @relation("DebtNotePayment")

  @@index([accountId, debtId, createdAt(sort: Desc)])
  /// §3.9 kunlik kassir hisoboti — (kassir, kun) kesimi.
  @@index([accountId, receivedById, createdAt])
  @@index([accountId, method, createdAt])
  // Smena yakunidagi «kutilgan naqd» hisobi shu indeks bo yicha yig adi.
  @@index([retailShiftId])
  // PKO chekini qayta chop etish shu indeks bo'yicha yig'adi.
  @@index([accountId, batchId])
  @@map("debt_payments")
}

/// Mijoz bilan muloqot tarixi (TZ §3.4). Hech qachon o'chirilmaydi/ustidan
/// yozilmaydi — append-only. `nextContactAt` shu yozuvda kelishilgan keyingi
/// aloqa vaqti; DebtService uni Debt.nextContactAt'ga ko'chiradi (oxirgisi kuchda).
model DebtNote {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  debtId    String @map("debt_id") @db.Uuid

  text          String
  nextContactAt DateTime? @map("next_contact_at") @db.Timestamptz()

  /// Qo'ng'iroq NATIJASI (kind='call' yozuvlarda, 2026-07-12):
  /// 'paid_full' | 'paid_partial' | 'not_paid' | 'callback' | null (oddiy izoh).
  outcome String? @db.VarChar(20)

  /// Shu qo'ng'iroqda YARATILGAN to'lov (2026-07-16 — natijani BEKOR QILISH).
  /// paid_full/paid_partial natija to'lov yozuvi ochadi; bog'lam orqali natija
  /// bekor qilinganda to'lov ham storno bo'ladi (va aksincha), lastCallOutcome
  /// esa qolgan JONLI yozuvlardan deterministik qayta hisoblanadi.
  paymentId String? @map("payment_id") @db.Uuid

  /// NATIJANI BEKOR QILISH (2026-07-16): yozuv O'CHMAYDI — belgilanadi.
  /// canceled_at != NULL yozuv lastCallOutcome hisobiga KIRMAYDI, tarixda
  /// «bekor qilingan» ko'rinishida qoladi (kim, qachon, nega).
  canceledAt   DateTime? @map("canceled_at") @db.Timestamptz()
  canceledById String?   @map("canceled_by_id") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  authorId   String? @map("author_id") @db.Uuid
  /// 'operator' | 'cashier' | 'admin' — §3.4: yozuvda rol ko'rsatiladi.
  authorRole String  @default("operator") @map("author_role") @db.VarChar(20)
  /// Manba: 'call' (operator suhbati) | 'debt_issue' (§3.3) | 'payment' (§3.6 qisman).
  kind       String  @default("call") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debt       Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  author     Employee?    @relation("DebtNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  payment    DebtPayment? @relation("DebtNotePayment", fields: [paymentId], references: [id], onDelete: SetNull)
  canceledBy Employee?    @relation("DebtNoteCanceler", fields: [canceledById], references: [id], onDelete: SetNull)

  @@index([accountId, debtId, createdAt(sort: Desc)])
  @@index([accountId, authorId, createdAt])
  @@map("debt_notes")
}

/// POS qarz to'lovi IDEMPOTENTLIK reyestri (Faza 3, 2026-08-12).
///
/// NEGA ALOHIDA JADVAL: bitta jismoniy to'lov FIFO bo'yicha N ta `DebtPayment`
/// qatoriga bo'linadi, ya'ni kalitni o'sha qatorlarga qo'yib bo'lmaydi (unique
/// buzilardi). Bu jadval «bitta klient so'rovi = bitta chek (batch)» degan
/// shartnomani saqlaydi.
///
/// MUAMMO: kassa monoblokida tranzaksiya COMMIT bo'lib javob tarmoqda
/// yo'qolsa, kassir «Failed to fetch» ko'rib tugmani qayta bosadi ⇒ ikkinchi
/// to'lov to'plami yozilardi: yashiqqa ikkinchi kirim, smenaning «kutilgan
/// naqd»i ikki barobar, yopishda SOXTA KAMOMAD.
///
/// Klient tarmoq uzilishida AYNI `clientRequestId` bilan qayta yuboradi;
/// ikkinchi urinish unique konfliktga uchraydi va server BIRINCHI chekni
/// qaytaradi — pul ikki marta yozilmaydi.
model PosDebtPaymentRequest {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  clientRequestId String   @map("client_request_id") @db.Uuid
  /// Shu so'rov yaratgan PKO cheki (`DebtPayment.batchId`).
  batchId         String   @map("batch_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, clientRequestId])
  @@index([accountId, batchId])
  @@map("pos_debt_payment_requests")
}

// ===== Sherset KEEP: Telegram chat/backfill models (B3 closure) =====
model TelegramChat {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// Telegram chat id (client's private chat with the owner).
  chatId    BigInt  @map("chat_id")
  firstName String? @map("first_name") @db.VarChar(128)
  lastName  String? @map("last_name") @db.VarChar(128)
  username  String? @db.VarChar(64)

  /// Mijoz botga kontaktini ulashsa — telefon shu yerga tushadi va kontragent
  /// AVTOMATIK topiladi. Telegram Business xabarlarida telefon kelmaydi,
  /// shuning uchun u yerda ISM bo'yicha avtomatik taklif qilinadi.
  phone String? @db.VarChar(32)

  counterpartyId String? @map("counterparty_id") @db.Uuid
  /// Kontragent avtomatik topildimi (ism/telefon bo'yicha) yoki qo'lda bog'landimi.
  boundBy        String? @map("bound_by") @db.VarChar(10) // 'auto' | 'manual'

  /// Chat qayerdan keldi — xabar YUBORISH usuli shunga bog'liq:
  ///   'business' — egasining shaxsiy Telegram'i orqali (business_connection_id
  ///                bilan yuboriladi, mijoz egasining NOMIDAN xabar oladi)
  ///   'bot'      — mijoz botga o'zi yozgan (oddiy sendMessage)
  /// Noto'g'ri usul bilan yuborilsa Telegram xato qaytaradi, shuning uchun
  /// buni saqlab qo'yamiz.
  source String @default("business") @db.VarChar(10)

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  /// Backfill/sync kursorlari (2026-07-20 to'liq-tarix). historyOldestId —
  /// backfill'da yetilgan eng eski tgMessageId (orqaga sahifalash offsetId'si);
  /// historyComplete — dialog boshiga yetildi; syncNewestId — catch-up uchun
  /// eng yangi ma'lum tgMessageId (minId).
  historyOldestId BigInt? @map("history_oldest_id")
  historyComplete Boolean @default(false) @map("history_complete")
  syncNewestId    BigInt? @map("sync_newest_id")

  account      Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty?         @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  messages     TelegramChatMessage[]

  @@unique([accountId, chatId])
  @@index([accountId, counterpartyId])
  @@index([accountId, lastMessageAt(sort: Desc)])
  @@map("telegram_chats")
}

/// One message in a Telegram Business chat (both directions).
model TelegramChatMessage {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  chatRefId String @map("chat_ref_id") @db.Uuid

  /// 'in' = client wrote us; 'out' = sent from the owner's name.
  direction   String  @db.VarChar(3)
  text        String  @db.VarChar(4096)
  tgMessageId BigInt? @map("tg_message_id")
  senderName  String? @map("sender_name") @db.VarChar(128)

  /// MEDIA (2026-07-13): mijoz CHEK rasmini yuborganda ko'rinishi shart.
  /// Ilgari media'li xabar butunlay tashlab yuborilardi ("skip in V1") — chek
  /// yo'qolardi. Endi fayl Telegram'dan yuklab olinib, mavjud `attachments`
  /// jadvaliga yoziladi va chatda rasm bo'lib chiqadi.
  ///   kind       — 'text' | 'photo' | 'document' | 'voice' | 'video' | 'other'
  ///   fileId     — Telegram file_id (qayta yuklab olish uchun)
  ///   attachment — bizdagi nusxasi (yo'qolmasin: Telegram file_id muddatli)
  kind         String  @default("text") @db.VarChar(16)
  fileId       String? @map("file_id") @db.VarChar(200)
  fileName     String? @map("file_name") @db.VarChar(255)
  mimeType     String? @map("mime_type") @db.VarChar(100)
  attachmentId String? @map("attachment_id") @db.Uuid

  /// Avtomatik xabar bo'lsa — sababi ('debt_issued' | 'payment' | 'debt_closed'
  /// | 'reminder'). Qo'lda yozilgan xabarda null. Chatda belgisi ko'rinadi.
  autoKind String? @map("auto_kind") @db.VarChar(20)

  /// Forward qilingan xabaning asl jo'natuvchisi/kanal nomi (2026-07-20,
  /// Phase 2) — Telegram'dagi "Переслано от: X" ko'rsatkichi shu yerdan
  /// chiqadi. null = forward emas, oddiy xabar.
  fwdFromName String? @map("fwd_from_name") @db.VarChar(128)

  /// To'liq-tarix (2026-07-20). replyToTgMessageId — javob berilgan xabar
  /// (Faza-2 reply/quote uchun oldindan); editedAt — Telegram'da tahrirlangan
  /// vaqti; readByPeerAt — mijoz o'qigan vaqti (Faza-3 read-receipt uchun
  /// oldindan, nullable); outboxRefId — yetkazilgan HrTelegramOutbox qatoriga
  /// bog' (chiquvchi dedup).
  replyToTgMessageId BigInt?   @map("reply_to_tg_message_id")
  editedAt           DateTime? @map("edited_at") @db.Timestamptz()
  readByPeerAt       DateTime? @map("read_by_peer_at") @db.Timestamptz()
  outboxRefId        String?   @map("outbox_ref_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chat    TelegramChat @relation(fields: [chatRefId], references: [id], onDelete: Cascade)

  /// Bir chatda bitta tgMessageId — backfill/catch-up idempotent upsert kaliti
  /// (dublikat xabar yozilmaydi). tgMessageId NULL qatorlar (eski Bot API)
  /// Postgres multi-NULL bilan to'qnashmaydi.
  /// Chiquvchi AVTOMATIK xabarni `HrTelegramOutbox` qatoriga bog'laydi
  /// (2026-08-16). Nega kerak: ip qatorining o'zida yetkazish holati YO'Q —
  /// «navbatda / yuborildi / yetmadi» outbox'da yashaydi. Bu havolasiz UI
  /// `pending` ni «yuborildi» deb ko'rsatishga majbur bo'lardi.
  /// NULL — qo'lda yozilgan yoki kiruvchi xabar (ularda outbox yo'q).
  outboxId String? @map("outbox_id") @db.Uuid

  @@unique([chatRefId, tgMessageId])
  @@index([accountId, chatRefId, createdAt(sort: Desc)])
  /// Ip qatorlarini outbox holati bilan BITTA so'rovda birlashtirish uchun
  /// (N+1 bo'lmasin).
  @@index([accountId, outboxId])
  @@map("telegram_chat_messages")
}

/// Talab-bo'yicha to'liq-tarix backfill navbati (2026-07-20). Panel birinchi
/// ochilganda upsert qilinadi (queued); TelegramBackfillWorker bitta-bitta
/// drenaj qiladi (dialog tarixini sahifalab TelegramChatMessage'ga yozadi).
model TelegramBackfillJob {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  counterpartyId   String    @map("counterparty_id") @db.Uuid
  phone            String    @db.VarChar(32)
  status           String    @default("queued") @db.VarChar(10) // queued|running|done|error
  requestedAt      DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  startedAt        DateTime? @map("started_at") @db.Timestamptz()
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz()
  messagesImported Int       @default(0) @map("messages_imported")
  /// Keyingi (eskiroq) sahifa uchun offsetId — 0/NULL = eng yangidan.
  cursorOffsetId   BigInt?   @map("cursor_offset_id")
  failReason       String?   @map("fail_reason") @db.VarChar(500)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation("TgBackfillCp", fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([accountId, counterpartyId])
  @@index([status, requestedAt])
  @@map("telegram_backfill_job")
}

// ===== Sherset KEEP: MessageTemplate (sms/telegram shablon) — B3 =====
model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  channel   String   @default("sms") @db.VarChar(16) // 'sms' | 'telegram'
  key       String?  @db.VarChar(50)
  name      String   @db.VarChar(120)
  body      String   @db.Text
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, channel])
  @@map("sms_templates")
}

// =========================================================================
// «Yig'ish ro'yxati» (pick-list / yacheykali chek) — TASHQI (haqiqiy) MoySklad
// hisobidan «Заказ покупателя» + «Возврат покупателя» snapshot'i (climart port
// 2026-07-28). Kassir MoySklad'da ishlaydi; ombor BIZNING saytni ochib har
// tovarni uy-yacheykasi (__yacheyka) bilan yig'ish-varaqda chop etadi.
// Pozitsiyalar snapshot [{msAssortmentId,name,qty,code,barcode,...}]; uy-yacheyka
// SAQLANMAYDI — print (READ) paytida bizning mahsulotdan hal qilinadi (qayta-
// bog'lash keyingi chopda darhol ko'rinadi). Standalone (Account-relation yo'q).
// =========================================================================
model MsPickList {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  msOrderId   String    @map("ms_order_id") @db.Uuid
  docType     String    @default("customerorder") @map("doc_type") @db.VarChar(30)
  name        String    @db.VarChar(64)
  moment      DateTime  @db.Timestamptz()
  /// MoySklad `updated` — sync-kursor; max(msUpdatedAt) keyingi poll'ni boshqaradi.
  msUpdatedAt DateTime  @map("ms_updated_at") @db.Timestamptz()
  agentName   String?   @map("agent_name") @db.VarChar(255)
  agentPhone  String?   @map("agent_phone") @db.VarChar(64)
  storeName   String?   @map("store_name") @db.VarChar(255)
  ownerName   String?   @map("owner_name") @db.VarChar(255)
  description String?   @db.Text
  sumMinor    BigInt    @default(0) @map("sum_minor")
  /// MoySklad «Проведено» — faqat provedeno buyurtmalar pick-list sifatida ko'rinadi.
  applicable  Boolean   @default(true)
  /// MoySklad payedSum (tiyin) — ro'yxat Оплачен/Частично/Не оплачен ko'rsatadi.
  payedMinor  BigInt    @default(0) @map("payed_minor")
  positions   Json      @default("[]")
  printedAt   DateTime? @map("printed_at") @db.Timestamptz()

  /// Omborchi zanjiri: 'new' → 'picking' → 'picked'.
  ///
  /// NEGA KERAK: MoySklad'dan kelgan buyurtma o'z-o'zidan «yig'ilgan» holatga
  /// o'tmaydi — MoySklad omborchi ishini bilmaydi. Holatsiz ro'yxatda ikki
  /// omborchi bitta buyurtmani birga yig'a boshlaydi yoki bittasi ikki marta
  /// yig'iladi. Holat mahalliy: MoySklad'ga qaytarilmaydi (u yerda bu tushuncha
  /// yo'q), shuning uchun sync uni HECH QACHON ustidan yozmaydi.
  pickState   String    @default("new") @map("pick_state") @db.VarChar(20)
  /// Kim yig'a boshlagani — «bu meniki» belgisi (ikki omborchi urishmasin).
  pickedById  String?   @map("picked_by_id") @db.Uuid
  pickStartedAt DateTime? @map("pick_started_at") @db.Timestamptz()
  pickedAt    DateTime? @map("picked_at") @db.Timestamptz()
  /// Omborchi izohi: «3 dona yo'q edi» — kamomad sababi shu yerdan boshlanadi.
  pickNote    String?   @map("pick_note") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  pickedBy Employee? @relation("MsPickListPicker", fields: [pickedById], references: [id], onDelete: SetNull)

  @@unique([accountId, msOrderId])
  @@index([accountId, moment(sort: Desc)])
  /// Omborchi ekrani: «yig'ilmagan buyurtmalar» — asosiy so'rov.
  @@index([accountId, pickState, moment(sort: Desc)])
  @@map("ms_pick_lists")
}

// ─────────────────────────────────────────────────────────────────────────────
// MENEJER ISH NAVBATI — 4M TZ §5 (MK06)
//
// «BITTA NAVBAT» tamoyili (§5.1): qoida buzilishi · kun qabuli · e'tiroz ·
// eskalatsiya — HAMMASI shu jadvalda. Har manba o'z ro'yxatini yasasa, menejer
// «bugun nima muhim» degan savolga besh joydan javob izlardi va bittasi
// e'tibordan qolardi.
//
// 🔴 NAVBAT BLOKLAMAYDI (§5.1 — egasining falsafasi «erkinlik + keyingi
// nazorat»). Shuning uchun bu yerda hech qanday `blocked`/`blocksDocument`
// maydoni YO'Q va `ManagerRuleConfig.mode` da `block` qiymati YO'Q. Kimdir
// kelajakda navbatdan taqiq yasamoqchi bo'lsa — avval sxemani, tipni va
// qulf-testni buzishi kerak bo'ladi.
// ─────────────────────────────────────────────────────────────────────────────

/// Qoida sozlamasi — asl TZ §5.2 dagi `ApprovalRule { type, threshold, mode }`
/// kengaytmasi. Bir akkаunt × bir qoida turi = bitta qator.
model ManagerRuleConfig {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// `work-item-rules.ts` dagi registry kaliti (MK07 12 turgacha to'ldiradi).
  ruleType String @map("rule_type") @db.VarChar(40)

  /// O'chirilgan qoida YANGI element yaratmaydi. Mavjudlari O'CHIRILMAYDI —
  /// ular bo'lib o'tgan hodisa, sozlama o'zgargani tarixni yolg'on qilmaydi.
  enabled Boolean @default(true)

  /// Chegara qiymati. Birligi `thresholdUnit` da — ikkisi HAR DOIM birga
  /// o'qiladi: foizni tiyin deb talqin qilish shu repoda allaqachon yuz bergan
  /// bug-klass (`per-unit-snapshot` hodisasi). `null` = chegarasiz qoida.
  thresholdValue Decimal? @map("threshold_value") @db.Decimal(20, 4)
  /// percent | minor | days | qty
  thresholdUnit  String?  @map("threshold_unit") @db.VarChar(10)

  /// observe | notify. **`block` YO'Q** — yuqoridagi izohga qara.
  mode String @default("notify") @db.VarChar(10)

  /// info | warning | critical — navbatdagi tartibga ta'sir qiladi.
  severity String @default("warning") @db.VarChar(10)

  /// Qoidaga xos qo'shimcha sozlama (MK07 to'ldiradi).
  params Json?

  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  updatedBy Employee? @relation("ManagerRuleConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([accountId, ruleType])
  @@map("manager_rule_configs")
}

/// Navbat elementi. Har element §5.1 ning beshta savoliga javob beradi:
/// **kim** (`subjectEmployeeId`) · **qancha** (`amountMinor`) · **qachon**
/// (`occurredAt`) · **hujjatga havola** (`docType`/`docId`) · **kontekst**
/// (`context`).
model ManagerWorkItem {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  ruleType String @map("rule_type") @db.VarChar(40)

  /// Barqaror dedup kaliti. Dvigatel qayta-qayta ishga tushiriladi (cron,
  /// qo'lda yangilash) — shu kalit bo'yicha ikkinchi element YARATILMAYDI.
  /// Manba modullari uni allaqachon shu shaklda beradi
  /// (`price-change-control.ts` → `PriceChangeWorkItem.dedupKey`).
  dedupKey String @map("dedup_key") @db.VarChar(200)

  /// open | in_review | resolved | dismissed | escalated
  ///
  /// ESKIRISH bu ro'yxatda YO'Q — u `staleAt` BAYROG'I (pastga qara).
  /// Eskirgan element baribir OCHIQ: §5.1 uni «yuqoriga chiqadi» deydi, ya'ni
  /// navbatdan chiqmaydi, aksincha ko'proq diqqat talab qiladi. Alohida
  /// `stale` statusi uni ochiqlar ro'yxatidan olib chiqib ketardi — «e'tibordan
  /// qolgan element» aynan shu yo'l bilan ikkinchi marta e'tibordan qolardi.
  status   String @default("open") @db.VarChar(20)
  /// info | warning | critical
  severity String @default("warning") @db.VarChar(10)

  /// «Kim» — qoida kimning harakatidan kelib chiqdi. `null` = xodimga
  /// bog'lanmagan signal (masalan ombor qoldig'i).
  subjectEmployeeId String? @map("subject_employee_id") @db.Uuid

  /// «Qancha» — tiyin. **`null` = O'LCHANMADI, `0` EMAS.** Tan narxsiz tovar
  /// yoki bazasiz narx o'zgarishi jamiga qo'shilmasligi kerak (NULL ≠ 0).
  amountMinor BigInt? @map("amount_minor")
  currency    String? @db.VarChar(3)

  /// «Hujjatga havola». `docId` UUID EMAS — manba tashqi kalit bo'lishi mumkin.
  docType String? @map("doc_type") @db.VarChar(30)
  docId   String? @map("doc_id") @db.VarChar(64)

  /// «Qachon» — HODISA vaqti (qator yaratilgan vaqt emas). Eskirish va navbat
  /// tartibi shundan sanaladi; aks holda eski hodisa bugun kashf etilgani uchun
  /// «yangi» ko'rinardi.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz()

  /// §5.1 «shu oydagi naqsh» — bitta hodisa emas, tendensiya.
  context Json?

  /// ESKIRISH BELGISI (§5.1). Element bu yerda **belgilanadi, o'chirilmaydi** —
  /// o'chirilgan element hech qachon ko'rilmagani bilinmay qolardi.
  staleAt DateTime? @map("stale_at") @db.Timestamptz()

  /// Yopilganda sabab kodi MAJBURIY (§5.3) — sababsiz yopilgan navbat
  /// statistikasiz navbat. Kodlar katalogi MK07 da to'ladi.
  resolutionCode    String? @map("resolution_code") @db.VarChar(40)
  resolutionComment String? @map("resolution_comment") @db.Text
  resolvedById      String? @map("resolved_by_id") @db.Uuid

  statusChangedAt DateTime  @default(now()) @map("status_changed_at") @db.Timestamptz()
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  account    Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subject    Employee?              @relation("ManagerWorkItemSubject", fields: [subjectEmployeeId], references: [id], onDelete: SetNull)
  resolvedBy Employee?              @relation("ManagerWorkItemResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  events     ManagerWorkItemEvent[]

  /// Dedup KAFOLATI — dvigatel `createMany({skipDuplicates})` ga tayanadi.
  @@unique([accountId, dedupKey])
  /// Asosiy ekran: «ochiq elementlar, eng yangisi tepada».
  @@index([accountId, status, occurredAt(sort: Desc)])
  /// Xodim kartasi: «bu odamda nima turibdi».
  @@index([accountId, subjectEmployeeId, status])
  /// Qoida bo'yicha statistika va MK07 filtri.
  @@index([accountId, ruleType, status])
  @@map("manager_work_items")
}

/// Append-only jurnal — navbat elementi ustidagi HAR harakat. O'chirish yo'q:
/// «kim tasdiqladi va nega» nizoda yagona yozma iz.
model ManagerWorkItemEvent {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  fromStatus String @map("from_status") @db.VarChar(20)
  toStatus   String @map("to_status") @db.VarChar(20)

  /// `work-item-fsm.ts` dagi WORK_ITEM_ACTION qiymati.
  action String @db.VarChar(30)

  /// system | manager | owner (FSM'dagi WORK_ITEM_ACTOR).
  actorType String  @map("actor_type") @db.VarChar(20)
  actorId   String? @map("actor_id") @db.Uuid

  /// Yopiq ro'yxatdan. `other` bo'lsa izoh MAJBURIY.
  reasonCode String? @map("reason_code") @db.VarChar(40)
  comment    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  item    ManagerWorkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Element kartochkasidagi tarix.
  @@index([accountId, itemId, createdAt])
  /// «Qaysi sabab bilan ko'p yopilyapti» statistikasi (§5.3 ning maqsadi).
  @@index([accountId, action, createdAt(sort: Desc)])
  @@map("manager_work_item_events")
}

/// SHABLON IZOH — 4M TZ §8.1/6 (MK20). Menejer o'zi sozlaydigan tez javob
/// matnlari: rad etish · tuzatma · ogohlantirish.
///
/// 🔴 JURNAL BU JADVALGA HAVOLA SAQLAMAYDI. Shablon tanlanganda uning MATNI
/// `ManagerWorkItemEvent.comment` / `EmployeeDailyKpiEvent.comment` ustuniga
/// NUSXA bo'lib tushadi (`comment-templates.ts` → `materializeComment`).
/// Havola saqlansa: shablon ertaga tahrirlanadi → kechagi qaror bugun boshqacha
/// o'qiladi, hech kim bexabar qoladi. Shuning uchun bu yerda jurnalga
/// `templateId` tashqi kaliti YO'Q va bo'lmaydi ham — `usageCount` faqat
/// «qaysi shablon amalda ishlatilyapti» degan statistikani beradi.
///
/// Nega mavjud `MessageTemplate`/`HrNotificationTemplate` ishlatilmadi: ular
/// **jo'natgichga** bog'langan (kanal, hodisa turi, qabul qiluvchi, o'rinbosar
/// belgilar bilan) va tashqariga xabar yuboradi. Bu esa ichki jurnal matni —
/// hech qayerga jo'natilmaydi, kanali yo'q, amal/qoida bo'yicha taklif qilinadi.
model ManagerCommentTemplate {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  /// rejection | correction | warning (`COMMENT_TEMPLATE_KIND`). DB CHECK bilan
  /// qulflangan — yopiq ro'yxat ikki joyda bir xil turadi.
  kind String @db.VarChar(20)

  /// `ru` | `uz`. FILTR EMAS, taklif tartibiga ta'sir qiladi: menejer ru
  /// shablonini uz interfeysda ham ishlata olishi kerak (matn uniki).
  locale String @default("uz") @db.VarChar(5)

  /// Tanlagichda ko'rinadigan qisqa nom.
  title String @db.VarChar(120)

  /// Jurnalga ko'chiriladigan MATN. Uzunlik chegarasi izoh chegarasiga teng
  /// (`MAX_COMMENT_LENGTH` = 2000) — aks holda yuborib bo'lmaydigan izoh
  /// yaratilardi.
  body String @db.Text

  /// Bo'sh = hamma qoidaga taklif qilinadi. To'ldirilgan = faqat shu
  /// `MANAGER_RULES` turlariga (masalan `BIG_DEBT`).
  ruleTypes String[] @default([]) @map("rule_types")

  /// Bo'sh = `kind` xaritasi bo'yicha (`ACTION_KIND`). To'ldirilgan = OSHKORA
  /// biriktirish, xarita bo'yicha taklifdan ustun turadi.
  actions String[] @default([])

  sortOrder Int @default(0) @map("sort_order")

  /// «Qaysi shablon amalda ishlatilyapti» — o'lchov. Jurnal bilan bog'liq EMAS.
  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()

  /// Yumshoq o'chirish. Qattiq o'chirish ham tarixni buzmasdi (matn nusxa
  /// ko'chirilgan), lekin arxiv `usageCount` statistikasini saqlab qoladi.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz()

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy Employee? @relation("ManagerCommentTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Asosiy so'rov: «shu hisobning tirik shablonlari, turi bo'yicha».
  @@index([accountId, archivedAt, kind])
  @@map("manager_comment_templates")
}
