<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Ilovani QURILMANING O'ZIDAN yangilash (`Updater.kt`). Planshet Play
      Store'da emas — APK `/downloads/menejer/` kanalidan keladi, ya'ni
      yangilanish uchun ilova o'rnatuvchini ocha olishi kerak.
      ⚠️ Bu ruxsatning O'ZI yetmaydi: Android 8+ da foydalanuvchi «noma'lum
      manbalardan o'rnatish»ni SHU ilovaga alohida yoqadi. `Updater.install`
      buni tekshiradi va kerak bo'lsa aynan o'sha sozlama ekranini ochadi.

      Kamera/skaner ruxsatlari ATAYLAB YO'Q — ilova asosan o'qiydi.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      X2 — «Keldim»/«Ketyapman». Server check-in'ni GEOFENCE bilan tekshiradi
      (`ping-ingest.service.ts` — `isInsideGeofence`, aniqlik chegarasi 100 m),
      ya'ni koordinatasiz davomat belgilab bo'lmaydi.

      ⚠️ Chegaralar ATAYLAB:
        - FON ruxsati (`ACCESS_BACKGROUND_LOCATION`) YO'Q — ilova xodimni
          kuzatmaydi; joy FAQAT tugma bosilganda bir marta o'lchanadi
          (`Locator.kt`) va ruxsat ham AYNAN o'sha payt so'raladi;
        - fon xizmati (`FOREGROUND_SERVICE_LOCATION`) ham YO'Q — u driver-app
          ning ishi, bu yerda kerak emas.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Material3.DayNight">

        <!--
          `screenOrientation` ATAYLAB YO'Q (TSD'dan farq): planshet — menejer
          uni yotiq ham, tik ham ushlaydi, erkin aylanish qoladi.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Yuklab olingan APK'ni o'rnatuvchiga UZATISH uchun. `file://` URI
          Android 7 dan boshlab `FileUriExposedException` beradi, shuning uchun
          fayl `content://` orqali beriladi (`Updater.install`).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
