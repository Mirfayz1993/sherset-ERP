<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Backend bazaviy URL. `usesCleartextTraffic=false` ⇒ FAQAT https. -->
    <string name="api_base_url">https://erp.sherset.uz/api/v1</string>

    <!--
      Yangilanish manifesti (`Updater.kt`). API EMAS — nginx statikasi
      (`/var/www/kassa-downloads/tsd/latest.json`), tokensiz o'qiladi.
      Shakli: {versionCode, versionName, url, sha256, notes}.
    -->
    <string name="update_manifest_url">https://erp.sherset.uz/downloads/tsd/latest.json</string>

    <!--
      Skaner BROADCAST aksiyalari — vergul bilan, ILOVA HAMMASINI BIRDAN
      tinglaydi (`ScannerBridge.kt` izohi). Aniq nomini bilish SHART EMAS:
      terminal sozlamasida broadcast yoqilgan bo'lsa, qaysi biri kelsa o'sha
      ishlaydi, qolganlari jim turadi.

      Ro'yxat: iData / Urovo / Chainway / Newland / Zebra DataWedge / Honeywell.
      Yangi terminal kelsa — faqat shu qatorga qo'shiladi, kod tegilmaydi.
    -->
    <string name="scanner_broadcast_actions">android.intent.action.SCANRESULT,android.intent.ACTION_DECODE_DATA,com.android.server.scannerservice.broadcast,com.android.server.scannerservice.broadcast_data,nlscan.action.SCANNER_RESULT,com.symbol.datawedge.api.RESULT_ACTION,scanner.rcv.message,com.honeywell.decode.intent.action.EDIT_DATA,device.scanner.RESULT,com.idata.scan.RESULT</string>

    <!--
      T2 — SKANERNI ODAMDAN AJRATISH CHEGARASI (ms).

      `ScanBar` skan maydoniga tushayotgan belgilar orasidagi O'RTACHA
      intervalni o'lchaydi:
        · o'rtacha < shu raqam  → SKANER: 350 ms jimlikdan keyin kod O'ZI
          yuboriladi (U5 dagi suffikssiz skaner zaxirasi — o'chirilmagan);
        · o'rtacha ≥ shu raqam  → ODAM: avto-yuborish o'chadi, kodni faqat
          ⏎ tugmasi yoki Enter yuboradi (aks holda qo'lda yozilgan
          `02-01-01-04` ning birinchi 3 belgisi yuborilardi).

      50 ms — wedge skaner belgilarni odatda 5–30 ms oralig'ida «yozadi»,
      odam esa ekran klaviaturasida 120 ms dan tez tera olmaydi. Sekin
      skaner «ODAM» deb tanilsa: diagnostika ekranidagi «Oxirgi kiritish»
      qatorida uning HAQIQIY o'rtacha intervali ko'rinadi — chegara shu
      raqamdan yuqori qilinadi. Qurilma almashsa KOD o'zgarmaydi.
    -->
    <integer name="scan_human_gap_ms">50</integer>

    <!--
      T4 — OVOZLI JAVOB YOQILGANMI (`Feedback.kt`).

      `true` — muvaffaqiyatda qisqa yuqori ton, xatoda past ton.
      `false` — ovoz umuman chalinmaydi, TEBRANISH esa ISHLAYVERADI
      (u ovozsiz kanal va uni o'chirishning sababi yo'q).

      Bayroq shu yerda, kodda emas: agar biror joyda (masalan savdo zali
      yonidagi omborda) ovoz xalaqit bersa — kod qayta yig'ilmasdan,
      faqat shu qator o'zgaradi.
    -->
    <bool name="feedback_sound">true</bool>
</resources>
